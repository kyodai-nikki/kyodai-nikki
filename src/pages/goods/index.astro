---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageCardFrame from "../../components/common/ImageCardFrame.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import GoodsMediaModal from "../../components/goods/GoodsMediaModal.astro";
import { goodsImage, orderedGoods } from "../../lib/goods";
import { goodsActions, goodsDetailImages } from "../../lib/view/goods";
import { commonMsg } from "../../msg/common";
import { goodsPageMsg } from "../../msg/goods";
import { navigation } from "../../data/navigation";

const goods = await orderedGoods();
---
<BaseLayout
  title={navigation.goods.title}
  description={goodsPageMsg.meta.description}
  pageSectionClass="goods"
>
  <PageHeading slot="page-heading" title={navigation.goods.title} />

  {goods.length === 0 ? (
    <p class="goods__empty">
      {goodsPageMsg.empty.list}
    </p>
  ) : (
    <>
      <div class="goods-grid" aria-label={goodsPageMsg.aria.list}>
        {goods.map((entry, index) => {
          const item = entry.data;
          const modalId = `goods-modal-${index}`;
          return (
            <button
              class="goods-card"
              type="button"
              aria-label={commonMsg.actions.open(item.title)}
              data-modal-open={modalId}
            >
              <ImageCardFrame
                class="goods-card__frame"
                aspectRatio="4 / 2.65"
                fit="contain"
                background="var(--goods-image-bg)"
              >
                <img
                  src={goodsImage(entry)}
                  alt={item.title}
                  loading="lazy"
                  width="640"
                  height="480"
                />
              </ImageCardFrame>
              <p class="goods-card__title">{item.title}</p>
            </button>
          );
        })}
      </div>

      {goods.map((entry, index) => {
        const item = entry.data;
        const detailImgs = goodsDetailImages(entry);
        const actions = goodsActions(entry);
        return (
          <GoodsMediaModal
            id={`goods-modal-${index}`}
            title={item.title}
            description={item.description}
            images={detailImgs}
            actions={actions}
          />
        );
      })}
    </>
  )}
</BaseLayout>

<style>
  .goods {
    --goods-card-title-fg: var(--c-fg);
    --goods-card-title-hover-fg: var(--c-fg-muted);
    --goods-empty-fg: var(--c-fg-muted);
    --goods-empty-bg: var(--c-white-card-translucent-bg);
    --goods-empty-border: var(--c-border);
    --goods-image-bg: var(--c-bg);

    padding-top: 20px;
  }

  .goods-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 20px;
    max-width: 860px;
    margin: 0 auto;
  }

  .goods-card {
    appearance: none;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--goods-card-title-fg);
  }

  .goods-card:hover,
  .goods-card:focus-visible {
    --goods-card-title-fg: var(--goods-card-title-hover-fg);
  }

  .goods-card__title {
    margin: 0;
    text-align: center;
    font-family: var(--font-family-base);
    font-size: 17px;
    line-height: 1.4;
    color: var(--goods-card-title-fg);
    transition: color var(--dur-slow) var(--ease-out);
  }

  .goods__empty {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-6);
    text-align: center;
    color: var(--goods-empty-fg);
    background: var(--goods-empty-bg);
    border: 1px solid var(--goods-empty-border);
  }

  @media (--bp-tablet) {
    .goods-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 680px;
    }
  }
</style>
