---
import {
  episodeHref,
  episodeListImage,
  type EpisodeEntry,
  type SeasonInfo,
} from "../../../lib/episodes";
import { episodeListNumberLabel } from "../../../lib/episodes/view";
import { episodesPageMsg } from "../../../msg/episodes";

interface Props {
  list: EpisodeEntry[];
  seasonSlug: SeasonInfo["slug"];
  seasonLabel: SeasonInfo["label"];
  currentOverallNumber?: EpisodeEntry["overallNumber"];
  dummyEpisodeList: string;
}

const {
  list,
  seasonSlug,
  seasonLabel,
  currentOverallNumber,
  dummyEpisodeList,
} = Astro.props as Props;

const itemClass = (episode: EpisodeEntry) => {
  const cls = ["ep-item", `ep-item--${episode.type}`];
  if (episode.type !== "normal") cls.push("ep-item--alt");
  if (episode.smallText) cls.push("ep-item--sm");
  if (currentOverallNumber === episode.overallNumber) {
    cls.push("ep-item--selected");
  }
  return cls.join(" ");
};
---

<ol class="ep-list" aria-label={`${seasonLabel} episodes`}>
  {list.length === 0 ? (
    <li class="ep-empty">{episodesPageMsg.empty.noEpisodesYet}</li>
  ) : (
    list.map((episode) => {
      const isCurrent = currentOverallNumber === episode.overallNumber;
      const content = (
        <>
          <span class="ep-item__no">{episodeListNumberLabel(episode)}</span>
          <span class="ep-item__title">{episode.title}</span>
        </>
      );
      const style = {
        "--ep-bg": `url("${episodeListImage(seasonSlug, episode)}"), url("${dummyEpisodeList}")`,
      };

      return (
        <li>
          {isCurrent ? (
            <div class={itemClass(episode)} style={style} aria-current="page">
              {content}
            </div>
          ) : (
            <a class={itemClass(episode)} href={episodeHref(seasonSlug, episode)} style={style}>
              {content}
            </a>
          )}
        </li>
      );
    })
  )}
</ol>

<style>
  .ep-list {
    --episode-list-empty-fg: var(--c-episode-list-empty-fg);
    --episode-list-bg: var(--c-episode-list-bg);
    --episode-list-fg: var(--c-episode-list-fg);
    --episode-list-border: var(--c-episode-list-border);
    --episode-list-alt-bg: var(--c-episode-list-alt-bg);
    --episode-list-alt-fg: var(--c-episode-list-alt-fg);
    --episode-list-selected-normal-bg: var(--episode-list-alt-bg);
    --episode-list-selected-normal-fg: var(--episode-list-alt-fg);
    --episode-list-selected-alt-bg: var(--episode-list-bg);
    --episode-list-selected-alt-fg: var(--episode-list-fg);

    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 640px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .ep-list::-webkit-scrollbar {
    display: none;
  }

  .ep-empty {
    padding: var(--s-5);
    color: var(--episode-list-empty-fg);
    text-align: center;
  }

  .ep-item {
    --episode-list-item-overlay-bg: var(--episode-list-selected-normal-bg);

    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: var(--s-3);
    min-height: 88px;
    padding: var(--s-3) var(--s-4);
    background-color: var(--episode-list-bg);
    background-image:
      linear-gradient(
        90deg,
        var(--episode-list-bg) 37%,
        var(--c-ep-item-grad-mid-light) 100%,
        var(--c-ep-item-grad-end-light) 100%
      ),
      var(--ep-bg, none);
    background-size: cover, cover;
    background-position: left center, right center;
    background-repeat: no-repeat, no-repeat;
    border: 1px solid var(--episode-list-border);
    color: var(--episode-list-fg);
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--r-md);
    transition:
      background-color var(--dur-base) var(--ease-button),
      border-color var(--dur-base) var(--ease-button),
      color var(--dur-base) var(--ease-button);
  }

  .ep-item::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      var(--episode-list-item-overlay-bg) 37%,
      var(--episode-list-item-overlay-bg) 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-button);
  }

  .ep-item__no {
    font-family: var(--font-family-base);
    font-size: var(--fs-lg);
    position: relative;
    z-index: 1;
  }

  .ep-item__title {
    font-family: var(--font-family-base);
    font-size: var(--fs-lg);
    position: relative;
    z-index: 1;
    overflow: hidden;
    scrollbar-width: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ep-item--sm .ep-item__title {
    font-size: var(--fs-m);
  }

  .ep-item--normal.ep-item--selected {
    color: var(--episode-list-selected-normal-fg);
    border-color: var(--episode-list-border);
  }

  .ep-item--normal.ep-item--selected::before {
    opacity: 1;
  }

  a.ep-item--normal:hover,
  a.ep-item--normal:focus-visible {
    color: var(--episode-list-selected-normal-fg);
    border-color: var(--episode-list-border);
  }

  a.ep-item--normal:hover::before,
  a.ep-item--normal:focus-visible::before {
    opacity: 1;
  }

  .ep-item--alt {
    --episode-list-item-overlay-bg: var(--episode-list-selected-alt-bg);

    background-color: var(--episode-list-alt-bg);
    background-image:
      linear-gradient(
        90deg,
        var(--episode-list-alt-bg) 37%,
        var(--c-ep-item-grad-mid-darker) 100%,
        var(--c-ep-item-grad-end-darker) 100%
    ),
    var(--ep-bg, none);
    color: var(--episode-list-alt-fg);
    border-color: var(--episode-list-border);
  }

  :is(.ep-item--another, .ep-item--deleted).ep-item--selected {
    color: var(--episode-list-selected-alt-fg);
    border-color: var(--episode-list-border);
  }

  :is(.ep-item--another, .ep-item--deleted).ep-item--selected::before {
    opacity: 1;
  }

  a:is(.ep-item--another, .ep-item--deleted):hover,
  a:is(.ep-item--another, .ep-item--deleted):focus-visible {
    color: var(--episode-list-selected-alt-fg);
    border-color: var(--episode-list-border);
  }

  a:is(.ep-item--another, .ep-item--deleted):hover::before,
  a:is(.ep-item--another, .ep-item--deleted):focus-visible::before {
    opacity: 1;
  }

  @media (--bp-tablet) {
    .ep-list {
      display: none;
    }
  }
</style>
