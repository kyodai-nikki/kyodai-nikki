---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/common/PageHeading.astro";
import { withBase } from "../lib/urls";
import { notFoundPageMsg } from "../msg/notFound";
---
<BaseLayout title={notFoundPageMsg.meta.title} pageContainerClass="container--narrow">
  <PageHeading slot="page-heading" title={notFoundPageMsg.headings.main} eyebrow="404" />
  <div class="notfound">
    <p class="notfound__description">
      {notFoundPageMsg.body.description}
    </p>
    <p><a href={withBase("/")}>{notFoundPageMsg.links.top}</a></p>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
  }

  .notfound__description {
    color: var(--c-fg-muted);
  }
</style>
