---
// /episodes/  → デフォルトで 1st season / 最初のエピソードへリダイレクト
import { firstEpisodeOfSeason, episodeHref } from "../../data/episodes";

const initial = firstEpisodeOfSeason(1);
const redirectTo = initial ? episodeHref("season1", initial.slug) : "/episodes/timeline/";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <link rel="canonical" href={redirectTo} />
    <title>Episodes</title>
  </head>
  <body>
    <script is:inline>{`location.replace(${JSON.stringify(redirectTo)});`}</script>
  </body>
</html>
