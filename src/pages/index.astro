---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breakpoints } from "../lib/breakpoints.mjs";
import { homeImageHeightPx, homeSlideImages } from "../lib/home";
import { withBase } from "../lib/urls";
import { homePageMsg } from "../msg/home";
import { siteConfig } from "../config";
import Tagline from "../content/home.md";

const slideImages = await homeSlideImages(siteConfig.enableSlideshow);
const slideHeightPx = homeImageHeightPx;
const mobileMedia = `(max-width: ${breakpoints.mobile}px)`;

const slideObjectPosition = ({ width, height }: { width: number; height: number }) =>
  width / height >= 1.4 ? "center center" : "center top";
---
<BaseLayout
  title={homePageMsg.meta.title}
  description={homePageMsg.meta.description}
  bodyClass="is-home"
>
  <section
    class="home"
    style={`--home-image-height: ${slideHeightPx}px;`}
    aria-label={homePageMsg.aria.homeVisual}
  >
    <div
      class="home__image"
      role="img"
      aria-label={homePageMsg.alt.homeFallbackImage}
    >
      {slideImages.map((image, i) => (
        <div
          class:list={["home__slide", i === 0 && "is-visible"]}
          data-index={i}
          style={`--home-slide-object-position: ${slideObjectPosition(image)};`}
        >
          <picture>
            {image.mobileSrc && <source media={mobileMedia} srcset={image.mobileSrc} />}
            <img src={image.src} alt="" />
          </picture>
        </div>
      ))}
    </div>
    <div class="home__overlay">
      <img src={withBase(siteConfig.logoPath)} alt={siteConfig.name} class="site-brand__logo" />
      <div class="home__tagline"><Tagline /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    --home-bg: var(--bc-gray-lightest);
    --home-tagline-fg: var(--c-fg);
    --home-tagline-shadow: 0 1px 0 rgb(from var(--bc-white) r g b / 0.6);
    --home-tagline-shadow-strong: 0 0 10px var(--c-bg);

    position: relative;
    width: 100%;
    background: var(--home-bg);
  }

  .home__image {
    display: grid;
    width: 100%;
    height: var(--home-image-height, 800px);
    overflow: hidden;
  }

  .home__slide {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .home__slide.is-visible {
    opacity: 1;
  }

  .home__slide picture,
  .home__slide img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home__slide img {
    object-fit: cover;
    object-position: var(--home-slide-object-position, center top);
  }

  .home__overlay {
    position: absolute;
    inset: 0;
    width: 100vw;
    max-width: none;
    margin-inline: auto;
    padding: var(--s-6) 100px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--s-5);
    row-gap: var(--m-l30);
  }

  .home__overlay img {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: 450px;
    height: auto;
  }

  .home__tagline {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    text-align: left;
    font-family: var(--font-family-base);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--home-tagline-fg);
    line-height: 1.8;
    text-shadow: var(--home-tagline-shadow);
  }

  .home__tagline :global(p) {
    font-size: 32px;
    margin: 0;
    white-space: pre-wrap;
  }

  @media (--bp-laptop) {
    .home__image {
      height: calc(100svh - var(--site-header-offset) - var(--site-footer-offset));
    }
  }

  @media (--bp-tablet) {
    .home__overlay {
      padding: var(--s-5) var(--s-4) var(--s-8);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: var(--m-l30);
    }

    .home__overlay img {
      width: min(var(--w-home-logo-tablet), 100%);
      height: var(--h-home-logo-tablet);
      object-fit: contain;
    }

    .home__tagline {
      text-align: center;
      text-shadow: var(--home-tagline-shadow-strong);
    }

    .home__tagline :global(p) {
      font-size: var(--fs-home-tagline-tablet);
    }
  }

  @media (--bp-mobile) {
    .home__overlay img {
      width: min(var(--w-home-logo-mobile), 100%);
      height: var(--h-home-logo-mobile);
      object-fit: contain;
    }

    .home__tagline :global(p) {
      font-size: var(--fs-home-tagline-mobile);
    }
  }
</style>

<script>
  import { siteConfig } from "../config";
  import { onPageLoad } from "../scripts/onPageLoad";

  onPageLoad("home-slideshow", ({ signal }) => {
    const slides = document.querySelectorAll<HTMLElement>(".home__slide");
    if (slides.length <= 1) return;

    slides.forEach((slide, index) => {
      slide.classList.toggle("is-visible", index === 0);
    });

    let current = 0;
    const slideshowTimer = window.setInterval(() => {
      slides[current].classList.remove("is-visible");
      current = (current + 1) % slides.length;
      slides[current].classList.add("is-visible");
    }, siteConfig.slideshowTimeout);

    signal.addEventListener("abort", () => window.clearInterval(slideshowTimer), { once: true });
  });
</script>
