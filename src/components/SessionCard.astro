---
// セッションログ一覧で使うカード。
interface Props {
  href: string;
  title: string;
  sessionNumber?: number;
  date?: string | Date;
  duration?: string;
  summary?: string;
}

const { href, title, sessionNumber, date, duration, summary } = Astro.props;

const dateText = date
  ? new Date(date).toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" })
  : undefined;
---
<a class="card" href={href}>
  {sessionNumber !== undefined && (
    <span class="card__eyebrow">Session #{String(sessionNumber).padStart(2, "0")}</span>
  )}
  <h3 class="card__title">{title}</h3>
  <div class="card__meta">
    {dateText && <span>{dateText}</span>}
    {duration && <span>{duration}</span>}
  </div>
  {summary && <p class="card__excerpt">{summary}</p>}
</a>
