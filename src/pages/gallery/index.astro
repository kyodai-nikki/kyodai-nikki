---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import MediaModal from "../../components/common/MediaModal.astro";
import { displayedGalleryImages, galleryPicture, gallerySrc } from "../../lib/gallery";
import {
  galleryDetailImages,
  galleryModalDescription,
  galleryModalTitle,
} from "../../lib/view/gallery";
import { common } from "../../msg/common";
import { galleryPageMsg } from "../../msg/gallery";
import { navigation } from "../../data/navigation";

const displayedImages = await displayedGalleryImages();
---
<BaseLayout
  title={navigation.gallery.title}
  description={galleryPageMsg.description}
  bodyClass="gallery-page"
  pageSectionClass="gallery"
>
  <PageHeading slot="page-heading" title={navigation.gallery.title} />

  {displayedImages.length === 0 ? (
    <p class="gallery__empty">
      {galleryPageMsg.empty}
    </p>
  ) : (
    <>
      <div class="gallery-grid" aria-label={galleryPageMsg.listAriaLabel}>
        {displayedImages.map((entry, index) => {
          const img = entry.data;
          const modalId = `gallery-modal-${index}`;
          const modalTitle = galleryModalTitle(entry);
          const picture = galleryPicture(entry);
          const fallbackSrc = picture?.fallback ?? gallerySrc(entry);

          return (
            <button
              class="gallery-card"
              type="button"
              aria-label={common.actions.open(modalTitle)}
              data-modal-open={modalId}
              style={{ "--delay": `${index * 30}ms` }}
            >
              <picture>
                {picture?.webp && (
                  <source type="image/webp" srcset={picture.webp} />
                )}
                <img
                  src={fallbackSrc}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="376"
                />
              </picture>
            </button>
          );
        })}
      </div>

      {displayedImages.map((entry, index) => {
        const img = entry.data;
        const modalId = `gallery-modal-${index}`;
        const modalTitle = galleryModalTitle(entry);
        const modalDescription = galleryModalDescription(entry);
        // 詳細画像は WebP（medium / large）があれば srcset で 1x/2x を割り当てる。
        // モーダルが開いた瞬間の転送量を抑え、原寸 PNG/JPG への直接フェッチを避ける。
        const detailSrcs = galleryDetailImages(entry).map((image) => {
          const srcsetParts: string[] = [];
          if (image.mediumWebp) srcsetParts.push(`${image.mediumWebp} 1x`);
          if (image.largeWebp) srcsetParts.push(`${image.largeWebp} 2x`);
          return {
            src: image.src,
            alt: image.alt,
            webpSrcset: srcsetParts.length > 0 ? srcsetParts.join(", ") : undefined,
          };
        });

        return (
          <MediaModal
            id={modalId}
            title={modalTitle}
            description={modalDescription}
            images={detailSrcs}
            imageMaxWidth="420px"
            creditName={img.creditName}
            creditUrl={img.creditUrl}
            twitterId={img.twitterId}
            closeLabel={img.buttonLabel}
            panelClass="gallery-modal-panel"
          />
        );
      })}
    </>
  )}
</BaseLayout>

<style>
  .gallery {
    padding-top: 20px;
    padding-bottom: 72px;
  }

  .gallery__empty {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-6);
    text-align: center;
    color: var(--c-fg-muted);
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--c-border);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 24px;
  }

  .gallery-card {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(17, 17, 17, 0.72);
    background: #fff;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transform: translateY(12px);
    opacity: 0;
    animation: gallery-in 500ms var(--ease-out) forwards;
    animation-delay: var(--delay);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      filter var(--dur-base) var(--ease-out);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 28px rgba(0, 0, 0, 0.14);
    filter: saturate(1.03);
  }

  .gallery-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 2.35;
    object-fit: cover;
  }

  @keyframes gallery-in {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 960px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .gallery {
      padding-bottom: 56px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-card img {
      aspect-ratio: 4 / 2.7;
    }
  }
</style>
