---
import { getCollection } from "astro:content";
import ShareButtons from "./btn/ShareButtons.astro";
import { commonMsg } from "../../msg/common";

interface Props {
  shareUrl: string;
  shareTitle: string;
}

const { shareUrl, shareTitle } = Astro.props;
const [commonEntry] = await getCollection("common");
if (!commonEntry) {
  throw new Error("Missing common content");
}
const site = commonEntry.data;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__brand">{site.name}</div>

    <div class="site-footer__copyright">
      ©{site.copyStartYear}-{year} {site.name}{commonMsg.footer.madeByTeam}
    </div>

    <div class="site-footer__share">
      <span>{commonMsg.footer.shareLabel}</span>
      <ShareButtons url={shareUrl} title={shareTitle} className="site-footer__share-buttons" />
    </div>
  </div>
</footer>

<style>
  .site-footer__share-buttons {
    --share-btn-size: 22px;
    --share-icon-size: 11px;
    --share-line-icon-size: 15px;
  }
</style>
