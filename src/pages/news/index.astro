---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import WhiteCard from "../../components/common/WhiteCard.astro";
import { formatNewsDate, newsDate, newsListItems } from "../../lib/view/news";
import { newsPageMsg } from "../../msg/news";
import { navigation } from "../../data/navigation";

const items = await newsListItems();
---
<BaseLayout title={navigation.news.title} description={newsPageMsg.meta.description}>
  <PageHeading slot="page-heading" title={navigation.news.title} />

  {items.length === 0 ? (
    <p class="news-empty">{newsPageMsg.empty.list}</p>
  ) : (
    <ul class="news-list">
      {items.map(({ entry: item, external, href, text }) => {
        const inner = (
          <>
            <time class="news-date" datetime={newsDate(item)}>
              {formatNewsDate(item)}
            </time>
            <span class="news-sep" aria-hidden="true">|</span>
            <span class="news-text">
              {text}{external ? newsPageMsg.labels.externalSuffix : ""}
            </span>
          </>
        );
        return (
          <WhiteCard
            as="li"
            padding="none"
            interactive={Boolean(href)}
            class:list={["news-item", { "news-item--no-link": !href }]}
          >
            {href ? (
              <a
                class="news-link"
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener" : undefined}
              >
                {inner}
              </a>
            ) : (
              <div class="news-link">{inner}</div>
            )}
          </WhiteCard>
        );
      })}
    </ul>
  )}
</BaseLayout>

<style>
  .news-empty {
    color: var(--c-fg-muted);
    text-align: center;
  }

  .news-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 1000px;
    display: grid;
    gap: 45px;
  }

  .news-item {
    --white-card-border-color: var(--c-news-border);
    --white-card-hover-border-color: var(--c-news-border);
  }

  .news-link {
    display: grid;
    grid-template-columns: 120px auto 1fr;
    align-items: baseline;
    gap: var(--s-4);
    padding: 35px;
    color: var(--c-fg);
    text-decoration: none;
  }

  .news-date {
    font-family: var(--font-family-base);
    font-size: var(--fs-m);
    color: var(--c-news-date-fg);
    letter-spacing: var(--ls-wide);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .news-sep {
    color: var(--c-fg-subtle);
    font-family: var(--font-family-base);
    font-size: var(--fs-base);
    user-select: none;
  }

  .news-text {
    font-family: var(--font-family-base);
    font-size: var(--fs-m);
    color: var(--c-news-text-fg);
  }
  a.news-link .news-text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-skip-ink: auto;
    text-decoration-color: currentColor;
  }
  a.news-link:hover .news-text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-skip-ink: auto;
    text-decoration-color: currentColor;
  }

  @media (--bp-tablet) {
    .news-list {
      gap: 30px;
    }

    .news-link {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 20px;
    }
    .news-sep { display: none; }
    .news-date { text-align: left; }
    .news-text { margin-left: 20px; }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .news-list {
      width: calc(100vw - 200px);
    }
  }

  @media (--bp-mobile) {
    .news-date,
    .news-text {
      font-size: var(--fs-base);
    }
  }
</style>
