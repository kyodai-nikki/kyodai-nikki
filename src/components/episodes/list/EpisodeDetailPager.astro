---
import EpisodeArrowPager from "../EpisodeArrowPager.astro";
import { episodesPageMsg } from "../../../msg/episodes";

interface Props {
  previousHref?: string;
  nextHref?: string;
}

const { previousHref, nextHref } = Astro.props as Props;
---

<div class="ep-detail__pager">
  <EpisodeArrowPager
    previousHref={previousHref}
    nextHref={nextHref}
    ariaLabel={episodesPageMsg.aria.logNavigation}
  />
</div>

<style>
  .ep-detail__pager {
    --episode-arrow-pager-arrow-fg: var(--c-episode-detail-pager-arrow-fg);

    display: none;
  }

  @media (--bp-tablet) {
    .ep-detail__pager {
      width: 100%;
      display: block;
    }
  }
</style>
