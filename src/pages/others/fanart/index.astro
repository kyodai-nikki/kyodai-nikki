---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ImageCardFrame from "../../../components/common/ImageCardFrame.astro";
import PageHeading from "../../../components/common/PageHeading.astro";
import OthersTabs from "../../../components/others/OthersTabs.astro";
import { fanArtImageSrc, orderedFanArt } from "../../../lib/others";
import { othersPageMsg } from "../../../msg/others";
import { navigation } from "../../../data/navigation";

const fanArt = await orderedFanArt();
---

<BaseLayout
  title={`${navigation.others.title} | fan art`}
  description={othersPageMsg.meta.description}
  pageSectionClass="others"
>
  <PageHeading slot="page-heading" title={navigation.others.title} />
  <OthersTabs slot="page-tabs" currentSection="fan-art" />

  <div class="others-fanart">
        {fanArt.map((item) => (
          <a
            class="others-fanart__card"
            href={item.data.url}
            target="_blank"
            rel="noopener"
            aria-label={`${item.data.title} 繧呈眠縺励＞繧ｿ繝悶〒髢九￥`}
          >
            <ImageCardFrame aspectRatio="4 / 2.65">
              <img
                src={fanArtImageSrc(item)}
                alt={item.data.title}
                loading="lazy"
                width="640"
                height="480"
              />
            </ImageCardFrame>
            <p class="others-fanart__title">{item.data.title}</p>
          </a>
        ))}
  </div>
</BaseLayout>

<style>
  .others {
    padding-top: 20px;
  }

  .others-fanart {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 300px));
    justify-content: center;
    align-items: start;
    gap: 24px 26px;
    max-width: 980px;
    min-height: 300px;
    margin: 0 auto;
  }

  .others-fanart__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--c-fg);
    text-decoration: none;
  }

  .others-fanart__title {
    margin: 0;
    font-family: var(--font-family-base);
    font-size: 1.125rem;
    line-height: 1.45;
    text-align: center;
  }

  @media (--bp-tablet) {
    .others-fanart {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 680px;
      min-height: auto;
    }
  }
</style>
