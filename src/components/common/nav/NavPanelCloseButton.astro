---
import Icon, { IconName } from "../Icon.astro";

interface Props {
  label: string;
  class?: string;
  dataAttribute?: string;
}

const {
  label,
  class: className = "",
  dataAttribute,
} = Astro.props as Props;

const attrs = dataAttribute ? { [dataAttribute]: true } : {};
---

<button
  class:list={["nav-panel-close", className]}
  type="button"
  aria-label={label}
  {...attrs}
>
  <Icon name={IconName.Close} size="100%" />
</button>

<style>
  .nav-panel-close {
    --nav-panel-close-fg: var(--c-nav-panel-close-fg);

    appearance: none;
    position: absolute;
    top: 20px;
    right: 18px;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--nav-panel-close-fg);
    line-height: 0;
    cursor: pointer;
    transform: scale(1);
    transition: transform var(--dur-base) var(--ease-button);
  }

  .nav-panel-close:hover,
  .nav-panel-close:focus-visible {
    transform: scale(var(--nav-panel-close-hover-scale, 1.14));
  }
</style>
