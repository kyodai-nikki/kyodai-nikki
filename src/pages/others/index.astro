---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import { defaultOthersPath } from "../../data/othersSections";
import { withBase } from "../../lib/urls";
import { othersPageMsg } from "../../msg/others";
import { navigation } from "../../data/navigation";

const target = withBase(defaultOthersPath());
---

<BaseLayout
  title={navigation.others.title}
  description={othersPageMsg.meta.description}
  pageContainerClass="container--narrow others-redirect"
>
  <PageHeading slot="page-heading" title={navigation.others.title} />
  <div>
    <p>{othersPageMsg.redirect.loading}</p>
    <p>
      <a href={target}>{othersPageMsg.redirect.fallbackLink}</a>
    </p>
  </div>

  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>

<style>
  .others-redirect {
    text-align: center;
  }

  .others-redirect p {
    margin: 12px 0 0;
    color: var(--c-fg-muted);
  }

  .others-redirect a {
    --others-redirect-link-fg: var(--c-fg);
    --others-redirect-link-hover-fg: rgb(from var(--others-redirect-link-fg) r g b / 0.7);

    color: var(--others-redirect-link-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: currentColor;
    transition:
      color var(--dur-base) var(--ease-out),
      text-decoration-color var(--dur-base) var(--ease-out);
  }

  .others-redirect a:hover,
  .others-redirect a:focus-visible {
    color: var(--others-redirect-link-hover-fg);
    text-decoration-color: var(--others-redirect-link-hover-fg);
  }
</style>
