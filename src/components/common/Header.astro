---
import { commonMsg } from "../../msg/common";
import { siteConfig } from "../../config";
import { withBase } from "../../lib/urls";
import { headerNavItems } from "../../lib/view/navigation";
import { IconName } from "./Icon.astro";
import NavToggleButton from "./nav/NavToggleButton.astro";
import SiteNavDrawer from "./nav/SiteNavDrawer.astro";
import XShareButton from "./btn/XShareButton.astro";

const site = siteConfig;
const path = Astro.url.pathname;
const items = headerNavItems(path);
---
<header class="site-header">
  <div class="container site-header__top">
    <a class="site-brand" href={withBase("/")}>
      <img src={withBase(site.logoPath)} alt={site.name} class="site-brand__logo" />
    </a>

    <div class="site-social">
      {site.social.twitter && (
        <XShareButton href={site.social.twitter} />
      )}

      <NavToggleButton
        controls="site-nav"
        labelOpen={commonMsg.menu.open}
        labelClose={commonMsg.actions.close}
        iconOpen={IconName.Menu}
        iconClose={IconName.Menu}
      />
    </div>
  </div>

  <div class="site-header__nav">
    <SiteNavDrawer
      id="site-nav"
      ariaLabel={commonMsg.menu.navigation}
      openLabel={commonMsg.menu.open}
      closeLabel={commonMsg.actions.close}
      items={items}
      twitterHref={site.social.twitter}
    />
  </div>
</header>

<style>
  :global(body) {
    --site-header-offset: calc(var(--h-header-top));
    padding-top: calc(var(--h-header-top) + var(--h-header-nav));
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
  }

  .site-header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    width: 100%;
    max-width: none;
    height: var(--h-header-top);
    padding-inline: 200px;
    background: var(--c-header-bg);
  }

  .site-brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--font-family-navigation);
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--c-fg);
    text-decoration: none;
    letter-spacing: var(--ls-normal);
  }

  .site-brand__logo {
    width: 200px;
    height: 60px;
    display: block;
    object-fit: contain;
  }

  .site-social {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    --share-btn-size: 30px;
  }

  .site-header__nav {
    position: relative;
    z-index: 11;
    display: flex;
    justify-content: center;
    min-height: var(--h-header-nav);
    background: var(--c-header-nav-bg);
    box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.14);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
  }

  @media (--bp-laptop) {
    :global(body) {
      --site-header-offset: 150px;
      padding-top: 150px;
    }

    .site-header {
      border-bottom: 0;
    }

    .site-header__top {
      height: 150px;
      padding-inline: var(--s-6);
      position: relative;
      box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.14);
    }

    .site-brand__logo {
      width: 240px;
      height: 72px;
    }

    .site-brand {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .site-social {
      margin-left: auto;
    }

    .site-social :global(.share-button) {
      display: none;
    }

    .site-header__nav {
      min-height: 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      z-index: auto;
      box-shadow: none;
    }

  }

  @media (--bp-tablet) {
    :global(body) {
      --site-header-offset: 75px;
      padding-top: 75px;
    }

    .site-header__top {
      height: 75px;
    }

    .site-brand__logo {
      width: 200px;
      height: 40px;
    }

  }

  @media (--bp-mobile) {
    .site-header__top {
      padding-right: var(--s-4);
    }

    .site-brand__logo {
      width: 180px;
      height: 35px;
    }
  }
</style>
