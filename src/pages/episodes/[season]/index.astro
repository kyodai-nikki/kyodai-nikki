---
import {
  seasons as getSeasons,
  firstEpisodeOfSeason,
  episodeHref,
  episodeSeasonStaticPaths,
} from "../../../lib/episodes";
import { episodesPageMsg } from "../../../msg/episodes";

export async function getStaticPaths() {
  return await episodeSeasonStaticPaths();
}

interface Props {
  seasonNumber: 1 | 2 | 3 | 4;
}

const { seasonNumber } = Astro.props as Props;
const seasons = await getSeasons();
const seasonInfo = seasons.find((s) => s.number === seasonNumber)!;
const initial = await firstEpisodeOfSeason(seasonNumber);
const redirectTo = initial ? episodeHref(seasonInfo.slug, initial) : "/episodes";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <link rel="canonical" href={redirectTo} />
    <title>{seasonInfo.label} | {episodesPageMsg.title}</title>
  </head>
  <body>
    <p><a href={redirectTo}>{episodesPageMsg.redirecting}</a></p>
  </body>
</html>
