---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import { defaultOthersPath } from "../../data/others/tab";
import { commonMsg } from "../../msg/common";
import { othersPageMsg } from "../../msg/pages/others";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}${defaultOthersPath}`;
---

<BaseLayout
  title={othersPageMsg.title}
  description={othersPageMsg.description}
  pageContainerClass="container--narrow others-redirect"
>
  <PageHeading slot="page-heading" title={othersPageMsg.title} />
  <div>
    <p>{othersPageMsg.redirecting}</p>
    <p>
      <a href={target}>{othersPageMsg.redirectLink}</a>
    </p>
  </div>

  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>

<style>
  .others-redirect {
    text-align: center;
  }

  .others-redirect p {
    margin: 12px 0 0;
    color: var(--c-fg-muted);
  }

  .others-redirect a {
    color: var(--c-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
