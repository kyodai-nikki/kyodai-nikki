---
import { getCollection } from "astro:content";
import {
  episodesBySeason,
  seasons as getSeasons,
  episodeHref,
  episodeUrlSlug,
  episodeListDummyImage,
  episodeThumbnailDummyImage,
  type EpisodeEntry,
  type SeasonInfo,
} from "../../../lib/episodes";
import {
  episodeLogHref,
  episodeOverviewLabel,
} from "../../../lib/episodes/view";
import { hasAnyEpisodeLog } from "../../../lib/episodes/logs";
import EpisodeStickyNav from "../EpisodeStickyNav.astro";
import EpisodeDetail from "./EpisodeDetail.astro";
import EpisodeDetailPager from "./EpisodeDetailPager.astro";
import EpisodeList from "./EpisodeList.astro";

type EpisodeMeta = EpisodeEntry & {
  badge?: string;
};

interface Props {
  activeSeason: SeasonInfo["number"];
  selected?: EpisodeEntry;
  activeSlug?: string;
}

const { activeSeason, selected, activeSlug } = Astro.props as Props;
const dummyEpisodeList = episodeListDummyImage();
const dummyThumbnail = episodeThumbnailDummyImage();

const seasons = await getSeasons();
const activeSeasonInfo = seasons.find((s) => s.number === activeSeason)!;
const list = await episodesBySeason(activeSeason);
const logEntries = await getCollection("episodeLogs");

const current: EpisodeMeta | undefined =
  (selected as EpisodeMeta | undefined) ??
  (list.find((e) => episodeUrlSlug(e) === activeSlug) as EpisodeMeta | undefined) ??
  (list[0] as EpisodeMeta | undefined);

const logHref = current
  && hasAnyEpisodeLog(activeSeasonInfo.slug, episodeUrlSlug(current), logEntries)
  ? episodeLogHref(activeSeasonInfo.slug, current)
  : undefined;

const currentIndex = current
  ? list.findIndex((e) => e.overallNumber === current.overallNumber)
  : -1;
const previousEpisode = currentIndex > 0 ? list[currentIndex - 1] : undefined;
const nextEpisode =
  currentIndex >= 0 && currentIndex < list.length - 1
    ? list[currentIndex + 1]
    : undefined;
const previousSeasonInfo = seasons.find((s) => s.number === activeSeasonInfo.number - 1);
const nextSeasonInfo = seasons.find((s) => s.number === activeSeasonInfo.number + 1);
const previousSeasonEpisodes = previousSeasonInfo
  ? await episodesBySeason(previousSeasonInfo.number)
  : [];
const nextSeasonEpisodes = nextSeasonInfo
  ? await episodesBySeason(nextSeasonInfo.number)
  : [];
const previousSeasonLastEpisode = previousSeasonEpisodes.at(-1);
const nextSeasonFirstEpisode = nextSeasonEpisodes[0];
const previousHref = previousEpisode
  ? episodeHref(activeSeasonInfo.slug, previousEpisode)
  : previousSeasonInfo && previousSeasonLastEpisode
    ? episodeHref(previousSeasonInfo.slug, previousSeasonLastEpisode)
    : undefined;
const nextHref = nextEpisode
  ? episodeHref(activeSeasonInfo.slug, nextEpisode)
  : nextSeasonInfo && nextSeasonFirstEpisode
    ? episodeHref(nextSeasonInfo.slug, nextSeasonFirstEpisode)
    : undefined;

const stickyNavItems = list.map((episode) => ({
  href: episodeHref(activeSeasonInfo.slug, episode),
  numberLabel: episodeOverviewLabel(episode),
  title: episode.title,
  active: current?.overallNumber === episode.overallNumber,
}));
---

<EpisodeStickyNav items={stickyNavItems} />

<div class="ep-layout">
  <EpisodeList
    list={list}
    seasonSlug={activeSeasonInfo.slug}
    seasonLabel={activeSeasonInfo.label}
    currentOverallNumber={current?.overallNumber}
    dummyEpisodeList={dummyEpisodeList}
  />

  <EpisodeDetail
    current={current}
    seasonSlug={activeSeasonInfo.slug}
    logHref={logHref}
    dummyThumbnail={dummyThumbnail}
  />

  {current && (
    <EpisodeDetailPager previousHref={previousHref} nextHref={nextHref} />
  )}
</div>

<style>
  .ep-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(var(--s-4), 3vw, var(--s-6));
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (--bp-tablet) {
    .ep-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import "./episodesNavigator";
</script>
