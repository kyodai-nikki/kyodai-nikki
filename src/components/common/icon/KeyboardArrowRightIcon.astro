---
import type { IconProps } from "./IconProps";

type Props = IconProps;

const {
  size = "24px",
  class: className,
  "aria-hidden": ariaHidden = true,
  "aria-label": ariaLabel,
} = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class:list={[className]}
  aria-hidden={ariaHidden}
  aria-label={ariaLabel}
>
  <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" />
</svg>
