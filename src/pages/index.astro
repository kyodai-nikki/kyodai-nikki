---
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { imageAllSrcs, imageMaxHeight } from "../lib/image-utils";
import { withBase } from "../lib/urls";
import { homePageMsg } from "../msg/home";
import { siteConfig } from "../config";
import Tagline from "../content/home.md";

const slideshowDir = resolve(process.cwd(), "public/images/home");
const slideImages = siteConfig.enableSlideshow
  ? imageAllSrcs(slideshowDir, "/images/home")
  : [withBase("/images/home/home.png")];

// スライド表示領域の高さは「最も高い画像」の80%に揃える。
// 画像サイズが取得できなかった場合のフォールバックとして 800px を使う。
const HOME_HEIGHT_RATIO = 0.8;
const HOME_HEIGHT_FALLBACK_PX = 800;
const maxImageHeight = await imageMaxHeight(slideshowDir);
const slideHeightPx = maxImageHeight
  ? Math.round(maxImageHeight * HOME_HEIGHT_RATIO)
  : HOME_HEIGHT_FALLBACK_PX;
---
<BaseLayout
  title={homePageMsg.meta.title}
  description={homePageMsg.meta.description}
  bodyClass="is-home"
>
  <section
    class="home"
    style={`--home-image-height: ${slideHeightPx}px;`}
    aria-label={homePageMsg.aria.homeVisual}
  >
    <div
      class="home__image"
      role="img"
      aria-label={homePageMsg.alt.homeFallbackImage}
    >
      {slideImages.map((src, i) => (
        <div
          class="home__slide"
          data-index={i}
        >
          <img src={src} alt="" />
        </div>
      ))}
    </div>
    <div class="home__overlay">
      <img src={withBase(siteConfig.logoPath)} alt={siteConfig.name} class="site-brand__logo" />
      <div class="home__tagline"><Tagline /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    position: relative;
    width: 100%;
    background: var(--c-home-bg);
  }

  .home__image {
    display: grid;
    width: 100%;
    /* --home-image-height はビルド時に「最も高い画像 × 80%」を index.astro が注入する。
       画像が読めなかった等のフォールバック値として 800px を使う */
    height: var(--home-image-height, 800px);
    overflow: hidden;
  }

  .home__slide {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .home__slide.is-visible {
    opacity: 1;
  }

  .home__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .home__overlay {
    position: absolute;
    inset: 0;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: var(--s-6) 0;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--s-5);
    row-gap: var(--s-2);
  }

  .home__overlay img {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: 450px;
    height: auto;
  }

  .home__tagline {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    text-align: left;
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: var(--c-fg);
    line-height: 1.8;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .home__tagline :global(p) {
    font-size: 32px;
    margin: 0;
    white-space: pre-wrap;
  }

  @media (--bp-tablet) {
    .home__overlay {
      padding: var(--s-5) var(--s-4);
      grid-template-columns: 1fr;
    }

    .home__tagline {
      grid-column: 1;
      text-align: left;
      justify-self: start;
    }
  }
</style>

<script>
  import { siteConfig } from "../config";

  // ClientRouter 対応のため、ページ遷移をまたいで保持される
  // インターバルを毎回クリアしてから再初期化する
  let slideshowTimer: number | undefined;

  const initHomeSlideshow = () => {
    if (slideshowTimer !== undefined) {
      clearInterval(slideshowTimer);
      slideshowTimer = undefined;
    }

    const slides = document.querySelectorAll<HTMLElement>(".home__slide");
    if (slides.length === 0) return;

    slides.forEach((slide) => slide.classList.remove("is-visible"));
    slides[0].classList.add("is-visible");

    if (slides.length > 1) {
      let current = 0;
      slideshowTimer = window.setInterval(() => {
        slides[current].classList.remove("is-visible");
        current = (current + 1) % slides.length;
        slides[current].classList.add("is-visible");
      }, siteConfig.slideshowTimeout);
    }
  };

  // ClientRouter 対応: ページ遷移のたびに実行
  document.addEventListener("astro:page-load", initHomeSlideshow);
</script>
