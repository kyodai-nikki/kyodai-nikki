---
// /episodes/season{N}/  → 該当シーズンの最初のエピソードへリダイレクト
import {
  seasons,
  firstEpisodeOfSeason,
  episodeHref,
} from "../../../data/episodes";

export async function getStaticPaths() {
  return seasons.map((s) => ({
    params: { season: s.slug },
    props: { seasonNumber: s.number },
  }));
}

interface Props {
  seasonNumber: 1 | 2 | 3 | 4;
}

const { seasonNumber } = Astro.props as Props;
const seasonInfo = seasons.find((s) => s.number === seasonNumber)!;
const initial = firstEpisodeOfSeason(seasonNumber);
const redirectTo = initial
  ? episodeHref(seasonInfo.slug, initial.slug)
  : "/episodes/";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <link rel="canonical" href={redirectTo} />
    <title>{seasonInfo.label} | Episodes</title>
  </head>
  <body>
    <script is:inline>{`location.replace(${JSON.stringify(redirectTo)});`}</script>
  </body>
</html>
