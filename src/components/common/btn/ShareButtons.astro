---
import LineShareButton from "./LineShareButton.astro";
import XShareButton from "./XShareButton.astro";
import { shareLinks } from "../../../lib/view/share";

interface Props {
  url: string;
  title: string;
  variant?: "default" | "log";
  className?: string;
}

const { url, title, variant = "default", className = "" } = Astro.props;
const { xHref, lineHref } = shareLinks(url, title);
---

<div class:list={["share-buttons", variant !== "default" && `share-buttons--${variant}`, className]}>
  <XShareButton href={xHref} />
  <LineShareButton href={lineHref} />
</div>

<style>
  .share-buttons {
    --share-btn-size: 22px;
    --share-line-icon-size: 15px;

    display: inline-flex;
    align-items: center;
    gap: var(--share-buttons-gap, 10px);
  }

  /* Generated from the `variant` prop: share-buttons--${variant}. */
  .share-buttons--log {
    --share-btn-size: 30px;
    --share-line-icon-size: 28px;
    --share-buttons-gap: 18px;
    --share-btn-bg: var(--c-share-btn-bg-on-log);
  }
</style>
