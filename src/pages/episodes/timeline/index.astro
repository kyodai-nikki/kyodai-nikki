---
// /episodes/timeline/  → 全シーズン通しタイムライン
//   - 左：シーズン一覧（クイックジャンプ、sticky）
//   - 右：シーズン毎にまとまった縦タイムライン
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  seasons,
  episodesTimeline,
  timelineEpisodeHref,
  type TimelineEntry,
} from "../../../data/episodes";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const timeline = episodesTimeline();

const numberLabel = (e: TimelineEntry) =>
  e.isAlternate
    ? "—"
    : `Episode${String(e.seasonEpisodeNumber ?? "").padStart(2, "0")}`;

// シーズン毎に通算番号順で並べる
const grouped = seasons.map((s) => ({
  season: s,
  items: timeline.filter((e) => e.season === s.number),
}));
---
<BaseLayout title="Timeline | Episodes" description="兄弟日記 全エピソードのタイムライン。">
  <section class="section container">
    <header class="section-head section-head--center">
      <h1 class="ep-heading">Episodes</h1>
    </header>

    {/* シーズン切替タブ＋ timeline -------------------------- */}
    <nav class="ep-seasons" aria-label="シーズン切替">
      {seasons.map((s) => (
        <a href={`${base}/episodes/${s.slug}/`}>{s.label}</a>
      ))}
      <a href={`${base}/episodes/timeline/`} aria-current="page">timeline</a>
    </nav>

    {/* タイムライン本体：左にクイックジャンプ、右に本文 ----- */}
    <div class="tl-layout">
      {/* 左：シーズン一覧 */}
      <aside class="tl-side" aria-label="シーズンへジャンプ">
        <ol class="tl-side__list">
          {seasons.map((s) => (
            <li>
              <a class="tl-side__btn" href={`#${s.slug}`}>{s.label}</a>
            </li>
          ))}
        </ol>
      </aside>

      {/* 右：シーズン毎の縦タイムライン */}
      <div class="tl-main">
        {grouped.map(({ season, items }) => (
          <section class="tl-season" id={season.slug} aria-label={season.label}>
            <header class="tl-season__head">
              <h2>{season.label}</h2>
            </header>

            {items.length === 0 ? (
              <p class="tl-season__empty">エピソードがまだありません。</p>
            ) : (
              <ol class="tl-rows">
                {items.map((e) => {
                  const cls = ["tl-row"];
                  if (e.isAlternate) cls.push("tl-row--alt");
                  if (e.smallText)  cls.push("tl-row--sm");
                  return (
                    <li class={cls.join(" ")}>
                      {/* 通常エピソード：左＝カード、右＝日付/キャスト */}
                      {/* 別史エピソード：左＝日付/キャスト、右＝黒カード（CSS で順序入替） */}
                      <a class="tl-row__card" href={base + timelineEpisodeHref(e)}>
                        <span class="tl-row__no">{numberLabel(e)}</span>
                        <span class="tl-row__title">{e.title}</span>
                        {e.isAlternate && <span class="tl-row__tag">Another Episode</span>}
                      </a>
                      <div class="tl-row__meta">
                        {e.date && <div class="tl-row__date">{e.date}</div>}
                        {e.cast && <div class="tl-row__cast">{e.cast}</div>}
                      </div>
                    </li>
                  );
                })}
              </ol>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ep-heading {
    font-family: var(--f-serif);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* ====== シーズンタブ（共通スタイル） ====== */
  .ep-seasons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(var(--s-5), 5vw, var(--s-8));
    margin-bottom: 30px;
    padding-bottom: var(--s-3);
  }
  .ep-seasons a {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: var(--c-fg);
    text-decoration: none;
    letter-spacing: var(--ls-wide);
    padding: var(--s-2) 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ep-seasons a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -3px;
    height: 2px;
    background: var(--c-accent-cyan);
    transition: left var(--dur-base) var(--ease-out),
                right var(--dur-base) var(--ease-out);
    pointer-events: none;
  }
  .ep-seasons a:hover::after,
  .ep-seasons a:focus-visible::after {
    left: 0;
    right: 0;
  }
  .ep-seasons a[aria-current="page"]::after {
    left: 0;
    right: 0;
    background: var(--c-accent-pink);
    transition: none;
  }

  /* ====== 左：シーズン一覧（sticky） ＋ 右：本体 ====== */
  .tl-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(var(--s-4), 4vw, var(--s-7));
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  .tl-side {
    position: sticky;
    top: var(--s-5);
  }
  .tl-side__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .tl-side__btn {
    display: block;
    padding: var(--s-3) var(--s-4);
    background: #ffffff;
    border: 1px solid var(--c-border);
    color: var(--c-fg);
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-wide);
    text-decoration: none;
    text-align: center;
    transition: background var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .tl-side__btn:hover,
  .tl-side__btn:focus-visible {
    background: var(--c-bg-muted);
    border-color: var(--c-border-strong);
  }

  /* ====== 右：シーズンごとのまとまり ====== */
  .tl-main {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }
  .tl-season {
    scroll-margin-top: var(--s-5);
  }
  .tl-season__head {
    background: var(--c-accent-cyan);
    color: #ffffff;
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-5);
  }
  .tl-season__head h2 {
    margin: 0;
    text-align: center;
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
  }
  .tl-season__empty {
    color: var(--c-fg-muted);
    text-align: center;
    padding: var(--s-5);
  }

  /* ====== タイムライン本体：中央に縦線、左右に要素 ====== */
  .tl-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .tl-rows::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--c-border);
    transform: translateX(-0.5px);
  }
  .tl-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--s-5);
    align-items: center;
    padding: var(--s-3) 0;
    min-height: 76px;
  }

  /* 中央線上のドット */
  .tl-row::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    background: #ffffff;
    border: 2px solid var(--c-fg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  /* ----- 通常エピソード：左にカード、右にメタ ----- */
  .tl-row__card {
    grid-column: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 100%;
    padding: var(--s-3) var(--s-4);
    background: #ffffff;
    border: 1px solid var(--c-border);
    color: var(--c-fg);
    text-decoration: none;
    font-family: var(--f-serif);
    transition: background var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .tl-row__card:hover,
  .tl-row__card:focus-visible {
    background: var(--c-bg-muted);
    border-color: var(--c-border-strong);
  }
  .tl-row__no {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    white-space: nowrap;
  }
  .tl-row__title {
    font-size: var(--fs-base);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tl-row--sm .tl-row__title { font-size: var(--fs-sm); }
  .tl-row__tag {
    display: none; /* 通常エピソードでは非表示 */
  }

  .tl-row__meta {
    grid-column: 2;
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: var(--s-3);
  }
  .tl-row__date {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    letter-spacing: var(--ls-wide);
    color: var(--c-fg);
  }
  .tl-row__cast {
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    line-height: 1.6;
  }

  /* ----- 別史エピソード：左右を入れ替え（左にメタ、右に黒カード） ----- */
  .tl-row--alt .tl-row__card {
    grid-column: 2;
    grid-row: 1;
    justify-self: start;
    background: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4);
    min-width: 220px;
  }
  .tl-row--alt .tl-row__card:hover {
    background: #2c2c2c;
    border-color: #2c2c2c;
  }
  .tl-row--alt .tl-row__no { display: none; } /* "—" は出さない */
  .tl-row--alt .tl-row__tag {
    display: inline-block;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: var(--ls-wide);
    color: #cccccc;
    text-transform: uppercase;
  }
  .tl-row--alt .tl-row__title {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: #ffffff;
  }

  .tl-row--alt .tl-row__meta {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    text-align: right;
    padding-left: 0;
    padding-right: var(--s-3);
  }

  /* ====== レスポンシブ ====== */
  @media (max-width: 880px) {
    .tl-layout {
      grid-template-columns: 1fr;
    }
    .tl-side {
      position: static;
    }
    .tl-side__list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
    .tl-side__btn {
      padding: var(--s-2) var(--s-3);
      font-size: var(--fs-xs);
    }
  }
  @media (max-width: 640px) {
    /* 中央線レイアウトを諦め、すべて 1 カラム表示 */
    .tl-rows::before { display: none; }
    .tl-row,
    .tl-row--alt {
      grid-template-columns: 1fr;
      row-gap: var(--s-2);
    }
    .tl-row::after { display: none; }
    .tl-row__card,
    .tl-row--alt .tl-row__card {
      grid-column: 1;
      grid-row: auto;
      justify-self: stretch;
    }
    .tl-row__meta,
    .tl-row--alt .tl-row__meta {
      grid-column: 1;
      grid-row: auto;
      justify-self: stretch;
      text-align: left;
      padding: 0;
    }
  }
</style>
