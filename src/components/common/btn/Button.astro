---
interface Props {
  href?: string;
  type?: "white" | "black";
  size?: "s" | "m" | "l";
  fullWidth?: boolean;
  minWidth?: string;
  minHeight?: string;
  paddingBlock?: string;
  paddingInline?: string;
  borderColor?: string;
  bg?: string;
  color?: string;
  fontSize?: string;
  lineHeight?: string;
  radius?: string;
  layout?: "default" | "action";
  buttonType?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  className?: string;
  style?: string;
}

const {
  href,
  type = "white",
  size = "m",
  fullWidth = false,
  minWidth,
  minHeight,
  paddingBlock,
  paddingInline,
  borderColor,
  bg,
  color,
  fontSize,
  lineHeight,
  radius,
  layout = "default",
  buttonType = "button",
  disabled = false,
  class: classProp = "",
  className = "",
  style = "",
  ...attrs
} = Astro.props as Props & Record<string, unknown>;

const classes = [
  "ui-button",
  `ui-button--${type}`,
  `ui-button--${size}`,
  fullWidth && "ui-button--full",
  layout !== "default" && `ui-button--layout-${layout}`,
  disabled && "ui-button--disabled",
  classProp,
  className,
];
const styleVars = [
  style,
  minWidth ? `--button-min-width: ${minWidth}` : "",
  minHeight ? `--button-min-height: ${minHeight}` : "",
  paddingBlock ? `--button-padding-block: ${paddingBlock}` : "",
  paddingInline ? `--button-padding-inline: ${paddingInline}` : "",
  borderColor ? `--button-border-color: ${borderColor}` : "",
  bg ? `--button-bg: ${bg}` : "",
  color ? `--button-color: ${color}` : "",
  fontSize ? `--button-font-size: ${fontSize}` : "",
  lineHeight ? `--button-line-height: ${lineHeight}` : "",
  radius ? `--button-radius: ${radius}` : "",
].filter(Boolean).join("; ");
---

{
  href && !disabled ? (
    <a class:list={classes} href={href} style={styleVars || undefined} {...attrs}>
      <slot />
    </a>
  ) : href && disabled ? (
    <span class:list={classes} style={styleVars || undefined} aria-disabled="true" {...attrs}>
      <slot />
    </span>
  ) : (
    <button class:list={classes} type={buttonType} style={styleVars || undefined} disabled={disabled} {...attrs}>
      <slot />
    </button>
  )
}

<style>
  .ui-button {
    --button-min-height: 58px;
    --button-min-width: auto;
    --button-padding-block: 14px;
    --button-padding-inline: 18px;
    --button-border-color: var(--c-btn-border);
    --button-bg: var(--c-btn-bg);
    --button-color: var(--c-btn-fg);
    --button-hover-bg: var(--c-btn-hover-bg);
    --button-hover-color: var(--c-btn-hover-fg);
    --button-active-bg: var(--c-btn-bg);
    --button-active-color: var(--c-btn-fg);
    --button-active-border-color: var(--c-btn-border);
    --button-font-family: var(--font-family-base);
    --button-font-size: 1.125rem;
    --button-line-height: 1.2;
    --button-radius: var(--r-md);
    --button-box-shadow: none;
    --button-transform: translateY(0);

    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--button-min-width);
    min-height: var(--button-min-height);
    padding: var(--button-padding-block) var(--button-padding-inline);
    margin: 0;
    border: 1px solid var(--button-border-color);
    background: var(--button-bg);
    color: var(--button-color);
    font-family: var(--button-font-family);
    font-size: var(--button-font-size);
    line-height: var(--button-line-height);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--button-radius);
    box-shadow: var(--button-box-shadow);
    transform: var(--button-transform);
    transition:
      background-color var(--dur-base) var(--ease-button),
      border-color var(--dur-base) var(--ease-button),
      color var(--dur-base) var(--ease-button);
  }

  .ui-button:hover,
  .ui-button:focus-visible {
    background: var(--button-hover-bg);
    color: var(--button-hover-color);
  }

  .ui-button--disabled,
  .ui-button--disabled:hover,
  .ui-button--disabled:focus-visible,
  .ui-button:disabled,
  .ui-button:disabled:hover,
  .ui-button:disabled:focus-visible {
    background: var(--button-bg);
    border-color: var(--button-border-color);
    color: var(--button-color);
    cursor: default;
  }

  .ui-button[aria-current="page"],
  .ui-button[aria-current="page"]:hover,
  .ui-button[aria-current="page"]:focus-visible {
    background: var(--button-active-bg);
    border-color: var(--button-active-border-color);
    color: var(--button-active-color);
  }

  /* Generated from the `type` prop: ui-button--${type}. */
  .ui-button--white {
    --button-border-color: var(--c-btn-border);
    --button-bg: var(--c-white-btn-bg);
    --button-color: var(--c-white-btn-fg);
    --button-hover-bg: var(--c-white-btn-hover-bg);
    --button-hover-color: var(--c-white-btn-hover-fg);
    --button-active-bg: var(--c-btn-bg);
    --button-active-color: var(--c-btn-fg);
    --button-active-border-color: var(--c-btn-border);
  }

  .ui-button--black {
    --button-border-color: var(--c-btn-border);
    --button-bg: var(--c-btn-bg);
    --button-color: var(--c-btn-fg);
    --button-hover-bg: var(--c-btn-hover-bg);
    --button-hover-color: var(--c-btn-hover-fg);
  }

  .ui-button--full {
    width: 100%;
  }

  /* Generated from the `layout` prop: ui-button--layout-${layout}. */
  .ui-button--layout-action {
    --button-min-width: 160px;
  }

  /* Generated from the `size` prop: ui-button--${size}. */
  .ui-button--s {
    --button-min-width: 90px;
    --button-min-height: 0;
    --button-padding-block: 10px;
    --button-padding-inline: 22px;
    --button-font-size: 1rem;
  }

  .ui-button--m {
    --button-min-width: 165px;
    --button-min-height: 55px;
    --button-padding-block: 0;
    --button-padding-inline: 0;
    --button-font-size: 1.25rem;
  }

  .ui-button--l {
    --button-min-width: 200px;
    --button-min-height: 64px;
    --button-padding-block: 20px;
    --button-padding-inline: 0;
    --button-font-size: 20px;
  }

  @media (--bp-tablet) {
    .ui-button--layout-action {
      --button-min-width: 0;
      flex: 1 1 140px;
    }
  }
</style>
