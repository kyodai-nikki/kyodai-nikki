---
import type { IconProps } from "./IconProps";

type Props = IconProps;

const {
  size = "24px",
  class: className,
  "aria-hidden": ariaHidden = true,
  "aria-label": ariaLabel,
} = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class:list={[className]}
  aria-hidden={ariaHidden}
  aria-label={ariaLabel}
>
  <path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z" />
</svg>
