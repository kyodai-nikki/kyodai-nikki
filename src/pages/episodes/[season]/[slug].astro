---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeading from "../../../components/common/PageHeading.astro";
import EpisodesSeasonTabs from "../../../components/episodes/list/EpisodesSeasonTabs.astro";
import EpisodesNavigator from "../../../components/episodes/list/EpisodesNavigator.astro";
import {
  allEpisodes,
  seasons,
  episodeUrlSlug,
  type EpisodeEntry,
} from "../../../data/episodes";
import { episodesPageMsg } from "../../../msg/pages/episodes";

export async function getStaticPaths() {
  return allEpisodes().map(({ season, episode }) => ({
    params: { season: season.slug, slug: episodeUrlSlug(episode) },
    props: { episode, seasonNumber: season.number },
  }));
}

interface Props {
  episode: EpisodeEntry;
  seasonNumber: 1 | 2 | 3 | 4;
}

const { episode, seasonNumber } = Astro.props as Props;
const seasonInfo = seasons.find((s) => s.number === seasonNumber)!;
---

<BaseLayout
  title={`${episode.title} | ${seasonInfo.label} | Episodes`}
  description={episode.description.split("\n")[0] ?? episode.title}
>
  <PageHeading slot="page-heading" title={episodesPageMsg.title} />
  <EpisodesSeasonTabs slot="page-tabs" activeSeason={seasonNumber} />
  <EpisodesNavigator
    activeSeason={seasonNumber}
    selected={episode}
    activeSlug={episodeUrlSlug(episode)}
  />
</BaseLayout>
