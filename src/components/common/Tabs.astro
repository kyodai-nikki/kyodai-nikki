---
export interface TabItem {
  /** 表示ラベル */
  label: string;
  /** 遷移先 URL（base 込みの完成形を渡す） */
  href: string;
  /** 現在ページならtrue。aria-current="page" になる */
  active?: boolean;
}

interface Props {
  /** タブの並び。渡された順に左から表示する */
  items: TabItem[];
  /** <nav> の aria-label。スクリーンリーダー用 */
  ariaLabel: string;
  /** サイズ。md = Episodes 系（小さめ）、lg = Others 系（大きめ） */
  size?: "md" | "lg";
}

const { items, ariaLabel, size = "md" } = Astro.props;
---

<nav class:list={["tab-nav", `tab-nav--${size}`]} aria-label={ariaLabel}>
  {items.map((item) => (
    <a href={item.href} aria-current={item.active ? "page" : undefined}>
      {item.label}
    </a>
  ))}
</nav>

<style>
  .tab-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tab-nav a {
    font-weight: 600;
    position: relative;
    color: var(--c-fg);
    font-family: var(--font-family-navigation);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tab-nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -2px;
    height: 2px;
    transition:
      left var(--dur-base) var(--ease-out),
      right var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .tab-nav a:hover::after,
  .tab-nav a:focus-visible::after {
    left: 0;
    right: 0;
    border: 2px solid var(--c-site-cyan);
  }

  .tab-nav a[aria-current="page"]::after {
    left: 0;
    right: 0;
    border: 2px solid var(--c-site-pink);
    transition: none;
  }

  /* ---- size: md（Episodes 系） */
  .tab-nav--md {
    gap: clamp(var(--s-5), 5vw, var(--s-6));
    padding-bottom: var(--s-3);
  }

  .tab-nav--md a {
    font-size: var(--fs-xl);
    letter-spacing: var(--ls-wide);
  }

  .tab-nav--md a::after {
    bottom: -3px;
  }

  /* ---- size: lg（Others 系） */
  .tab-nav--lg {
    gap: clamp(28px, 4vw, 56px);
    margin: 20px 0 0;
    padding-bottom: 8px;
  }

  .tab-nav--lg a {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    padding: 6px 0;
  }

  @media (--bp-tablet) {
    .tab-nav--lg {
      gap: 20px 28px;
    }

    .tab-nav--lg a {
      font-size: 1.125rem;
    }
  }
</style>
