---
import { common } from "../../msg/common";
import Icon, { IconName } from "./Icon.astro";
---
<a href="#top" class="back-to-top" aria-label={common.accessibility.backToTop}>
  <Icon name={IconName.ChevronUp} size={28} />
</a>

<style>
  .back-to-top {
    position: fixed;
    right: 28px;
    bottom: 28px;
    width: 68px;
    height: 68px;
    border-radius: 9999px;
    background: var(--c-back-to-top-bg);
    color: var(--c-back-to-top-fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
    z-index: 20;
  }

  .back-to-top[data-visible="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .back-to-top:hover {
    transform: translateY(-2px);
    background: var(--c-back-to-top-bg-hover);
    color: var(--c-back-to-top-fg);
  }

  .back-to-top svg {
    width: 28px;
    height: 28px;
  }

  @media (max-width: 640px) {
    .back-to-top {
      right: 20px;
      bottom: 20px;
      width: 62px;
      height: 62px;
    }

    .back-to-top svg {
      width: 25px;
      height: 25px;
    }
  }
</style>
