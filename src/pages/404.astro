---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="404 Not Found">
  <section class="section container container--narrow" style="text-align: center;">
    <PageHeading title="ページが見つかりませんでした" eyebrow="404" />
    <p style="color: var(--c-fg-muted);">
      URL が違うか、ページの場所が変更されている可能性があります。
    </p>
    <p><a href={`${base}/`}>トップへ戻る</a></p>
  </section>
</BaseLayout>
