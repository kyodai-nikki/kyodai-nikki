---
import Tabs from "../common/Tabs.astro";
import { orderedOthersSections } from "../../lib/others";
import { othersPageMsg } from "../../msg/others";

type OthersSectionSlug = "settings" | "fan-art" | "contact";

interface Props {
  currentSection: OthersSectionSlug;
}

const { currentSection } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const othersSections = await orderedOthersSections();

const items = othersSections.map((section) => ({
  label: section.data.label,
  href: `${base}${section.data.href}`,
  active: section.data.slug === currentSection,
}));
---

<Tabs items={items} ariaLabel={othersPageMsg.tabsAriaLabel} size="lg" />
