---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import { movieEmbedUrl, orderedMovies } from "../../lib/movies";
import { moviesPageMsg } from "../../msg/movies";
import { navigation } from "../../data/navigation";

const orderedVideos = await orderedMovies();
---
<BaseLayout
  title={navigation.movies.title}
  description={moviesPageMsg.meta.description}
  pageSectionClass="movies"
>
  <PageHeading slot="page-heading" title={navigation.movies.title} />

  {orderedVideos.length === 0 ? (
    <p class="movies__empty">
      {moviesPageMsg.empty.list}
    </p>
  ) : (
    <div class="movies-grid">
      {orderedVideos.map((video) => (
        <article class="movie-card">
          <div class="movie-card__frame">
            <iframe
              src={movieEmbedUrl(video)}
              title={video.data.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <h2 class="movie-card__title">{video.data.title}</h2>
        </article>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .movies {
    --movie-frame-bg: var(--c-bg);
    --movie-frame-border: var(--c-image-card-frame-border);
    --movie-title-fg: var(--c-fg);
    --movies-empty-fg: var(--c-fg-muted);
    --movies-empty-bg: var(--c-white-card-translucent-bg);
    --movies-empty-border: var(--c-border);

    padding-top: 20px;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-content: center;
    gap: 56px 22px;
    max-width: 920px;
    margin: 0 auto;
  }

  .movie-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .movie-card__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--movie-frame-bg);
    border: 1px solid var(--movie-frame-border);
  }

  .movie-card__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .movie-card__title {
    width: 100%;
    max-width: 300px;
    margin: 0;
    text-align: center;
    font-family: var(--font-family-base);
    font-size: 18px;
    line-height: 1.45;
    font-weight: var(--fw-regular);
    color: var(--movie-title-fg);
  }

  .movies__empty {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-6);
    text-align: center;
    color: var(--movies-empty-fg);
    background: var(--movies-empty-bg);
    border: 1px solid var(--movies-empty-border);
    border-radius: var(--r-md);
  }

  @media (--bp-tablet) {
    .movies-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 680px;
      gap: 30px 20px;
    }

    .movie-card__title {
      font-size: 17px;
    }
  }

  @media (--bp-mobile) {
    .movies-grid {
      grid-template-columns: 1fr;
      max-width: 300px;
    }
  }
</style>
