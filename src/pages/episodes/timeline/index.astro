---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Button from "../../../components/common/btn/Button.astro";
import PageHeading from "../../../components/common/PageHeading.astro";
import EpisodeSeasonStickyNav from "../../../components/episodes/EpisodeSeasonStickyNav.astro";
import EpisodesSeasonTabs from "../../../components/episodes/list/EpisodesSeasonTabs.astro";
import {
  seasons as getSeasons,
  groupedEpisodesTimeline,
  timelineEpisodeHref,
} from "../../../lib/episodes";
import { timelineEpisodeNumberLabel } from "../../../lib/episodes/view";
import { commonMsg } from "../../../msg/common";
import { episodesPageMsg } from "../../../msg/episodes";
import { navigation } from "../../../data/navigation";

const seasons = await getSeasons();
const grouped = await groupedEpisodesTimeline();
---
<BaseLayout title={episodesPageMsg.meta.timelineTitle} description={episodesPageMsg.meta.timelineDescription}>
  <PageHeading slot="page-heading" title={navigation.episodes.title} />
  <EpisodesSeasonTabs slot="page-tabs" current="timeline" />
  <EpisodeSeasonStickyNav seasons={seasons} />

    <div class="tl-layout">
      <aside class="tl-side" aria-label={episodesPageMsg.aria.timelineJumpNav}>
        <ol class="tl-side__list">
          {seasons.map((s) => (
            <li>
              <Button
                href={`#${s.slug}`}
                type="white"
                size="l"
                fullWidth
                data-season-sticky-link={s.slug}
              >
                {s.label}
              </Button>
            </li>
          ))}
        </ol>
      </aside>

      <div class="tl-main">
        {grouped.map(({ season, items }) => (
          <section class="tl-season" id={season.slug} aria-label={season.label}>
            <header class="tl-season__head">
              <h2>{season.label}</h2>
            </header>

            {items.length === 0 ? (
              <p class="tl-season__empty">{commonMsg.empty.episodes}</p>
            ) : (
              <ol class="tl-rows">
                {items.map((e) => {
                  const cls = ["tl-row"];
                  if (e.type !== "normal") cls.push("tl-row--alt");
                  if (e.type === "another") cls.push("tl-row--another");
                  if (e.type === "deleted") cls.push("tl-row--deleted");
                  if (e.smallText) cls.push("tl-row--sm");
                  return (
                    <li class={cls.join(" ")}>
                      <a class="tl-row__card" href={timelineEpisodeHref(e)}>
                        <span class="tl-row__no">{timelineEpisodeNumberLabel(e)}</span>
                        <span class="tl-row__title">{e.title}</span>
                      </a>
                      <span class="tl-row__rail" aria-hidden="true"></span>
                      <div class="tl-row__meta">
                        {e.date && <div class="tl-row__date">{e.date}</div>}
                        {e.cast && (
                          <div class="tl-row__cast">
                            {e.cast.map((cast) => <span>{cast}</span>)}
                          </div>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ol>
            )}
          </section>
        ))}
      </div>
    </div>
</BaseLayout>

<style>
  .tl-layout {
    --tl-divider: var(--c-border);
    --tl-main-bg: rgb(from var(--bc-white) r g b / 0.82);
    --tl-main-border: var(--c-border);
    --tl-season-bg: var(--c-site-cyan);
    --tl-season-fg: var(--c-fg-alt);
    --tl-empty-fg: var(--c-fg-muted);
    --tl-card-bg: var(--c-bg);
    --tl-card-fg: var(--c-fg);
    --tl-card-border: var(--c-border);
    --tl-rail: var(--bc-gray-strong);
    --tl-dot: var(--bc-gray);
    --tl-date-fg: var(--bc-gray-strong);
    --tl-cast-fg: var(--bc-gray-strong);
    --tl-alt-card-bg: var(--bc-black);
    --tl-alt-card-fg: var(--c-fg-alt);
    --tl-side-width: 220px;
    --tl-gap: 32px;
    display: grid;
    grid-template-columns: var(--tl-side-width) minmax(0, 1fr);
    gap: var(--tl-gap);
    align-items: start;
    max-width: 1130px;
    margin: 0 auto;
    position: relative;
  }

  .tl-layout::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--tl-side-width) + (var(--tl-gap) / 2) - 1px);
    width: 1px;
    background: var(--tl-divider);
  }

  .tl-side {
    position: sticky;
    top: calc(var(--h-header-top) + var(--h-header-nav) + var(--s-4));
    padding: 0;
  }
  .tl-side__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .tl-main {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--s-6), 4vw, var(--s-8));
    padding: clamp(var(--s-4), 3vw, var(--s-5));
    border: 1px solid var(--tl-main-border);
    border-radius: var(--r-md);
    background: var(--tl-main-bg);
  }
  .tl-season {
    scroll-margin-top: calc(var(--h-header-top) + var(--h-header-nav) + var(--s-5));
  }
  .tl-season__head {
    background: var(--tl-season-bg);
    color: var(--tl-season-fg);
    padding: var(--s-4) var(--s-5);
    margin-bottom: var(--s-5);
    border-radius: 12px;
  }
  .tl-season__head h2 {
    margin: 0;
    text-align: center;
    font-family: var(--font-family-base);
    font-size: 20px;
    font-weight: var(--fw-bold);
    color: var(--tl-season-fg);
  }
  .tl-season__empty {
    color: var(--tl-empty-fg);
    text-align: center;
    padding: var(--s-5);
  }

  .tl-rows {
    --tl-row-gap: var(--s-3);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--tl-row-gap);
  }
  .tl-row {
    display: grid;
    grid-template-columns: minmax(220px, 380px) 72px minmax(220px, 1fr);
    column-gap: 0;
    align-items: center;
    min-height: 124px;
  }

  .tl-row__card {
    grid-column: 1;
    justify-self: end;
    position: relative;
    z-index: 1;
    width: min(100%, 380px);
    min-width: 0;
    min-height: 90px;
    padding: var(--s-4) var(--s-5);
    background: var(--tl-card-bg);
    border: 1px solid var(--tl-card-border);
    border-radius: var(--r-md);
    color: var(--tl-card-fg);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--s-2);
    text-align: center;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .tl-row__card:hover,
  .tl-row__card:focus-visible {
    opacity: 0.7;
    transform: translateY(-3px);
  }

  .tl-row__no {
    font-family: var(--font-family-base);
    font-size: 16px;
    color: var(--tl-card-fg);
    letter-spacing: 0.04em;
    white-space: nowrap;
    line-height: 1;
  }
  .tl-row__title {
    font-family: var(--font-family-base);
    font-weight: var(--fw-bold);
    font-size: 20px;
    line-height: 1.25;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .tl-row__rail {
    grid-column: 2;
    display: block;
    align-self: stretch;
    justify-self: center;
    position: relative;
    width: 72px;
    z-index: 2;
  }
  .tl-row__rail::before {
    content: "";
    position: absolute;
    top: calc(var(--tl-row-gap) * -0.5);
    bottom: calc(var(--tl-row-gap) * -0.5);
    left: 50%;
    width: 4px;
    background: var(--tl-rail);
    transform: translateX(-50%);
  }
  .tl-row:first-child .tl-row__rail::before {
    top: 50%;
  }
  .tl-row:last-child .tl-row__rail::before {
    bottom: 50%;
  }
  .tl-row__rail::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 26px;
    height: 26px;
    background: var(--tl-dot);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .tl-row__meta {
    grid-column: 3;
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: var(--s-4);
    position: relative;
    z-index: 1;
  }
  .tl-row__date {
    font-family: var(--font-family-base);
    font-size: 28px;
    letter-spacing: 0.08em;
    color: var(--tl-date-fg);
    line-height: 1.1;
  }
  .tl-row__cast {
    display: flex;
    flex-wrap: wrap;
    font-family : var(--font-family-base);
    font-size: 14px;
    color: var(--tl-cast-fg);
    letter-spacing: 0.02em;
    line-height: 1.7;
  }

  .tl-row__cast span {
    display: inline;
  }

  .tl-row--alt .tl-row__card {
    grid-column: 3;
    grid-row: 1;
    justify-self: start;
    width: min(100%, 420px);
    min-height: 100px;
    background: var(--tl-alt-card-bg);
    color: var(--tl-alt-card-fg);
    border-color: var(--tl-card-border);
  }
  .tl-row--alt .tl-row__no {
    color: var(--tl-alt-card-fg);
  }
  .tl-row--alt .tl-row__title {
    color: var(--tl-alt-card-fg);
    line-height: 1.35;
    overflow-wrap: normal;
    word-break: keep-all;
  }

  .tl-row--alt .tl-row__meta {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    text-align: right;
    padding-left: 0;
    padding-right: var(--s-4);
  }
  .tl-row--alt .tl-row__rail {
    grid-column: 2;
    grid-row: 1;
  }

  .tl-row--deleted .tl-row__no {
    letter-spacing: 0.18em;
  }

  @media (--bp-laptop) {
    .tl-row {
      grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr);
    }

    .tl-row__card,
    .tl-row--alt .tl-row__card {
      width: 100%;
    }

    .tl-row__cast span:not(:first-child) {
      margin-top: var(--m-xs);
    }
  }

  @media (--bp-tablet) {
    .tl-layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: 100%;
    }

    .tl-layout::before,
    .tl-side {
      display: none;
    }

    .tl-row__cast {
      display: block;
    }

    .tl-row__cast span {
      display: block;
    }
  }

  @media (--bp-mobile) {
    .tl-row {
      grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr);
    }

    .tl-row__rail {
      width: 48px;
    }

    .tl-row__card,
    .tl-row--alt .tl-row__card {
      width: 100%;
      max-width: 100%;
      padding-inline: var(--s-3);
    }

    .tl-row--alt .tl-row__title {
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .tl-row__no {
      font-size: 14px;
    }

    .tl-row__title {
      font-size: 18px;
    }

    .tl-row__date {
      font-size: 20px;
    }

    .tl-row__cast {
      font-size: 12px;
    }
  }
</style>

<script>
  import "../../../components/episodes/list/episodesNavigator";
</script>
