---
import ShareButtons from "../../common/btn/ShareButtons.astro";
import EpisodeArrowPager from "../EpisodeArrowPager.astro";
import { episodesPageMsg } from "../../../msg/episodes";

interface Props {
  showPreviousButton: boolean;
  previousHref?: string;
  showNextButton: boolean;
  nextHref?: string;
  shareUrl: string;
  shareTitle: string;
}

const {
  showPreviousButton,
  previousHref,
  showNextButton,
  nextHref,
  shareUrl,
  shareTitle,
} = Astro.props;
---

<footer class="episode-log__footer">
  <EpisodeArrowPager
    previousHref={showPreviousButton ? previousHref : undefined}
    nextHref={showNextButton ? nextHref : undefined}
    ariaLabel={episodesPageMsg.aria.logNavigation}
  >
    <ShareButtons
      url={shareUrl}
      title={shareTitle}
      variant="log"
    />
  </EpisodeArrowPager>
</footer>

<style>
  .episode-log__footer {
    --episode-arrow-pager-width: 50%;
    --episode-arrow-pager-margin: 0 auto;

    width: 100%;
    padding-top: 6px;
  }

  @media (--bp-laptop) {
    .episode-log__footer {
      --episode-arrow-pager-width: 65%;
    }
  }

  @media (--bp-tablet) {
    .episode-log__footer {
      --episode-arrow-pager-gap: 22px;
      --episode-arrow-pager-width: 80%;
    }
  }
</style>
