---
import { charactersPageMsg } from "../../msg/characters";
import { commonMsg } from "../../msg/common";

interface Props {
  links: ReadonlyArray<{ label: string; url: string }>;
}

const { links } = Astro.props;
---

{links.length > 0 && (
  <dl class="character-external-links">
    <p class="character-external-links__header">
      {commonMsg.symbols.externalMarker} {charactersPageMsg.labels.externalStatusLink}
    </p>
    <div class="character-external-links__box">
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener">
          {commonMsg.symbols.separatorDot} {link.label || charactersPageMsg.labels.externalStatusLink}
        </a>
      ))}
    </div>
  </dl>
)}

<style>
  .character-external-links {
    --character-external-links-fg: var(--c-character-external-links-fg);
    --character-external-links-heading-fg: var(--c-character-external-links-heading-fg);
    --character-external-links-link-fg: var(--c-character-external-links-link-fg);

    font-family: var(--font-family-base);
    font-size: 16px;
    color: var(--character-external-links-fg);
    margin: 0;
  }

  .character-external-links__header {
    margin: 0;
    margin-bottom: 5px;
    font-weight: 700;
    font-family: var(--font-family-base);
    font-size: 16px;
    color: var(--character-external-links-heading-fg);
  }

  .character-external-links__box {
    display: grid;
  }

  .character-external-links__box a {
    width: fit-content;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    color: var(--character-external-links-link-fg);
    line-height: var(--lh-s-tight);
  }

  @media (--bp-mobile) {
    .character-external-links,
    .character-external-links__header {
      font-size: 10px;
    }
  }
</style>
