---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { images } from "../../data/gallery";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Gallery" description="スチル・挿絵などのギャラリー。">
  <section class="section container">
    <header class="stack-sm section-head">
      <p class="card__eyebrow">Gallery</p>
      <h1>ギャラリー</h1>
    </header>

    {images.length === 0 ? (
      <p style="color: var(--c-fg-muted);">
        画像を追加するには <code>public/images/gallery/</code> にファイルを置き、
        <code>src/data/gallery.ts</code> の <code>images</code> 配列に記入してください。
      </p>
    ) : (
      <div class="card-grid" style="--min: 220px;">
        {images.map((img) => (
          <figure style="margin: 0; background: var(--c-bg-elev); border: 1px solid var(--c-border); border-radius: var(--r-md); overflow: hidden;">
            <img src={base + img.src} alt={img.alt} loading="lazy" style="width: 100%; aspect-ratio: 4 / 3; object-fit: cover;" />
            {img.caption && (
              <figcaption style="padding: var(--s-3); font-size: var(--fs-sm); color: var(--c-fg-muted);">
                {img.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
