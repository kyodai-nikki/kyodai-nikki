---
import { commonMsg } from "../../msg/common";
import Icon, { IconName } from "./Icon.astro";
---
<a href="#top" class="back-to-top" aria-label={commonMsg.accessibility.backToTop}>
  <Icon name={IconName.ChevronUp} size={28} />
</a>

<style>
  .back-to-top {
    --back-to-top-bg: var(--c-back-to-top-bg);
    --back-to-top-fg: var(--c-back-to-top-fg);

    position: fixed;
    left: calc(100vw - 28px - 68px);
    bottom: 28px;
    width: 68px;
    height: 68px;
    border-radius: 9999px;
    background: var(--back-to-top-bg);
    color: var(--back-to-top-fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-out);
    z-index: 20;
  }

  .back-to-top[data-visible="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .back-to-top svg {
    width: 28px;
    height: 28px;
  }

  @media (--bp-tablet) {
    .back-to-top {
      left: calc(100vw - 20px - 62px);
      bottom: 20px;
      width: 62px;
      height: 62px;
      z-index: var(--z-back-to-top);
    }

    .back-to-top svg {
      width: 25px;
      height: 25px;
    }
  }
</style>

<script>
  import { siteConfig } from "../../config";
  import { onPageLoad } from "../../scripts/onPageLoad";

  const updateBackToTop = () => {
    const toTop = document.querySelector(".back-to-top");
    if (toTop instanceof HTMLAnchorElement) {
      toTop.dataset.visible = (window.scrollY > siteConfig.showThresholdBackToTop).toString();
    }
  };

  onPageLoad("back-to-top", ({ signal }) => {
    const toTop = document.querySelector(".back-to-top");
    if (!(toTop instanceof HTMLAnchorElement)) return;

    updateBackToTop();
    window.addEventListener("scroll", updateBackToTop, { passive: true, signal });

    toTop.addEventListener("click", (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }, { signal });
  });
</script>
