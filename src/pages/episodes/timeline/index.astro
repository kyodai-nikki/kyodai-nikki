---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeading from "../../../components/common/PageHeading.astro";
import {
  seasons,
  episodesTimeline,
  timelineEpisodeHref,
  type TimelineEntry,
} from "../../../data/episodes";
import { commonMsg } from "../../../msg/common";
import { episodesPageMsg } from "../../../msg/pages/episodes";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const timeline = episodesTimeline();

const numberLabel = (e: TimelineEntry) =>
  e.isAlternate
    ? "…"
    : `Episode${String(e.seasonEpisodeNumber ?? "").padStart(2, "0")}`;

const grouped = seasons.map((s) => ({
  season: s,
  items: timeline.filter((e) => e.season === s.number),
}));
---
<BaseLayout title={episodesPageMsg.timelinePageTitle} description={episodesPageMsg.timelineDescription}>
  <section class="section container">
    <PageHeading title={episodesPageMsg.title} />

    <nav class="ep-seasons" aria-label={episodesPageMsg.timelineSeasonNav}>
      {seasons.map((s) => (
        <a href={`${base}/episodes/${s.slug}`}>{s.label}</a>
      ))}
      <a href={`${base}/episodes/timeline`} aria-current="page">{episodesPageMsg.seasonTimelineLabel}</a>
    </nav>

    <div class="tl-layout">
      <aside class="tl-side" aria-label={episodesPageMsg.timelineJumpNav}>
        <ol class="tl-side__list">
          {seasons.map((s) => (
            <li>
              <a class="tl-side__btn" href={`#${s.slug}`}>{s.label}</a>
            </li>
          ))}
        </ol>
      </aside>

      <div class="tl-main">
        {grouped.map(({ season, items }) => (
          <section class="tl-season" id={season.slug} aria-label={season.label}>
            <header class="tl-season__head">
              <h2>{season.label}</h2>
            </header>

            {items.length === 0 ? (
              <p class="tl-season__empty">{commonMsg.states.noEpisodes}</p>
            ) : (
              <ol class="tl-rows">
                {items.map((e) => {
                  const cls = ["tl-row"];
                  if (e.isAlternate) cls.push("tl-row--alt");
                  if (e.smallText) cls.push("tl-row--sm");
                  return (
                    <li class={cls.join(" ")}>
                      <a class="tl-row__card" href={base + timelineEpisodeHref(e)}>
                        <span class="tl-row__no">{numberLabel(e)}</span>
                        <span class="tl-row__title">{e.title}</span>
                        {e.isAlternate && <span class="tl-row__tag">{episodesPageMsg.alternateTag}</span>}
                      </a>
                      <div class="tl-row__meta">
                        {e.date && <div class="tl-row__date">{e.date}</div>}
                        {e.cast && <div class="tl-row__cast">{e.cast}</div>}
                      </div>
                    </li>
                  );
                })}
              </ol>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ep-seasons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(var(--s-5), 5vw, var(--s-8));
    margin-bottom: 30px;
    padding-bottom: var(--s-3);
  }
  .ep-seasons a {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: var(--c-fg);
    text-decoration: none;
    letter-spacing: var(--ls-wide);
    padding: var(--s-2) 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ep-seasons a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -3px;
    height: 2px;
    background: var(--c-site-cyan);
    transition: left var(--dur-base) var(--ease-out),
                right var(--dur-base) var(--ease-out);
    pointer-events: none;
  }
  .ep-seasons a:hover::after,
  .ep-seasons a:focus-visible::after {
    left: 0;
    right: 0;
  }
  .ep-seasons a[aria-current="page"]::after {
    left: 0;
    right: 0;
    background: var(--c-site-pink);
    transition: none;
  }

  .tl-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(var(--s-4), 4vw, var(--s-7));
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  .tl-side {
    position: sticky;
    top: var(--s-5);
  }
  .tl-side__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .tl-side__btn {
    display: block;
    padding: var(--s-3) var(--s-4);
    background: #ffffff;
    border: 1px solid var(--c-border);
    color: var(--c-fg);
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-wide);
    text-decoration: none;
    text-align: center;
    transition: background var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .tl-side__btn:hover,
  .tl-side__btn:focus-visible {
    background: var(--c-bg-muted);
    border-color: var(--c-border-strong);
  }

  .tl-main {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }
  .tl-season {
    scroll-margin-top: var(--s-5);
  }
  .tl-season__head {
    background: var(--c-site-cyan);
    color: #ffffff;
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-5);
  }
  .tl-season__head h2 {
    margin: 0;
    text-align: center;
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
  }
  .tl-season__empty {
    color: var(--c-fg-muted);
    text-align: center;
    padding: var(--s-5);
  }

  .tl-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .tl-rows::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--c-border);
    transform: translateX(-0.5px);
  }
  .tl-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--s-5);
    align-items: center;
    padding: var(--s-3) 0;
    min-height: 76px;
  }

  .tl-row::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    background: #ffffff;
    border: 2px solid var(--c-fg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .tl-row__card {
    grid-column: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 100%;
    padding: var(--s-3) var(--s-4);
    background: #ffffff;
    border: 1px solid var(--c-border);
    color: var(--c-fg);
    text-decoration: none;
    font-family: var(--f-serif);
    transition: background var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .tl-row__card:hover,
  .tl-row__card:focus-visible {
    background: var(--c-bg-muted);
    border-color: var(--c-border-strong);
  }
  .tl-row__no {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    white-space: nowrap;
  }
  .tl-row__title {
    font-size: var(--fs-base);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tl-row--sm .tl-row__title { font-size: var(--fs-sm); }
  .tl-row__tag {
    display: none;
  }

  .tl-row__meta {
    grid-column: 2;
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: var(--s-3);
  }
  .tl-row__date {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    letter-spacing: var(--ls-wide);
    color: var(--c-fg);
  }
  .tl-row__cast {
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    line-height: 1.6;
  }

  .tl-row--alt .tl-row__card {
    grid-column: 2;
    grid-row: 1;
    justify-self: start;
    background: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4);
    min-width: 220px;
  }
  .tl-row--alt .tl-row__card:hover {
    background: #2c2c2c;
    border-color: #2c2c2c;
  }
  .tl-row--alt .tl-row__no { display: none; }
  .tl-row--alt .tl-row__tag {
    display: inline-block;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: var(--ls-wide);
    color: #cccccc;
    text-transform: uppercase;
  }
  .tl-row--alt .tl-row__title {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: #ffffff;
  }

  .tl-row--alt .tl-row__meta {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    text-align: right;
    padding-left: 0;
    padding-right: var(--s-3);
  }

  @media (max-width: 880px) {
    .tl-layout {
      grid-template-columns: 1fr;
    }
    .tl-side {
      position: static;
    }
    .tl-side__list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
    .tl-side__btn {
      padding: var(--s-2) var(--s-3);
      font-size: var(--fs-xs);
    }
  }
  @media (max-width: 640px) {
    .tl-rows::before { display: none; }
    .tl-row,
    .tl-row--alt {
      grid-template-columns: 1fr;
      row-gap: var(--s-2);
    }
    .tl-row::after { display: none; }
    .tl-row__card,
    .tl-row--alt .tl-row__card {
      grid-column: 1;
      grid-row: auto;
      justify-self: stretch;
    }
    .tl-row__meta,
    .tl-row--alt .tl-row__meta {
      grid-column: 1;
      grid-row: auto;
      justify-self: stretch;
      text-align: left;
      padding: 0;
    }
  }
</style>
