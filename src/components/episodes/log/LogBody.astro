---
interface RenderedSection {
  section: {
    key: string;
    label: string;
    anchor: string;
  };
  Content: any;
}

interface Props {
  renderedSections: RenderedSection[];
}

const { renderedSections } = Astro.props;
---

<article class="log prose episode-log__body">
  {renderedSections.map(({ section, Content }) => (
    <section class="episode-log__content-section" id={section.anchor}>
      <div class="episode-log__content-head">
        <h3>{section.label}</h3>
      </div>
      <Content />
    </section>
  ))}
</article>

<style>
  .episode-log__body {
    --log-page-fg: var(--c-log-fg);
    --log-body-fg: var(--c-log-body-fg);
    --log-heading-fg: var(--c-log-heading-fg);
    --log-quote-border: var(--c-log-quote-border);
    --log-quote-fg: var(--c-log-quote-fg);
    --log-rule: var(--c-log-rule);

    display: grid;
    gap: 40px;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    color: var(--log-page-fg);
    font-size: 1.02rem;
    line-height: 1.86;
    font-family: var(--font-family-log-body);
  }

  .episode-log__content-section {
    scroll-margin-top: calc(
      var(--h-header-top) + var(--h-header-nav) + var(--s-5) + var(--s-4)
    );
  }

  .episode-log__content-head {
    margin-bottom: 14px;
  }

  .episode-log__content-head h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-family-log-heading);
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
  }

  .episode-log__content-head h3::before {
    content: "▼";
    font-size: 0.95em;
    line-height: 1;
  }

  .episode-log__content-section :global(p) {
    margin-bottom: 0.75em;
    font-family: var(--font-family-log-body);
    white-space: pre-line;
    font-size: var(--fs-base);
    line-height: var(--lh-log);
  }

  .episode-log__content-section :global(ul) {
    margin: 0;
    padding-left: 1.25em;
    font-family: var(--font-family-log-body);
  }

  .episode-log__content-section :global(li + li) {
    margin-top: 0.35em;
  }

  .log {
    margin-inline: auto;
    line-height: var(--lh-loose);
    font-size: var(--fs-m);
    color: var(--log-body-fg);
  }

  .log :where(h2, h3) {
    margin-top: var(--s-8);
    color: var(--log-heading-fg);
  }

  .log :where(h2):first-child {
    margin-top: 0;
  }

  .log blockquote {
    border-left: 2px solid var(--log-quote-border);
    margin: var(--s-5) 0;
    padding: var(--s-2) var(--s-5);
    color: var(--log-quote-fg);
    font-style: italic;
  }

  .log hr {
    border: 0;
    border-top: 1px solid var(--log-rule);
    margin: var(--s-7) 0;
  }

  @media (--bp-tablet) {
    .episode-log__content-head h3 {
      font-size: var(--fs-lg);
    }

    .log {
      font-size: var(--fs-base);
    }
  }
</style>
