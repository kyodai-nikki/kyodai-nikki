---
import Tabs from "../common/Tabs.astro";
import type { CharacterEntry } from "../../lib/characters";
import { characterTabItems } from "../../lib/view/characters";
import { charactersPageMsg } from "../../msg/characters";

interface Props {
  characters: CharacterEntry[];
  currentId: string;
}

const { characters, currentId } = Astro.props as Props;
const items = characterTabItems(characters, currentId);
---

<Tabs items={items} ariaLabel={charactersPageMsg.aria.tabs} size="md" />
