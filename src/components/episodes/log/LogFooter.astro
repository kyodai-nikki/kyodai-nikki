---
import ShareButtons from "../../common/btn/ShareButtons.astro";
import Icon, { IconName } from "../../common/Icon.astro";
import { episodesPageMsg } from "../../../msg/episodes";

interface Props {
  showPreviousButton: boolean;
  previousHref?: string;
  showNextButton: boolean;
  nextHref?: string;
  shareUrl: string;
  shareTitle: string;
}

const {
  showPreviousButton,
  previousHref,
  showNextButton,
  nextHref,
  shareUrl,
  shareTitle,
} = Astro.props;
---

<footer class="episode-log__footer">
  <div class="episode-log__footer-nav">
    {showPreviousButton && previousHref ? (
      <a class="episode-log__arrow" href={previousHref} aria-label={episodesPageMsg.previousEpisodeMove}>
        <Icon name={IconName.KeyboardArrowLeft} size={28} />
      </a>
    ) : (
      <span class="episode-log__arrow episode-log__arrow--spacer" aria-hidden="true"></span>
    )}

    <ShareButtons
      url={shareUrl}
      title={shareTitle}
      className="episode-log__share-buttons"
    />

    {showNextButton && nextHref ? (
      <a class="episode-log__arrow" href={nextHref} aria-label={episodesPageMsg.nextEpisodeMove}>
        <Icon name={IconName.KeyboardArrowRight} size={28} />
      </a>
    ) : (
      <span class="episode-log__arrow episode-log__arrow--spacer" aria-hidden="true"></span>
    )}
  </div>
</footer>

<style>
  .episode-log__footer {
    display: grid;
    justify-content: center;
    padding-top: 6px;
  }

  .episode-log__footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 38px;
    width: 100%;
  }

  .episode-log__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--c-log-arrow-fg);
    font-family: var(--font-family-log-heading);
    font-size: 2.5rem;
    line-height: 1;
  }

  .episode-log__arrow:hover {
    color: var(--c-log-arrow-fg-hover);
  }

  .episode-log__arrow--spacer {
    visibility: hidden;
  }

  /* ShareButton の CSS 変数 API を使ってカスタマイズする
     （:global で内部要素を直接いじらないことで疎結合を維持） */
  .episode-log__footer :global(.episode-log__share-buttons) {
    --share-btn-size: 30px;
    --share-line-icon-size: 28px;
    --share-buttons-gap: 18px;
    --share-btn-bg: var(--c-share-btn-bg-on-log);
    --share-btn-hover-bg: var(--c-share-btn-bg-on-log-hover);
    --share-btn-hover-transform: none;
  }

  @media (--bp-tablet) {
    .episode-log__footer-nav {
      gap: 22px;
    }
  }
</style>
