{
  "name": "kyodai-nikki",
  "type": "module",
  "version": "0.1.0",
  "description": "TRPG session log archive built with Astro",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "prebuild": "npm run replace-br && npm run optimize-gallery",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "replace-br": "node scripts/replace-br.mjs",
    "replace-br:dry": "node scripts/replace-br.mjs --dry-run",
    "optimize-gallery": "node scripts/optimize-gallery.mjs"
  },
  "dependencies": {
    "astro": "^5.18.1",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.53.0",
    "eslint-plugin-astro": "^1.5.0",
    "sharp": "^0.33.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
