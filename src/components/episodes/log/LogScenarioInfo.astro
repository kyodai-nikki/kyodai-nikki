---
import type { EpisodeScenarioInfo } from "../../../lib/episodes/logs";
import { commonMsg } from "../../../msg/common";
import { episodesPageMsg } from "../../../msg/episodes";
import BadgeList from "../../common/BadgeList.astro";

interface Props {
  title: string;
  episodeNumberLabel: string;
  badges: string[];
  scenario?: EpisodeScenarioInfo;
  showSmallTitle?: boolean;
}

const { title, episodeNumberLabel, badges, scenario, showSmallTitle = false } = Astro.props;
const castLabel = scenario?.cast?.length ? scenario.cast.join(commonMsg.symbols.separatorDot) : undefined;
const writerLabel = scenario?.author;
const sourceLabel = scenario?.distributionName;
---

<header class="episode-log__panel-head">
  <div class="episode-log__title-row">
    <div class="episode-log__title-group">
      <h2 class:list={["episode-log__title", { "episode-log__title--small": showSmallTitle }]}>{title}</h2>
      <p class="episode-log__episode-no">{episodeNumberLabel}</p>
    </div>
    <BadgeList badges={badges} />
  </div>

  <dl class="episode-log__meta-lines">
    {(scenario?.storyDate || castLabel) && (
      <div class="episode-log__meta-line">
        {scenario?.storyDate && (
          <div class="episode-log__meta-inline">
            <dt>{episodesPageMsg.scenario.storyDate}</dt>
            <dd>{scenario.storyDate}</dd>
          </div>
        )}
        {castLabel && <dd class="episode-log__meta-free">{castLabel}</dd>}
      </div>
    )}

    {(writerLabel || sourceLabel || scenario?.adaptedScenarioUrl) && (
      <div class="episode-log__meta-line">
        {writerLabel && (
          <div class="episode-log__meta-inline">
            <dt>{episodesPageMsg.scenario.author}</dt>
            <dd>{writerLabel}{commonMsg.honorifics.polite}</dd>
          </div>
        )}
        {sourceLabel && (
          <div class="episode-log__meta-inline">
            <dt>{episodesPageMsg.scenario.distribution}</dt>
            <dd>
              {scenario?.distributionUrl ? (
                <a href={scenario.distributionUrl} target="_blank" rel="noopener">
                  {sourceLabel}
                </a>
              ) : (
                sourceLabel
              )}
            </dd>
          </div>
        )}
        {scenario?.adaptedScenarioUrl && (
          <div class="episode-log__meta-inline">
            <dt>{episodesPageMsg.scenario.adapted}</dt>
            <dd>
              <a href={scenario.adaptedScenarioUrl} target="_blank" rel="noopener">
                {episodesPageMsg.scenario.adaptedLink}
              </a>
            </dd>
          </div>
        )}
      </div>
    )}
  </dl>
</header>

<style>
  .episode-log__panel-head {
    --log-scenario-divider: var(--c-log-divider-strong);
    --log-scenario-meta-fg: var(--c-log-meta-fg);
    --log-scenario-link-fg: var(--c-log-heading-fg);

    margin-bottom: 30px;
  }

  .episode-log__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--log-scenario-divider);
  }

  .episode-log__title-group {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
    font-weight: var(--fw-bold);
  }

  .episode-log__title {
    margin: 0;
    font-family: var(--font-family-log-heading);
    font-size: 32px;
    font-weight: var(--fw-bold);
    line-height: 1.15;
  }

  .episode-log__title--small {
    font-size: 28px;
  }

  .episode-log__episode-no {
    margin: 0;
    font-family: var(--font-family-log-heading);
    font-size: var(--fs-xl2);
    color: var(--log-scenario-meta-fg);
  }

  .episode-log__meta-lines {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .episode-log__meta-line {
    display: flex;
    align-items: baseline;
    gap: 30px;
    padding: 6px 0;
    border-bottom: 1px solid var(--log-scenario-divider);
    font-family: var(--font-family-log-body);
    line-height: 1.5;
  }

  .episode-log__meta-inline {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .episode-log__meta-line dt,
  .episode-log__meta-line dd,
  .episode-log__meta-inline dt,
  .episode-log__meta-inline dd,
  .episode-log__meta-free {
    margin: 0;
    color: var(--log-scenario-link-fg);
    line-height: var(--lh-s-tight);
  }

  .episode-log__meta-line a {
    --log-scenario-link-hover-fg: rgb(from var(--log-scenario-link-fg) r g b / 0.7);

    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: currentColor;
    transition:
      color var(--dur-base) var(--ease-out),
      text-decoration-color var(--dur-base) var(--ease-out);
  }

  .episode-log__meta-line a:hover,
  .episode-log__meta-line a:focus-visible {
    color: var(--log-scenario-link-hover-fg);
    text-decoration-color: var(--log-scenario-link-hover-fg);
  }

  @media (--bp-tablet) {
    .episode-log__title-group {
      gap: 8px;
    }

    .episode-log__title {
      font-size: var(--fs-xl3);
    }

    .episode-log__episode-no {
      font-size: var(--fs-m);
    }

    .episode-log__meta-line {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
</style>
