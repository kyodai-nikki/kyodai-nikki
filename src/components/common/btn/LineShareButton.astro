---
import { common } from "../../../msg/common";
import { withBase } from "../../../lib/urls";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  class="share-button share-button--line"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={common.social.shareLine}
>
  <img src={withBase("/images/icons/line.png")} alt="" aria-hidden="true" />
</a>

<style>
  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--share-btn-size);
    height: var(--share-btn-size);
    border-radius: var(--share-btn-radius, 4px);
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-out),
                opacity var(--dur-fast) var(--ease-out);
  }

  .share-button:hover {
    transform: var(--share-btn-hover-transform, translateY(-1px));
    opacity: 0.8;
  }

  .share-button img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
