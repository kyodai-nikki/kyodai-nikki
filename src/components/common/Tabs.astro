---
export interface TabItem {
  /** 表示ラベル */
  label: string;
  /** 遷移先 URL（base 込みの完成形を渡す） */
  href: string;
  /** 現在ページならtrue。aria-current="page" になる */
  active?: boolean;
}

interface Props {
  /** タブの並び。渡された順に左から表示する */
  items: TabItem[];
  /** <nav> の aria-label。スクリーンリーダー用 */
  ariaLabel: string;
  /** サイズ。md = Episodes 系（小さめ）、lg = Others 系（大きめ） */
  size?: "md" | "lg";
}

const { items, ariaLabel, size = "md" } = Astro.props;
---

<nav class:list={["tab-nav", `tab-nav--${size}`]} aria-label={ariaLabel}>
  <div class="tab-nav__list">
    {items.map((item) => (
      <a href={item.href} aria-current={item.active ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .tab-nav {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .tab-nav__list {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 60px;
    min-width: 100%;
    width: max-content;
  }

  .tab-nav a {
    flex: 0 0 auto;
    font-weight: 600;
    position: relative;
    color: var(--c-fg);
    font-family: var(--font-family-navigation);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tab-nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -2px;
    height: 2px;
    transition:
      left var(--dur-base) var(--ease-out),
      right var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .tab-nav a:hover::after,
  .tab-nav a:focus-visible::after {
    left: -4px;
    right: -4px;
    border: 2px solid var(--c-site-cyan);
  }

  .tab-nav a[aria-current="page"]::after {
    left: -4px;
    right: -4px;
    border: 2px solid var(--c-site-pink);
    transition: none;
  }

  /* ---- size: md（Episodes 系） */
  .tab-nav--md {
    padding-bottom: var(--s-3);
  }

  .tab-nav--md a {
    font-size: 24px;
    letter-spacing: var(--ls-wide);
  }

  .tab-nav--md a::after {
    bottom: -3px;
  }

  /* ---- size: lg（Others 系） */
  .tab-nav--lg {
    margin: 20px 0 0;
    padding-bottom: 8px;
  }

  .tab-nav--lg a {
    font-size: 24px;
    padding: 6px 0;
  }

  @media (--bp-tablet) {
    .tab-nav__list {
      gap: 20px;
    }

    .tab-nav--md a,
    .tab-nav--lg a {
      font-size: 18px;
    }
  }

  @media (--bp-mobile) {
    .tab-nav__list {
      gap: 20px;
    }
  }
</style>
