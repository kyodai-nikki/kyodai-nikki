---
import { ClientRouter } from "astro:transitions";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import BackToTop from "../components/common/BackToTop.astro";
import EpisodeSpoilerNotice from "../components/episodes/EpisodeSpoilerNoticeModal.astro";
import { commonMsg } from "../msg/common";
import { siteConfig } from "../config";
import { withBase } from "../lib/urls";

import "../../styles/variables.css";
import "../../styles/initial.css";
import "../../styles/globals.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  pageSectionClass?: string;
  pageContainerClass?: string;
}

const {
  title,
  description = commonMsg.site.defaultDescription,
  ogImage = withBase("/logo.png"),
  bodyClass = "",
  pageSectionClass = "",
  pageContainerClass = "",
} = Astro.props;

const siteName = siteConfig.name;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost");
const episodesPath = withBase("/episodes");
const pageShellBgImage = `url("${withBase("/images/bg.png")}")`;
const showEpisodeSpoilerNotice =
  Astro.url.pathname === episodesPath || Astro.url.pathname.startsWith(`${episodesPath}/`);
const episodesSubPath = showEpisodeSpoilerNotice
  ? Astro.url.pathname.slice(episodesPath.length)
  : "";
const episodeSpoilerNoticeKind = /^\/[^/]+\/[^/]+\/log\/?$/.test(episodesSubPath)
  ? "log"
  : "default";
const hasPageTabs = Astro.slots.has("page-tabs");
const hasPageShell =
  Astro.slots.has("page-heading")
  || hasPageTabs
  || pageSectionClass.length > 0
  || pageContainerClass.length > 0;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonical).href} />
    <meta name="x:card" content="summary_large_image" />
    <link href="https://fonts.googleapis.com/css?display=swap&amp;family=Libre+Baskerville%3A400" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?display=swap&amp;family=Shippori+Mincho%3A700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?display=swap&amp;family=Shippori+Mincho%3A400" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?display=swap&amp;family=Shippori+Mincho%3A600" rel="stylesheet">
  </head>
  <body class={bodyClass}>
    <a href="#main" class="visually-hidden">{commonMsg.accessibility.skipToMain}</a>
    <Header />
    <main
      id="main"
      data-page-shell
      style={`--page-shell-bg-image: ${pageShellBgImage};`}
    >
      {hasPageShell ? (
        <section class:list={["section", pageSectionClass]}>
          <div class:list={["container", pageContainerClass]}>
            <slot name="page-heading" />
            {hasPageTabs && (
              <div class="page-shell__tabs">
                <slot name="page-tabs" />
              </div>
            )}
            <slot />
          </div>
        </section>
      ) : (
        <slot />
      )}
    </main>
    {showEpisodeSpoilerNotice && (
      <EpisodeSpoilerNotice topHref={withBase("/")} noticeKind={episodeSpoilerNoticeKind} />
    )}
    <Footer shareUrl={canonical.href} shareTitle={fullTitle} />
    <BackToTop />

  </body>
</html>
