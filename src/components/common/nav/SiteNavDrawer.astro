---
import type { HeaderNavItem } from "../../../lib/view/navigation";
import NavDrawer from "./NavDrawer.astro";

interface Props {
  id: string;
  ariaLabel: string;
  openLabel: string;
  closeLabel: string;
  items: HeaderNavItem[];
  xHref?: string;
  class?: string;
}

const {
  id,
  ariaLabel,
  openLabel,
  closeLabel,
  items,
  xHref,
  class: className = "",
} = Astro.props as Props;
---

<div class:list={["site-nav-shell", "container", className]}>
  <NavDrawer
    id={id}
    ariaLabel={ariaLabel}
    openLabel={openLabel}
    closeLabel={closeLabel}
    activation="laptop"
  >
    <div class="site-nav__list">
      {items.map((item) => (
        <a
          class="site-nav__link"
          href={item.href}
          aria-current={item.current ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      {xHref && (
        <a class="site-nav__social-link" href={xHref} target="_blank" rel="noopener">
          X
        </a>
      )}
    </div>
  </NavDrawer>
</div>

<style>
  .site-nav-shell {
    --site-nav-mobile-link-fg: var(--c-nav-drawer-fg);
    --site-nav-mobile-text-shadow: var(--c-nav-text-shadow);

    padding: 0;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--s-7);
    flex-wrap: wrap;
    justify-content: center;
  }

  .site-nav__link,
  .site-nav__social-link {
    --site-nav-link-fg: var(--c-nav-link);
    --site-nav-link-hover: var(--c-nav-link-hover, var(--c-site-cyan));
    --site-nav-link-active: var(--c-nav-link-active);

    display: inline-block;
    color: var(--site-nav-link-fg);
    text-decoration: none;
    font-family: var(--font-family-navigation);
    font-size: 24px;
    font-weight: var(--fw-regular);
    letter-spacing: 0;
    padding: var(--s-2) 0;
    position: relative;
    transition: color var(--dur-base) var(--ease-out);
  }

  .site-nav__link[aria-current="page"],
  .site-nav__social-link[aria-current="page"] {
    color: var(--site-nav-link-active);
  }

  a.site-nav__link:hover,
  .site-nav__social-link:hover {
    color: var(--site-nav-link-hover);
  }

  .site-nav__social-link {
    display: none;
  }

  @media (--bp-laptop) {
    .site-nav-shell {
      --nav-drawer-width: 68%;
      --nav-drawer-panel-padding: 132px var(--s-7) 56px;
      --nav-drawer-panel-z: var(--z-nav-drawer-panel);
      --nav-drawer-backdrop-z: var(--z-nav-drawer-backdrop);
      max-width: none;
      padding: 0;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 30px;
    }

    .site-nav__link,
    .site-nav__social-link {
      width: min(100%, 340px);
      padding: 0;
      border-bottom: 0;
      color: var(--site-nav-mobile-link-fg);
      font-size: 34px;
    font-weight: var(--fw-regular);
      line-height: 1.45;
      text-align: center;
      text-shadow: 0 1px 0 var(--site-nav-mobile-text-shadow);
    }

    .site-nav__link[aria-current="page"],
    .site-nav__social-link[aria-current="page"] {
      color: var(--site-nav-link-active);
    }

    a.site-nav__link:hover,
    .site-nav__social-link:hover {
      color: var(--site-nav-link-hover);
    }

    .site-nav__social-link {
      display: inline-block;
    }
  }

  @media (--bp-tablet) {
    .site-nav-shell {
      --nav-drawer-width: 60%;
      --nav-drawer-panel-padding: 151px var(--s-7) 56px;
    }

    .site-nav__list {
      gap: 25px;
    }

    .site-nav__link,
    .site-nav__social-link {
      width: min(100%, 280px);
      font-size: 22px;
    }
  }

  @media (--bp-mobile) {
    .site-nav-shell {
      --nav-drawer-panel-padding: 147px var(--s-7) 56px;
    }

    .site-nav__list {
      gap: var(--s-5);
    }

    .site-nav__link,
    .site-nav__social-link {
      font-size: 21px;
    }
  }
</style>
