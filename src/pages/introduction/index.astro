---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import WhiteCard from "../../components/common/WhiteCard.astro";
import { introductionPageMsg } from "../../msg/introduction";
import { navigation } from "../../data/navigation";
import Content from "../../content/introduction.md";
---
<BaseLayout
  title={navigation.introduction.title}
  description={introductionPageMsg.meta.description}
>
  <PageHeading slot="page-heading" title={navigation.introduction.title} />

  <WhiteCard class="intro-box">
    <Content />
  </WhiteCard>
</BaseLayout>

<style>
  .intro-box {
    max-width: 880px;
    margin: 0 auto;
    font-family: var(--font-family-base);
    color: var(--c-fg-body);
    font-size: 18px;
  }

  .intro-box :global(p) {
    margin: 0 0 1.6em;
    white-space: pre-wrap;
    line-height: var(--lh-s-tight);
  }
  .intro-box :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (--bp-tablet) {
    .intro-box { font-size: 18px; }
  }

  @media (--bp-mobile) {
    .intro-box { font-size: 16px; }
  }
</style>
