---
import { commonMsg } from "../../../msg/common";
import { withBase } from "../../../lib/urls";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  class="share-button"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={commonMsg.social.shareLine}
>
  <img src={withBase("/images/icons/line.png")} alt="" aria-hidden="true" />
</a>

<style>
  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--share-btn-size);
    height: var(--share-btn-size);
    border-radius: var(--share-btn-radius, 4px);
    overflow: hidden;
    transform: scale(1);
    transition: transform var(--dur-base) var(--ease-button);
  }

  .share-button:hover,
  .share-button:focus-visible {
    transform: scale(var(--share-btn-hover-scale, 1.14));
  }

  .share-button img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
