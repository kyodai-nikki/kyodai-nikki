---
import { commonMsg } from "../../../msg/common";
import Icon, { IconName } from "../Icon.astro";

interface Props {
  href: string;
  iconSize?: number | string;
}

const { href, iconSize } = Astro.props;
---

<a
  class="share-button"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={commonMsg.social.shareX}
>
  <Icon name={IconName.X} size={iconSize} />
</a>

<style>
  .share-button {
    --share-btn-bg: var(--c-share-btn-bg);
    --share-btn-fg: var(--c-share-btn-fg);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--share-btn-size);
    height: var(--share-btn-size);
    border-radius: var(--share-btn-radius, 25%);
    overflow: hidden;
    background: var(--share-btn-bg);
    color: var(--share-btn-color, var(--share-btn-fg));
    transform: scale(1);
    transition: transform var(--dur-base) var(--ease-button);
  }

  .share-button:hover,
  .share-button:focus-visible {
    transform: scale(var(--share-btn-hover-scale, 1.14));
  }

  .share-button :global(svg) {
    width: var(--share-icon-size, 50%);
    height: var(--share-icon-size, 50%);
    display: block;
  }
</style>
