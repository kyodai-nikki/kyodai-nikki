---
import Redirect from "../../../components/common/Redirect.astro";
import {
  seasons as getSeasons,
  firstEpisodeOfSeason,
  episodeHref,
  type SeasonInfo,
} from "../../../lib/episodes";
import { episodeSeasonStaticPaths } from "../../../lib/routes/episodes";
import { withBase } from "../../../lib/urls";
import { navigation } from "../../../data/navigation";

export async function getStaticPaths() {
  return await episodeSeasonStaticPaths();
}

interface Props {
  seasonNumber: SeasonInfo["number"];
}

const { seasonNumber } = Astro.props as Props;
const seasons = await getSeasons();
const seasonInfo = seasons.find((s) => s.number === seasonNumber)!;
const initial = await firstEpisodeOfSeason(seasonNumber);
const redirectTo = initial ? episodeHref(seasonInfo.slug, initial) : withBase("/episodes");
---

<Redirect
  title={`${seasonInfo.label} | ${navigation.episodes.title}`}
  redirectTo={redirectTo}
/>
