---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/PageHeading.astro";
import GoodsModal from "../../components/GoodsModal.astro";
import { goods } from "../../data/goods";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
---
<BaseLayout title="Goods" description="公式グッズ・関連商品情報。">
  <section class="goods section">
    <div class="container">
      <PageHeading title="Goods" />

      {goods.length === 0 ? (
        <p class="goods__empty">
          商品を追加するには <code>src/data/goods.ts</code> の <code>goods</code> 配列を更新してください。
        </p>
      ) : (
        <>
          <div class="goods-grid" aria-label="Goods item list">
            {goods.map((item, index) => {
              const modalId = `goods-modal-${index}`;
              return (
                <button
                  class="goods-card"
                  type="button"
                  aria-label={`${item.title} を開く`}
                  data-modal-open={modalId}
                >
                  <div class="goods-card__image-wrap">
                    <img
                      class="goods-card__image"
                      src={withBase(item.image)}
                      alt={item.title}
                      loading="lazy"
                      width="640"
                      height="480"
                    />
                  </div>
                  <p class="goods-card__title">{item.title}</p>
                </button>
              );
            })}
          </div>

          {goods.map((item, index) => (
            <GoodsModal
              id={`goods-modal-${index}`}
              title={item.title}
              image={withBase(item.detailImage ?? item.image)}
              description={item.description}
              saleUrl={item.url}
              saleLabel={item.saleLabel}
              buttonLabel={item.buttonLabel}
            />
          ))}
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .goods {
    padding-top: 20px;
  }

  .goods-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 20px;
    max-width: 860px;
    margin: 0 auto;
  }

  .goods-card {
    appearance: none;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .goods-card__image-wrap {
    width: 100%;
    background: #2f2f2f;
    border: 1px solid rgba(17, 17, 17, 0.72);
    overflow: hidden;
  }

  .goods-card__image {
    width: 100%;
    aspect-ratio: 4 / 2.65;
    object-fit: contain;
    display: block;
    background: #ffffff;
  }

  .goods-card__title {
    margin: 0;
    text-align: center;
    font-family: var(--f-serif);
    font-size: 17px;
    line-height: 1.4;
    color: var(--c-fg);
  }

  .goods__empty {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-6);
    text-align: center;
    color: var(--c-fg-muted);
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--c-border);
  }

  @media (max-width: 900px) {
    .goods-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 560px;
    }
  }

  @media (max-width: 640px) {
    .goods-grid {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }
</style>
