---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import GalleryModal from "../../components/GalleryModal.astro";
import { images } from "../../data/gallery";
import { commonMsg } from "../../msg/common";
import { galleryPageMsg } from "../../msg/pages/gallery";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
---
<BaseLayout title={galleryPageMsg.title} description={galleryPageMsg.description} bodyClass="gallery-page">
  <section class="gallery section">
    <div class="container">
      <PageHeading title={galleryPageMsg.title} />

      {images.length === 0 ? (
        <p class="gallery__empty">
          {galleryPageMsg.empty}
        </p>
      ) : (
        <>
          <div class="gallery-grid" aria-label={galleryPageMsg.listAriaLabel}>
            {images.map((img, index) => {
              const modalId = `gallery-modal-${index}`;
              const modalTitle = img.title ?? img.caption ?? img.alt;

              return (
                <button
                  class="gallery-card"
                  type="button"
                  aria-label={commonMsg.actions.open(modalTitle)}
                  data-modal-open={modalId}
                  style={`--delay:${index * 30}ms;`}
                >
                  <img
                    src={withBase(img.src)}
                    alt={img.alt}
                    loading="lazy"
                    width="640"
                    height="480"
                  />
                </button>
              );
            })}
          </div>

          {images.map((img, index) => {
            const modalId = `gallery-modal-${index}`;
            const modalTitle = img.title ?? img.caption ?? img.alt;
            const modalDescription = img.description ?? img.caption ?? "";
            const detailSrcs = (img.detailSrcs?.length ? img.detailSrcs : [img.src]).map((src) => ({
              src: withBase(src),
              alt: img.alt,
            }));

            return (
              <GalleryModal
                id={modalId}
                title={modalTitle}
                description={modalDescription}
                images={detailSrcs}
                creditName={img.creditName}
                creditUrl={img.creditUrl}
                twitterId={img.twitterId}
                buttonLabel={img.buttonLabel}
              />
            );
          })}
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery {
    padding-top: 20px;
    padding-bottom: 72px;
  }

  .gallery__empty {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-6);
    text-align: center;
    color: var(--c-fg-muted);
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--c-border);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 24px;
  }

  .gallery-card {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(17, 17, 17, 0.72);
    background: #fff;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transform: translateY(12px);
    opacity: 0;
    animation: gallery-in 500ms var(--ease-out) forwards;
    animation-delay: var(--delay);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      filter var(--dur-base) var(--ease-out);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 28px rgba(0, 0, 0, 0.14);
    filter: saturate(1.03);
  }

  .gallery-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 2.35;
    object-fit: cover;
  }

  @keyframes gallery-in {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 960px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .gallery {
      padding-bottom: 56px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-card img {
      aspect-ratio: 4 / 2.7;
    }
  }
</style>
