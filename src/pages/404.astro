---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/common/PageHeading.astro";
import { withBase } from "../lib/urls";
import { notFoundPageMsg } from "../msg/notFound";
---
<BaseLayout title={notFoundPageMsg.meta.title} pageContainerClass="container--narrow">
  <PageHeading slot="page-heading" title={notFoundPageMsg.headings.main} eyebrow="404" />
  <div class="notfound">
    <p class="notfound__description">
      {notFoundPageMsg.body.description}
    </p>
    <p><a href={withBase("/")}>{notFoundPageMsg.links.top}</a></p>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
  }

  .notfound__description {
    color: var(--c-fg-muted);
  }

  .notfound a {
    --notfound-link-fg: currentColor;
    --notfound-link-hover-fg: rgb(from var(--notfound-link-fg) r g b / 0.7);

    color: var(--notfound-link-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: currentColor;
    transition:
      color var(--dur-base) var(--ease-out),
      text-decoration-color var(--dur-base) var(--ease-out);
  }

  .notfound a:hover,
  .notfound a:focus-visible {
    color: var(--notfound-link-hover-fg);
    text-decoration-color: var(--notfound-link-hover-fg);
  }
</style>
