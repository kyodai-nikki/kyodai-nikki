---
import { site } from "../data/site";
import ShareButtons from "./ShareButtons.astro";

interface Props {
  shareUrl: string;
  shareTitle: string;
}

const { shareUrl, shareTitle } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__brand">{site.name}</div>

    <div class="site-footer__copyright">
      ©{site.copyStartYear}-{year} {site.name}制作チーム
    </div>

    <div class="site-footer__share">
      <span>Share :</span>
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
  </div>
</footer>
