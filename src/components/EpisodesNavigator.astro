---
// =========================================================
// Episodes ナビゲータ
// ---------------------------------------------------------
// props
//   - activeSeason : 現在表示中のシーズン（1〜4）
//   - selected     : 右パネルに表示する EpisodeEntry。未指定なら activeSlug / 先頭を使用
//   - activeSlug   : URL に含まれる現在の slug（= seasonEpisodeNumber）。左一覧のアクティブ判定に利用
// =========================================================
import {
  seasons,
  episodesBySeason,
  firstEpisodeOfSeason,
  episodeUrlSlug,
  type EpisodeEntry,
} from "../data/episodes";
import PageHeading from "./PageHeading.astro";

type EpisodeMeta = EpisodeEntry & {
  badge?: string;
};

interface Props {
  activeSeason: 1 | 2 | 3 | 4;
  selected?: EpisodeEntry;
  activeSlug?: string;
}

const { activeSeason, selected, activeSlug } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const dummySummary = `${base}/images/episodes/dummy-summary.svg`;
const dummyDetail  = `${base}/images/episodes/dummy-detail.svg`;

const activeSeasonInfo = seasons.find((s) => s.number === activeSeason)!;
const list = episodesBySeason(activeSeason);

// selected が無い場合は URL の slug、それも無ければシーズン先頭へフォールバック
const current: EpisodeMeta | undefined =
  (selected as EpisodeMeta | undefined) ??
  (list.find((e) => episodeUrlSlug(e) === activeSlug) as EpisodeMeta | undefined) ??
  (list[0] as EpisodeMeta | undefined);

// 画像パスを自動解決（public/images/episodes/{seasonSlug}/{seasonEpisodeNumber}/summary.png）
const summaryImagePath = (e: EpisodeEntry): string =>
  `${base}/images/episodes/${activeSeasonInfo.slug}/${episodeUrlSlug(e)}/summary.png`;
const detailImagePath = (e: EpisodeEntry): string =>
  `${base}/images/episodes/${activeSeasonInfo.slug}/${episodeUrlSlug(e)}/detail.png`;

const epHref = (e: EpisodeEntry) =>
  `${base}/episodes/${activeSeasonInfo.slug}/${episodeUrlSlug(e)}`;

const seasonHref = (seasonNumber: 1 | 2 | 3 | 4, seasonSlug: string) => {
  const first = firstEpisodeOfSeason(seasonNumber);
  return first
    ? `${base}/episodes/${seasonSlug}/${episodeUrlSlug(first)}`
    : `${base}/episodes/${seasonSlug}`;
};

/** 一覧カード用クラス名を組み立て */
const itemClass = (e: EpisodeEntry) => {
  const cls = ["ep-item"];
  if (e.isAlternate) cls.push("ep-item--alt");
  if (e.smallText)   cls.push("ep-item--sm");
  if (current?.overallNumber === e.overallNumber) cls.push("ep-item--selected");
  return cls.join(" ");
};

const numberLabel = (e: EpisodeEntry) =>
  e.isAlternate ? "..." : String(e.seasonEpisodeNumber ?? "").padStart(2, "0");

/** 詳細パネルのクラス */
const detailClass = current?.isAlternate ? "ep-detail ep-detail--alt" : "ep-detail";

/** ログページへのリンク（episodes/season{N}/{seasonEpisodeNumber}/log） */
const logHref = current
  ? `${base}/episodes/${activeSeasonInfo.slug}/${episodeUrlSlug(current)}/log`
  : undefined;
---

<section class="section container">
  <PageHeading title="Episodes" />

  {/* シーズン切替タブ＋ timeline -------------------------- */}
  <nav class="ep-seasons" aria-label="Season navigation">
    {seasons.map((s) => (
      <a
        href={seasonHref(s.number, s.slug)}
        aria-current={s.number === activeSeason ? "page" : undefined}
      >
        {s.label}
      </a>
    ))}
    <a href={`${base}/episodes/timeline`}>timeline</a>
  </nav>

  {/* 一覧 ＋ 詳細パネル ----------------------------------- */}
  <div class="ep-layout">
    {/* 左：エピソード一覧（縦スクロール、スクロールバー非表示） */}
    <ol class="ep-list" aria-label={`${activeSeasonInfo.label} episodes`}>
      {list.length === 0 ? (
        <li class="ep-empty">No episodes yet.</li>
      ) : (
        list.map((e) => (
          <li>
            <a
              class={itemClass(e)}
              href={epHref(e)}
              style={`--ep-bg: url('${summaryImagePath(e)}'), url('${dummySummary}');`}
            >
              <span class="ep-item__no">{numberLabel(e)}</span>
              <span class="ep-item__title">{e.title}</span>
            </a>
          </li>
        ))
      )}
    </ol>

    {/* 右：選択中エピソードの詳細 */}
    {current ? (
      <article class={detailClass} aria-live="polite">
        <div class="ep-detail__image-wrap">
          <img
            class="ep-detail__image"
            src={detailImagePath(current)}
            alt={`${current.title} main visual`}
            onerror={`this.src='${dummyDetail}'`}
          />
        </div>

        <h2 class="ep-detail__title">
          <span>{current.title}</span>
          <span class="ep-detail__subtitle">
            {current.isAlternate
              ? "Another Episode"
              : `Episode${String(current.seasonEpisodeNumber ?? "").padStart(2, "0")}`}
          </span>
        </h2>

        <p class="ep-detail__body">{current.description}</p>

        <div class="ep-detail__foot">
          <div>
            {current.badge && <span class="ep-detail__badge">{current.badge}</span>}
            {current.isR18 && !current.isR18G && <span class="ep-detail__badge">R-18</span>}
            {current.isR18G && <span class="ep-detail__badge">R-18G</span>}
          </div>
          {logHref && (
            <a class="ep-detail__read" href={logHref}>
              読む
            </a>
          )}
        </div>
      </article>
    ) : (
      <article class="ep-detail ep-detail--empty">
        <p>エピソードを選択してください。</p>
      </article>
    )}
  </div>
</section>

<style>
  /* ====== シーズンタブ（chars-tabs と同等のアニメーション） ====== */
  .ep-seasons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(var(--s-5), 5vw, var(--s-8));
    margin-bottom: 30px;
    padding-bottom: var(--s-3);
  }
  .ep-seasons a {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: var(--c-fg);
    text-decoration: none;
    letter-spacing: var(--ls-wide);
    padding: var(--s-2) 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ep-seasons a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -3px;
    height: 2px;
    background: var(--c-site-cyan);
    transition: left var(--dur-base) var(--ease-out),
      right var(--dur-base) var(--ease-out);
    pointer-events: none;
  }
  .ep-seasons a:hover::after,
  .ep-seasons a:focus-visible::after {
    left: 0;
    right: 0;
  }
  .ep-seasons a[aria-current="page"]::after {
    left: 0;
    right: 0;
    background: var(--c-site-pink);
    transition: none;
  }

  /* ====== 一覧 ＋ 詳細の 2 カラム ====== */
  .ep-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(var(--s-4), 3vw, var(--s-6));
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ====== 一覧（スクロールバー非表示） ====== */
  .ep-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 640px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ep-list::-webkit-scrollbar {
    display: none;
  }
  .ep-empty {
    padding: var(--s-5);
    color: var(--c-fg-muted);
    text-align: center;
  }

  /* ====== 一覧カード ====== */
  /* 概要画像はカード全体の background-image として使い、
     その上に白→透明のグラデーションを overlay として重ねる。
     画像が存在しない場合はダミー SVG にフォールバック */
  .ep-item {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: var(--s-3);
    min-height: 88px;
    padding: var(--s-3) var(--s-4);
    background-color: #ffffff;
    background-image:
      linear-gradient(
        90deg,
        rgb(255, 255, 255) 37%,
        rgba(245, 242, 237, 0.54) 100%,
        rgba(234, 227, 215, 0) 100%
      ),
      var(--ep-bg, none);
    background-size: cover, cover;
    background-position: left center, right center;
    background-repeat: no-repeat, no-repeat;
    border: 1px solid var(--c-border);
    color: var(--c-fg);
    text-decoration: none;
    overflow: hidden;
    transition: background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .ep-item:hover {
    border-color: var(--c-border-strong);
  }
  .ep-item__no {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    letter-spacing: var(--ls-wide);
    position: relative;
    z-index: 1;
  }
  .ep-item__title {
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    letter-spacing: var(--ls-wide);
    position: relative;
    z-index: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ep-item--sm .ep-item__title {
    font-size: var(--fs-sm);
  }

  /* 通常エピソード：選択時 → 黒背景 */
  .ep-item--selected:not(.ep-item--alt) {
    background-color: #1a1a1a;
    background-image:
      linear-gradient(
        90deg,
        rgb(26, 26, 26) 37%,
        rgba(26, 26, 26, 0.54) 100%,
        rgba(26, 26, 26, 0) 100%
      ),
      var(--ep-bg, none);
    color: #ffffff;
    border-color: #1a1a1a;
  }

  /* 別史エピソード：通常時 → 黒背景＋番号非表示 */
  .ep-item--alt {
    background-color: #2a2a2a;
    background-image:
      linear-gradient(
        90deg,
        rgb(42, 42, 42) 37%,
        rgba(42, 42, 42, 0.54) 100%,
        rgba(42, 42, 42, 0) 100%
      ),
      var(--ep-bg, none);
    color: #ffffff;
    border-color: #2a2a2a;
  }
  /* 別史 ＋ 選択時 → 白背景に反転 */
  .ep-item--alt.ep-item--selected {
    background-color: #ffffff;
    background-image:
      linear-gradient(
        90deg,
        rgb(255, 255, 255) 37%,
        rgba(245, 242, 237, 0.54) 100%,
        rgba(234, 227, 215, 0) 100%
      ),
      var(--ep-bg, none);
    color: var(--c-fg);
    border-color: var(--c-fg);
  }

  /* ====== 詳細パネル ====== */
  .ep-detail {
    border: 1px solid var(--c-border);
    background: #ffffff;
    color: var(--c-fg);
    padding: clamp(var(--s-4), 3vw, var(--s-6));
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-height: 640px;
  }

  /* 別史選択中：黒地に白文字＋画像グレースケール */
  .ep-detail--alt {
    background: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
  }
  .ep-detail--alt .ep-detail__image {
    filter: grayscale(1);
  }
  .ep-detail--alt .ep-detail__badge {
    background: #ffffff;
    color: #1a1a1a;
  }

  .ep-detail--empty {
    align-items: center;
    justify-content: center;
    color: var(--c-fg-muted);
  }

  .ep-detail__image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f5f5f5;
    overflow: hidden;
  }
  .ep-detail__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ep-detail__title {
    margin: 0;
    font-family: var(--f-serif);
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .ep-detail__subtitle {
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    color: inherit;
    opacity: 0.75;
    letter-spacing: var(--ls-wide);
  }

  .ep-detail__body {
    margin: 0;
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    line-height: 1.9;
    white-space: pre-wrap;
  }

  .ep-detail__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .ep-detail__foot > div {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }
  .ep-detail__badge {
    display: inline-block;
    padding: var(--s-1) var(--s-3);
    background: #1a1a1a;
    color: #ffffff;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
  }
  .ep-detail__read {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    padding: var(--s-2) var(--s-5);
    border: 1px solid var(--c-fg);
    color: var(--c-fg);
    background: transparent;
    text-decoration: none;
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-wide);
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .ep-detail__read:hover {
    background: var(--c-fg);
    color: #ffffff;
  }

  /* ====== レスポンシブ：狭い画面では縦積み ====== */
  @media (max-width: 880px) {
    .ep-layout {
      grid-template-columns: 1fr;
    }
    .ep-list {
      max-height: 360px;
    }
    .ep-detail {
      min-height: auto;
    }
  }
</style>

<script>
  /*
    選択中のエピソード（.ep-item--selected）を一覧の一番上に来るよう
    自動でスクロールする。リスト内 scroll なので親ページはスクロールしない。
  */
  (() => {
    const list = document.querySelector(".ep-list");
    if (!(list instanceof HTMLElement)) return;

    const selected = list.querySelector(".ep-item--selected");
    if (!(selected instanceof HTMLElement)) return;

    const li = selected.closest("li");
    if (!(li instanceof HTMLElement)) return;

    // li の上端をリスト内のスクロール位置 0 に合わせる
    const target = li.offsetTop - list.offsetTop;
    list.scrollTop = target;
  })();
</script>
