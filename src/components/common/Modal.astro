---
import { commonMsg } from "../../msg/common";

interface Props {
  id: string;
  ariaLabel: string;
  panelClass?: string;
  showCloseButton?: boolean;
  dismissible?: boolean;
}

const {
  id,
  ariaLabel,
  panelClass = "",
  showCloseButton = true,
  dismissible = true,
} = Astro.props;
---

<dialog
  class="modal"
  data-modal-root
  data-modal-id={id}
  data-modal-dismissible={dismissible ? "true" : "false"}
  aria-label={ariaLabel}
>
  <div class:list={["modal__panel", panelClass]}>
    {showCloseButton && (
      <button class="modal__close" type="button" aria-label={commonMsg.actions.close} data-modal-close>
        &times;
      </button>
    )}
    <div class="modal__content">
      <slot />
    </div>
  </div>
</dialog>

<script>
  if (!window.__kyodaiModalInitialized) {
    window.__kyodaiModalInitialized = true;

    let closingDialog = null;

    const dialogSelector = "[data-modal-root]";

    const isModalDialog = (element) =>
      element instanceof HTMLDialogElement && element.matches(dialogSelector);

    const isDismissible = (dialog) =>
      isModalDialog(dialog) && dialog.dataset.modalDismissible !== "false";

    const resolveDialog = (target) => {
      if (isModalDialog(target)) return target;
      if (typeof target !== "string") return null;

      const dialog = document.querySelector(`[data-modal-id="${target}"]`);
      return isModalDialog(dialog) ? dialog : null;
    };

    const restoreBodyScroll = () => {
      const hasOpenDialog = Array.from(document.querySelectorAll(dialogSelector)).some(
        (element) => element instanceof HTMLDialogElement && element.open,
      );

      if (!hasOpenDialog) {
        document.body.style.overflow = "";
        document.body.style.paddingRight = "";
      }
    };

    const lockBodyScroll = () => {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      document.body.style.paddingRight = `${scrollbarWidth}px`;
    };

    const openDialog = (dialog) => {
      if (!isModalDialog(dialog) || dialog.open) return;

      dialog.dataset.state = "open";
      dialog.showModal();
      lockBodyScroll();

      const content = dialog.querySelector(".modal__content");
      if (content instanceof Element) content.scrollTop = 0;
    };

    const closeWithAnimation = (dialog) => {
      if (!isModalDialog(dialog) || !dialog.open || dialog.dataset.state === "closing") return;

      dialog.dataset.state = "closing";
      closingDialog = dialog;

      window.setTimeout(() => {
        if (closingDialog === dialog) {
          dialog.close();
        }
      }, 220);
    };

    window.__kyodaiModal = {
      open(target) {
        const dialog = resolveDialog(target);
        if (dialog) openDialog(dialog);
      },
      close(target) {
        const dialog = resolveDialog(target);
        if (dialog) closeWithAnimation(dialog);
      },
      restoreBodyScroll,
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const openButton = target.closest("[data-modal-open]");
      if (openButton instanceof HTMLElement) {
        const dialog = resolveDialog(openButton.dataset.modalOpen);
        if (dialog) openDialog(dialog);
        return;
      }

      const closeButton = target.closest("[data-modal-close]");
      if (closeButton instanceof HTMLElement) {
        const dialog = closeButton.closest(dialogSelector);
        closeWithAnimation(dialog);
      }
    });

    document.addEventListener(
      "cancel",
      (event) => {
        const dialog = event.target;
        if (!isModalDialog(dialog)) return;

        event.preventDefault();
        if (isDismissible(dialog)) {
          closeWithAnimation(dialog);
        }
      },
      true,
    );

    document.addEventListener(
      "close",
      (event) => {
        const dialog = event.target;
        if (!isModalDialog(dialog)) return;

        if (closingDialog === dialog) {
          closingDialog = null;
        }

        dialog.dataset.state = "";
        restoreBodyScroll();
      },
      true,
    );
  }

  // モーダル本体に外側クリックで閉じる処理を定義
  const initModalBackdropListeners = () => {
    document.querySelectorAll("[data-modal-root]").forEach((dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.dataset.backdropInit === "true") return;
      dialog.dataset.backdropInit = "true";

      dialog.addEventListener("click", (event) => {
        // 子要素からのバブルは無視（バックドロップクリックは event.target === dialog）
        if (event.target !== dialog) return;
        if (!dialog.open || dialog.dataset.modalDismissible === "false") return;

        const bounds = dialog.getBoundingClientRect();
        const isBackdropClick =
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom;

        if (isBackdropClick) {
          window.__kyodaiModal?.close(dialog);
        }
      });
    });
  };

  initModalBackdropListeners();
  document.addEventListener("astro:page-load", initModalBackdropListeners);
</script>

<style>
  .modal {
    width: min(900px, calc(100vw - 40px));
    max-height: calc(100dvh - 40px);
    padding: 0;
    border: 1px solid rgba(17, 17, 17, 0.75);
    background: #fff;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(56px);
    will-change: transform, opacity;
  }

  .modal::backdrop {
    background: rgba(0, 0, 0, 0.24);
  }

  .modal[open] {
    animation: modal-window-rise 280ms var(--ease-out) forwards;
  }

  .modal[open][data-state="closing"] {
    animation: modal-window-fade-out 220ms ease-out forwards;
  }

  .modal[open]::backdrop {
    animation: modal-backdrop-in 260ms ease-out forwards;
  }

  .modal[open][data-state="closing"]::backdrop {
    animation: modal-backdrop-out 220ms ease-out forwards;
  }

  .modal__panel {
    position: relative;
    max-height: calc(100dvh - 40px);
    display: flex;
    flex-direction: column;
    padding: 56px 0 48px;
  }

  .modal__content {
    min-height: 0;
    overflow: auto;
  }

  .modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    border: 0;
    background: transparent;
    color: var(--c-fg);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  @keyframes modal-backdrop-in {
    from {
      background: rgba(0, 0, 0, 0);
    }

    to {
      background: rgba(0, 0, 0, 0.24);
    }
  }

  @keyframes modal-backdrop-out {
    from {
      background: rgba(0, 0, 0, 0.24);
    }

    to {
      background: rgba(0, 0, 0, 0);
    }
  }

  @keyframes modal-window-rise {
    from {
      transform: translateY(56px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes modal-window-fade-out {
    from {
      transform: translateY(0);
      opacity: 1;
    }

    to {
      transform: translateY(28px);
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .modal {
      width: min(100vw - 20px, 680px);
    }

    .modal__panel {
      padding: 48px 0 28px;
    }
  }
</style>
