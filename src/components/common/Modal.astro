---
import { commonMsg } from "../../msg/common";

interface Props {
  id: string;
  ariaLabel: string;
  variant?: "default" | "spoiler";
  panelPadding?: "default" | "none";
  panelClass?: string;
  showCloseButton?: boolean;
  dismissible?: boolean;
}

const {
  id,
  ariaLabel,
  variant = "default",
  panelPadding = "default",
  panelClass = "",
  showCloseButton = true,
  dismissible = true,
} = Astro.props;
---

<dialog
  class:list={["modal", variant !== "default" && `modal--${variant}`]}
  data-modal-root
  data-modal-id={id}
  data-modal-dismissible={dismissible ? "true" : "false"}
  aria-label={ariaLabel}
  tabindex="-1"
>
  <div class:list={["modal__panel", panelPadding === "none" && "modal__panel--padding-none", panelClass]}>
    {showCloseButton && (
      <button class="modal__close" type="button" aria-label={commonMsg.actions.close} data-modal-close>
        &times;
      </button>
    )}
    <div class="modal__content">
      <slot />
    </div>
  </div>
</dialog>

<script>
  import "../../scripts/modal";
</script>

<style>
  .modal {
    --modal-bg: var(--c-modal-bg);
    --modal-border: var(--c-modal-border);
    --modal-backdrop: var(--c-modal-backdrop);
    --modal-close-fg: var(--c-modal-close-fg);

    width: var(--modal-width, min(900px, calc(100vw - 40px)));
    max-height: calc(100dvh - 40px);
    padding: 0;
    border: 1px solid var(--modal-border);
    border-radius: var(--r-m);
    background: var(--modal-bg);
    overflow: hidden;
    box-shadow: var(--sh-modal);
    opacity: 0;
    transform: translateY(56px);
    will-change: transform, opacity;
  }

  .modal::backdrop {
    background: var(--modal-backdrop);
  }

  .modal:focus {
    outline: none;
  }

  /* Generated from the `variant` prop: modal--${variant}. */
  .modal--spoiler {
    --modal-width: min(920px, calc(100vw - 48px));
    --modal-tablet-width: min(100vw - 24px, 920px);
  }

  .modal[open] {
    animation: modal-window-rise 280ms var(--ease-out) forwards;
  }

  .modal[open][data-state="closing"] {
    animation: modal-window-fade-out 220ms ease-out forwards;
  }

  .modal[open]::backdrop {
    animation: modal-backdrop-in 260ms ease-out forwards;
  }

  .modal[open][data-state="closing"]::backdrop {
    animation: modal-backdrop-out 220ms ease-out forwards;
  }

  .modal__panel {
    position: relative;
    max-height: calc(100dvh - 100px);
    display: flex;
    flex-direction: column;
    padding: 56px 0 48px;
  }

  .modal__panel--padding-none {
    padding: 0;
  }

  .modal__content {
    min-height: 0;
    overflow: auto;
  }

  .modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    border: 0;
    background: transparent;
    color: var(--modal-close-fg);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  @keyframes modal-backdrop-in {
    from {
      background: transparent;
    }

    to {
      background: var(--modal-backdrop);
    }
  }

  @keyframes modal-backdrop-out {
    from {
      background: var(--modal-backdrop);
    }

    to {
      background: transparent;
    }
  }

  @keyframes modal-window-rise {
    from {
      transform: translateY(56px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes modal-window-fade-out {
    from {
      transform: translateY(0);
      opacity: 1;
    }

    to {
      transform: translateY(28px);
      opacity: 0;
    }
  }

  @media (--bp-tablet) {
    .modal {
      width: var(--modal-tablet-width, min(100vw - 20px, 680px));
    }

    .modal__panel {
      max-height: calc(100dvh - 40px);
      padding: 48px 0 28px;
    }

    .modal__close {
      top: 10px;
      right: 10px;
    }
  }
</style>
