---
import BaseLayout from "../layouts/BaseLayout.astro";
import { hero } from "../data/hero";
import { site } from "../data/site";
import { commonMsg } from "../msg/common";
import { homePageMsg } from "../msg/pages/home";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout
  title={homePageMsg.title}
  description={homePageMsg.description}
  bodyClass="is-home"
>
  <section class="hero" aria-label={homePageMsg.heroAriaLabel}>
    <div
      class="hero__image"
      style={`background-image: url('${base}${hero.image}');`}
      role="img"
      aria-label={hero.imageCredit || homePageMsg.heroFallbackImageLabel}
    ></div>
    <div class="hero__overlay">
      <div class="hero__copyline">©{site.copyStartYear}-{new Date().getFullYear()} {site.name}{commonMsg.footer.madeByTeam}</div>
      <div class="hero__share">
        {commonMsg.footer.shareLabel}
        <span aria-hidden="true">・</span>
      </div>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__tagline">
        <span>{hero.startDate}</span><br />
        <span>{hero.status}</span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: min(92vh, 900px);
    overflow: hidden;
    background: #eef1f4;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .hero__overlay {
    position: relative;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: var(--s-7) var(--s-6);
    min-height: inherit;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--s-5);
    row-gap: var(--s-2);
  }

  .hero__copyline {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    text-align: right;
  }

  .hero__share {
    grid-column: 2;
    grid-row: 2;
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    text-align: right;
  }

  .hero__title {
    grid-column: 2;
    grid-row: 3;
    align-self: start;
    justify-self: end;
    font-family: var(--f-serif);
    font-weight: var(--fw-black);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--c-fg);
    margin: var(--s-3) 0 var(--s-3);
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .hero__tagline {
    grid-column: 2;
    grid-row: 4;
    justify-self: end;
    text-align: right;
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: var(--c-fg);
    line-height: 1.8;
    margin: 0;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 640px) {
    .hero {
      min-height: min(70vh, 640px);
    }

    .hero__overlay {
      padding: var(--s-5) var(--s-4);
      grid-template-columns: 1fr;
    }

    .hero__copyline,
    .hero__share,
    .hero__title,
    .hero__tagline {
      grid-column: 1;
      text-align: left;
      justify-self: start;
    }

    .hero__title {
      font-size: clamp(2rem, 10vw, 3rem);
    }
  }
</style>
