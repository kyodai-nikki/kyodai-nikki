---
interface Props {
  label: string;
  variant?: "default" | "alt";
}

const { label, variant = "default" } = Astro.props;
---

<span class:list={["badge", `badge--${variant}`]}>{label}</span>

<style>
  .badge {
    --badge-bg: var(--c-badge-bg);
    --badge-fg: var(--c-badge-fg);

    display: inline-flex;
    align-items: center;
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-md);
    font-family : var(--font-family-base);
    font-size: var(--fs-m);
    line-height: var(--lh-s-tight);
    letter-spacing: var(--ls-wide);
    white-space: nowrap;
  }

  /* Generated from the `variant` prop: badge--${variant}. */
  .badge--default {
    background: var(--badge-bg);
    color: var(--badge-fg);
  }

  .badge--alt {
    --badge-bg: var(--c-badge-alt-bg);
    --badge-fg: var(--c-badge-alt-fg);

    background: var(--badge-bg);
    color: var(--badge-fg);
  }

  @media (--bp-tablet) {
    .badge {
      font-size: var(--fs-sm2);
    }
  }
</style>
