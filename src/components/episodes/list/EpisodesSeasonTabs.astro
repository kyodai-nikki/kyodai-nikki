---
import Tabs from "../../common/Tabs.astro";
import { episodeSeasonTabItems } from "../../../lib/episodes/view";
import type { SeasonInfo } from "../../../lib/episodes";

interface Props {
  activeSeason?: SeasonInfo["number"];
  current?: "season" | "timeline";
}

const { activeSeason, current = "season" } = Astro.props as Props;
const items = await episodeSeasonTabItems(current, activeSeason);
---

<Tabs items={items} ariaLabel="Season navigation" size="md" />
