---
export interface TabItem {
  /** Display label. */
  label: string;
  /** Destination URL with base path already applied. */
  href: string;
  /** Adds aria-current="page" for the active tab. */
  active?: boolean;
}

interface Props {
  /** Tabs are displayed in the order they are passed. */
  items: TabItem[];
  /** Accessible label for the tab navigation. */
  ariaLabel: string;
}

const { items, ariaLabel } = Astro.props;
---

<nav class="tab-nav" aria-label={ariaLabel}>
  <div class="tab-nav__list">
    {items.map((item) => (
      <a href={item.href} aria-current={item.active ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .tab-nav {
    --tabs-fg: var(--c-tabs-fg);
    --tabs-border: var(--c-tabs-border);
    --tabs-active-border: var(--c-tabs-active-border);

    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--s-3);
  }

  .tab-nav__list {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 60px;
    min-width: 100%;
    width: max-content;
  }

  .tab-nav a {
    flex: 0 0 auto;
    font-weight: 600;
    position: relative;
    color: var(--tabs-fg);
    font-family: var(--font-family-base);
    font-size: 24px;
    line-height: var(--lh-s-tight);
    text-decoration: none;
    white-space: nowrap;
  }

  .tab-nav a::after {
    content: "";
    position: absolute;
    left: -4px;
    right: -4px;
    bottom: -3px;
    height: 0;
    border-bottom: 4px solid var(--tabs-border);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: center;
    transition:
      border-bottom-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .tab-nav a:hover::after {
    transform: scaleX(1);
  }

  .tab-nav [aria-current="page"]::after {
    border-bottom-color: var(--tabs-active-border);
    transform: scaleX(1);
  }

  @media (--bp-tablet) {
    .tab-nav__list {
      gap: 20px;
    }

    .tab-nav a {
      font-size: 18px;
    }
  }

  @media (--bp-mobile) {
    .tab-nav__list {
      gap: 20px;
    }
  }
</style>
