---
import {
  episodeThumbnailImage,
  type EpisodeEntry,
  type SeasonInfo,
} from "../../../lib/episodes";
import { episodeOverviewLabel } from "../../../lib/episodes/view";
import { commonMsg } from "../../../msg/common";
import { episodesPageMsg } from "../../../msg/episodes";
import Badge from "../../common/Badge.astro";
import Button from "../../common/btn/Button.astro";

type EpisodeMeta = EpisodeEntry & {
  badge?: string;
};

interface Props {
  current?: EpisodeMeta;
  seasonSlug: SeasonInfo["slug"];
  logHref?: string;
  dummyThumbnail: string;
}

const { current, seasonSlug, logHref, dummyThumbnail } = Astro.props as Props;
const detailClass =
  current && current.type !== "normal" ? "ep-detail ep-detail--alt" : "ep-detail";
const badgeVariant = current && current.type !== "normal" ? "alt" : "default";
const isAltEpisode = Boolean(current && current.type !== "normal");
const readButtonType = isAltEpisode ? "black" : "white";
const readButtonTone = isAltEpisode
  ? {
      borderColor: "var(--c-bg)",
    }
  : {
      borderColor: "var(--c-border)",
      bg: "transparent",
      color: "var(--episode-detail-fg)",
    };
---

{current ? (
  <article id="ep-detail" class={detailClass} aria-live="polite">
    <div class="ep-detail__image-wrap">
      <img
        class="ep-detail__image"
        src={episodeThumbnailImage(seasonSlug, current)}
        alt={episodesPageMsg.alt.thumbnail(current.title)}
        data-fallback-src={dummyThumbnail}
      />
    </div>

    <h2 class="ep-detail__title">
      <span>{current.title}</span>
      <span class="ep-detail__subtitle">
        {episodeOverviewLabel(current)}
      </span>
    </h2>

    <p class="ep-detail__body">{current.description}</p>

    <div class="ep-detail__foot">
      <div>
        {current.badge && <Badge label={current.badge} variant={badgeVariant} />}
        {current.isR18 && <Badge label={commonMsg.badges.r18} variant={badgeVariant} />}
        {current.isR18G && <Badge label={commonMsg.badges.r18g} variant={badgeVariant} />}
      </div>
      {logHref && (
        <Button
          href={logHref}
          type={readButtonType}
          size="s"
          class="ep-detail__read-button"
          {...readButtonTone}
        >
          {commonMsg.actions.read}
        </Button>
      )}
    </div>
  </article>
) : (
  <article class="ep-detail ep-detail--empty">
    <p>{episodesPageMsg.empty.episodeSelection}</p>
  </article>
)}

<style>
  .ep-detail {
    --episode-detail-bg: var(--c-episode-detail-bg);
    --episode-detail-fg: var(--c-episode-detail-fg);
    --episode-detail-border: var(--c-episode-detail-border);
    --episode-detail-alt-bg: var(--c-episode-detail-alt-bg);
    --episode-detail-alt-fg: var(--c-episode-detail-alt-fg);
    --episode-detail-empty-fg: var(--c-episode-detail-empty-fg);
    --episode-detail-image-bg: var(--c-episode-detail-image-bg);

    border: 1px solid var(--episode-detail-border);
    background: var(--episode-detail-bg);
    color: var(--episode-detail-fg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-height: 640px;
    border-radius: var(--r-md);
    scroll-margin-top: calc(var(--site-header-offset) + var(--s-4));
  }

  .ep-detail--alt {
    background: var(--episode-detail-alt-bg);
    color: var(--episode-detail-alt-fg);
    border-color: var(--episode-detail-border);
  }

  .ep-detail--alt .ep-detail__image {
    filter: grayscale(1);
  }

  .ep-detail--alt .ep-detail__title,
  .ep-detail--alt .ep-detail__subtitle {
    color: var(--episode-detail-alt-fg);
    opacity: 1;
  }

  .ep-detail--empty {
    align-items: center;
    justify-content: center;
    color: var(--episode-detail-empty-fg);
  }

  .ep-detail__image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--episode-detail-image-bg);
    overflow: hidden;
  }

  .ep-detail__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ep-detail__title {
    margin: 0;
    font-family: var(--font-family-base);
    font-size: var(--fs-xl2);
    font-weight: var(--fw-bold);
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
  }

  .ep-detail__subtitle {
    font-size: var(--fs-lg);
    font-weight: var(--fw-regular);
  }

  .ep-detail__body {
    margin: 0;
    font-family: var(--font-family-base);
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    white-space: pre-wrap;
  }

  .ep-detail__foot {
    margin-top: auto;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .ep-detail__foot > div {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  :global(.ep-detail__read-button) {
    --button-min-width: 125px;
    --button-min-height: 0;
    --button-padding-block: var(--s-2);
    --button-padding-inline: 0;
    --button-font-size: var(--fs-lg);
    --button-line-height: var(--lh-s-tight);
  }

  @media (--bp-tablet) {
    .ep-detail {
      min-height: auto;
    }

    :global(.ep-detail__read-button) {
      --button-min-width: 100px;
      --button-padding-block: 6px;
      --button-font-size: var(--fs-m);
    }
  }
</style>
