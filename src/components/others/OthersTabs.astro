---
import { othersSections, type OthersSectionSlug } from "../../data/others/tab";
import { othersPageMsg } from "../../msg/pages/others";

interface Props {
  currentSection: OthersSectionSlug;
}

const { currentSection } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
---

<nav class="others-tabs" aria-label={othersPageMsg.tabsAriaLabel}>
  {othersSections.map((section) => (
    <a href={withBase(section.href)} aria-current={section.slug === currentSection ? "page" : undefined}>
      {section.label}
    </a>
  ))}
</nav>

<style>
  .others-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(28px, 4vw, 56px);
    margin: 20px 0 38px;
    padding-bottom: 8px;
  }

  .others-tabs a {
    position: relative;
    padding: 6px 0;
    color: var(--c-fg);
    font-family: var(--f-serif);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .others-tabs a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -2px;
    height: 2px;
    background: var(--c-site-cyan);
    transition:
      left var(--dur-base) var(--ease-out),
      right var(--dur-base) var(--ease-out);
  }

  .others-tabs a:hover::after,
  .others-tabs a:focus-visible::after {
    left: 0;
    right: 0;
  }

  .others-tabs a[aria-current="page"]::after {
    left: 0;
    right: 0;
    background: var(--c-site-pink);
    transition: none;
  }

  @media (max-width: 640px) {
    .others-tabs {
      gap: 20px 28px;
      margin-bottom: 28px;
    }

    .others-tabs a {
      font-size: 1.125rem;
    }
  }
</style>
