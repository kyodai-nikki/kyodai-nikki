---
import ShareButtons from "./btn/ShareButtons.astro";
import { withBase } from "../../lib/urls";
import { commonMsg } from "../../msg/common";
import { siteConfig } from "../../config";

interface Props {
  shareUrl: string;
  shareTitle: string;
}

const { shareUrl, shareTitle } = Astro.props;
const site = siteConfig;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__brand">
      <img src={withBase(site.logoPath)} alt={site.name} class="site-brand__logo" />
    </div>

    <div class="site-footer__copyright">
      {commonMsg.symbols.copyright}{site.copyStartYear}-{year} {siteConfig.teamName}
    </div>

    <div class="site-footer__share">
      <span>{commonMsg.footer.shareLabel}</span>
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    padding: 30px 0;
    box-shadow: 0px -2px 2px rgba(0, 0, 0, 0.2);
    background: var(--c-footer-bg);
    text-align: center;
  }

  .site-footer .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .site-footer__brand img {
    width: 150px;
    height: auto;
    margin-bottom: 10px;
  }

  .site-footer__copyright {
    font-family: var(--f-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-footer-copyright);
  }

  .site-footer__share {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-footer-share);
  }

  @media (--bp-laptop) {
    :global(body) {
      padding-bottom: 200px;
    }

    .site-footer {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 900;
      padding-block: 40px;
    }
  }

  @media (--bp-tablet) {
    :global(body) {
      padding-bottom: 90px;
    }

    .site-footer {
      padding-block: 20px;
    }

    .site-footer__brand {
      display: none;
    }
  }
</style>
