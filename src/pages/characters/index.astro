---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import { characterHref, characterPortraitSrc, orderedCharacters } from "../../lib/characters";
import { charactersPageMsg } from "../../msg/characters";
import { navigation } from "../../data/navigation";

const characters = await orderedCharacters();
---
<BaseLayout title={navigation.characters.title} description={charactersPageMsg.meta.description}>
  <PageHeading slot="page-heading" title={navigation.characters.title} />

  <ul class="chars-grid">
    {characters.map((c, i) => (
      <li class="chars-card" style={{ "--i": i }}>
        <a href={characterHref(c)} aria-label={c.data.name}>
          <div class="chars-card__img-wrap u-image-zoom-frame">
            <img
              src={characterPortraitSrc(c)}
              alt={c.data.name}
              loading="lazy"
              class="chars-card__img"
            />
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .chars-grid {
    --characters-card-border: var(--c-border);
    --characters-placeholder-stripe-dark: var(--bc-gray);
    --characters-placeholder-stripe-light: rgb(from var(--bc-gray) r g b / 0.35);

    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 1200px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(12px, 2vw, 20px);
  }

  .chars-card {
    flex: 0 0 150px;
    width: 150px;
    opacity: 0;
    transform: translateY(32px);
    animation: chars-rise 700ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 220ms + 120ms);
  }

  .chars-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .chars-card__img-wrap {
    --image-filter: grayscale(1);
    --image-hover-filter: grayscale(0);
    --image-hover-scale: 1.03;
    position: relative;
    width: 150px;
    height: 600px;
    border-radius: var(--r-md);
    border: 1px solid var(--characters-card-border);
    background:
      repeating-linear-gradient(
        135deg,
        var(--characters-placeholder-stripe-dark) 0 2px,
        var(--characters-placeholder-stripe-light) 2px 8px
      );
  }

  .chars-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes chars-rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chars-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (--bp-tablet) {
    .chars-grid {
      gap: 20px;
    }

    .chars-card {
      flex-basis: 150px;
    }

    .chars-card__img-wrap {
      --image-filter: brightness(1);
      --image-hover-filter: opacity(1);
    }
  }

  @media (--bp-mobile) {
    .chars-grid {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: scroll;
      overflow-y: hidden;
      padding-bottom: var(--s-2);
      -webkit-overflow-scrolling: touch;
    }

    .chars-card {
      flex-basis: 95px;
      width: 95px;
      height: 370px;
    }

    .chars-card__img-wrap {
      width: 95px;
      height: 370px;
    }
  }
</style>
