---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeading from "../../../components/common/PageHeading.astro";
import OthersTabs from "../../../components/others/OthersTabs.astro";
import WhiteCard from "../../../components/common/WhiteCard.astro";
import { othersPageMsg } from "../../../msg/others";
import { navigation } from "../../../data/navigation";
import { contactConfig } from "../../../config";
import ContactBody from "../../../content/contact.md";

const contact = contactConfig;
---

<BaseLayout title={`${navigation.others.title} | お問い合わせ`} description={othersPageMsg.description}>
  <PageHeading slot="page-heading" title={navigation.others.title} />
  <OthersTabs slot="page-tabs" currentSection="contact" />
  <section class="others">
    <div class="others-contact">
      <WhiteCard centered translucent>
        <p class="others-contact__team">{contact.team}</p>
        <div class="others-contact__body"><ContactBody /></div>
        <p class="others-contact__mail">
          mail:
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </WhiteCard>
    </div>
  </section>
</BaseLayout>

<style>
  .others {
    padding-top: 20px;
  }

  .others-contact {
    max-width: 1080px;
    min-height: 560px;
    margin: 0 auto;
  }

  .others-contact__team,
  .others-contact__body,
  .others-contact__mail {
    margin: 0;
    font-family: var(--f-serif);
    color: var(--c-fg);
  }

  .others-contact__team {
    font-size: 24px;
    line-height: 1.4;
  }

  .others-contact__body,
  .others-contact__mail {
    font-size: 18px;
    line-height: 1.9;
  }

  .others-contact__body :global(p) {
    margin: 0;
    white-space: pre-wrap;
  }

  .others-contact__mail a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 640px) {
    .others-contact {
      min-height: auto;
    }

    .others-contact__card {
      padding: 36px 20px;
    }
  }
</style>
