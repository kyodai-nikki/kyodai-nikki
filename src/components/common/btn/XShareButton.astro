---
import { commonMsg } from "../../../msg/common";
import Icon, { IconName } from "../Icon.astro";

interface Props {
  href: string;
  iconSize?: number | string;
}

const { href, iconSize } = Astro.props;
---

<a
  class="share-button share-button--x"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={commonMsg.social.shareX}
>
  <Icon name={IconName.X} size={iconSize} class="share-button__icon" />
</a>

<style>
  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--share-btn-size);
    height: var(--share-btn-size);
    border-radius: var(--share-btn-radius, 25%);
    overflow: hidden;
    background: var(--c-share-btn-bg);
    color: var(--share-btn-color, #ffffff);
    transition: transform var(--dur-fast) var(--ease-out),
                opacity var(--dur-fast) var(--ease-out);
  }

  .share-button:hover {
    transform: var(--share-btn-hover-transform, translateY(-1px));
    opacity: 0.8;
  }

  .share-button :global(svg) {
    width: var(--share-icon-size, 50%);
    height: var(--share-icon-size, 50%);
    display: block;
  }
</style>
