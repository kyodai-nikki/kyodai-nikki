---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import { characters } from "../../data/characters";
import { charactersPageMsg } from "../../msg/pages/characters";

export async function getStaticPaths() {
  return characters.map((c) => ({
    params: { slug: c.slug },
    props: { character: c },
  }));
}

const { character } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout
  title={`${character.name} | Characters`}
  description={charactersPageMsg.detailDescription(character.name, character.furigana)}
>
  <PageHeading slot="page-heading" title={charactersPageMsg.title} />
  <nav slot="page-tabs" class="chars-tabs" aria-label={charactersPageMsg.tabsAriaLabel}>
    {characters.map((c) => (
      <a
        href={`${base}/characters/${c.slug}/`}
        aria-current={c.slug === character.slug ? "page" : undefined}
      >
        {c.name}
      </a>
    ))}
  </nav>

  <article class="char-detail">
    <div class="char-detail__inner">
      <div class="char-portrait">
        <img
          src={base + character.standing}
          alt={charactersPageMsg.standingAlt(character.name)}
          loading="eager"
        />
      </div>

      {character.quote && (
        <div class="char-quote" aria-label={charactersPageMsg.quoteAriaLabel}>
          {character.quote}
        </div>
      )}

      <div class="char-info">
        <header class="char-info__header">
          <h2 class="char-info__name">{character.name}</h2>
          <span class="char-info__furigana">{character.furigana}</span>
        </header>

          <p class="char-info__description">
            {character.description}
          </p>

          <dl class="char-stats">
            <div><dt>{charactersPageMsg.stats.age}</dt><dd>{character.age}</dd></div>
            <div><dt>{charactersPageMsg.stats.gender}</dt><dd>{character.gender}</dd></div>
            <div><dt>{charactersPageMsg.stats.height}</dt><dd>{character.height}</dd></div>
            <div><dt>{charactersPageMsg.stats.weight}</dt><dd>{character.weight}</dd></div>
            <div class="char-stats__birthday"><dt>{charactersPageMsg.stats.birthday}</dt><dd>{character.birthday}</dd></div>
          </dl>

          {character.externalLink && (
            <p class="char-info__external">
              ※ <a href={character.externalLink} target="_blank" rel="noopener">
                {charactersPageMsg.externalStatusLink}
              </a>
            </p>
          )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .chars-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(var(--s-5), 5vw, var(--s-8));
    padding-bottom: var(--s-3);
  }
  .chars-tabs a {
    font-family: var(--font-family-navigation);
    font-size: var(--fs-base);
    color: var(--c-fg);
    text-decoration: none;
    letter-spacing: var(--ls-wide);
    padding: var(--s-2) 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .chars-tabs a::after {
    content: "";
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: -3px;
    height: 2px;
    background: var(--c-site-cyan);
    transition: left var(--dur-base) var(--ease-out),
                right var(--dur-base) var(--ease-out);
    pointer-events: none;
  }
  .chars-tabs a:hover::after,
  .chars-tabs a:focus-visible::after {
    left: 0;
    right: 0;
  }

  .chars-tabs a[aria-current="page"]::after {
    left: 0;
    right: 0;
    background: var(--c-site-pink);
    transition: none;
  }

  .char-detail {
    max-width: 1040px;
    margin: 0 auto;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: #ffffff;
    padding: clamp(var(--s-5), 4vw, var(--s-8));
    overflow: hidden;
  }

  .char-detail__inner {
    display: grid;
    grid-template-columns: minmax(220px, 320px) auto 1fr;
    gap: clamp(var(--s-4), 3vw, var(--s-6));
    align-items: start;
  }

  .char-portrait {
    grid-column: 1;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 480px;
  }
  .char-portrait img {
    max-height: 560px;
    width: auto;
    object-fit: contain;
    display: block;
    animation: portrait-slide-in 1100ms cubic-bezier(0.16, 0.78, 0.24, 1) both;
    animation-delay: 150ms;
    will-change: opacity, transform;
  }

  @keyframes portrait-slide-in {
    from {
      opacity: 0;
      transform: translateX(-72px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .char-quote {
    grid-column: 2;
    writing-mode: vertical-rl;
    -webkit-writing-mode: vertical-rl;
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    line-height: 2.0;
    color: var(--c-fg);
    letter-spacing: 0.08em;
    white-space: pre-wrap;
    align-self: end;
    max-height: 460px;
  }

  .char-info {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-width: 0;
  }

  .char-info__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--c-border);
  }
  .char-info__name {
    font-family: var(--f-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: var(--fw-bold);
    margin: 0;
    letter-spacing: 0.04em;
  }
  .char-info__furigana {
    font-family: var(--f-serif);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    white-space: nowrap;
  }

  .char-info__description {
    margin: 0;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-border);
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    line-height: 1.9;
    color: var(--c-fg-body);
    white-space: pre-wrap;
  }

  .char-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-border);
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    color: var(--c-fg-body);
  }
  .char-stats > div {
    display: flex;
    gap: var(--s-2);
  }
  .char-stats__birthday { grid-column: 1 / -1; }
  .char-stats dt {
    color: var(--c-fg-body);
    font-weight: var(--fw-regular);
  }
  .char-stats dt::after { content: "："; }
  .char-stats dd { margin: 0; }

  .char-info__external {
    margin: 0;
    font-family: var(--f-serif);
    font-size: var(--fs-sm);
    color: var(--c-fg);
  }
  .char-info__external a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    color: var(--c-fg);
  }
  .char-info__external a:hover {
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .char-portrait img { animation: none; }
  }

  @media (max-width: 880px) {
    .char-detail__inner {
      grid-template-columns: 1fr;
    }
    .char-portrait {
      grid-column: 1;
      min-height: auto;
      justify-content: center;
    }
    .char-portrait img {
      max-height: 420px;
    }
    .char-quote {
      grid-column: 1;
      writing-mode: horizontal-tb;
      -webkit-writing-mode: horizontal-tb;
      max-height: none;
      text-align: center;
      border-top: 1px solid var(--c-border);
      border-bottom: 1px solid var(--c-border);
      padding: var(--s-4) 0;
    }
    .char-info {
      grid-column: 1;
    }
  }
</style>
