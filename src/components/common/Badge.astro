---
interface Props {
  label: string;
  variant?: "default" | "alt";
}

const { label, variant = "default" } = Astro.props;
---

<span class:list={["badge", `badge--${variant}`]}>{label}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: var(--s-1) var(--s-3);
    border-radius: 4px;
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-wide);
  }

  .badge--default {
    background: var(--c-badge-bg);
    color: var(--c-badge-fg);
  }

  .badge--alt {
    background: var(--c-badge-alt-bg);
    color: var(--c-badge-alt-fg);
  }
</style>
