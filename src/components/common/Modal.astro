---
interface Props {
  id: string;
  ariaLabel: string;
  panelClass?: string;
}

const { id, ariaLabel, panelClass = "" } = Astro.props;
---

<dialog class="modal" data-modal-root data-modal-id={id} aria-label={ariaLabel}>
  <div class:list={["modal__panel", panelClass]}>
    <button class="modal__close" type="button" aria-label="Close popup" data-modal-close>
      ×
    </button>
    <div class="modal__content">
      <slot />
    </div>
  </div>
</dialog>

<script>
  if (!window.__kyodaiModalInitialized) {
    window.__kyodaiModalInitialized = true;

    let closingDialog = null;

    const closeWithAnimation = (dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (!dialog.open || dialog.dataset.state === "closing") return;

      dialog.dataset.state = "closing";
      closingDialog = dialog;

      window.setTimeout(() => {
        if (closingDialog === dialog) {
          dialog.close();
          dialog.dataset.state = "";
          closingDialog = null;
        }
      }, 220);
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const openButton = target.closest("[data-modal-open]");
      if (openButton instanceof HTMLElement) {
        const targetId = openButton.dataset.modalOpen;
        const dialog = document.querySelector(`[data-modal-id="${targetId}"]`);
        if (dialog instanceof HTMLDialogElement) {
          dialog.dataset.state = "open";
          dialog.showModal();
        }
        return;
      }

      const closeButton = target.closest("[data-modal-close]");
      if (closeButton instanceof HTMLElement) {
        const dialog = closeButton.closest("[data-modal-root]");
        closeWithAnimation(dialog);
      }
    });

    document.addEventListener("click", (event) => {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (!dialog.matches("[data-modal-root]")) return;

      const bounds = dialog.getBoundingClientRect();
      const isBackdropClick =
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom;

      if (isBackdropClick) {
        closeWithAnimation(dialog);
      }
    });
  }
</script>

<style>
  .modal {
    width: min(900px, calc(100vw - 40px));
    max-height: calc(100dvh - 40px);
    padding: 0;
    border: 1px solid rgba(17, 17, 17, 0.75);
    background: #fff;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(56px);
    will-change: transform, opacity;
  }

  .modal::backdrop {
    background: rgba(0, 0, 0, 0.24);
  }

  .modal[open] {
    animation: modal-window-rise 280ms var(--ease-out) forwards;
  }

  .modal[open][data-state="closing"] {
    animation: modal-window-fade-out 220ms ease-out forwards;
  }

  .modal[open]::backdrop {
    animation: modal-backdrop-in 260ms ease-out forwards;
  }

  .modal[open][data-state="closing"]::backdrop {
    animation: modal-backdrop-out 220ms ease-out forwards;
  }

  .modal__panel {
    position: relative;
    max-height: calc(100dvh - 40px);
    display: flex;
    flex-direction: column;
    padding: 56px 0 48px;
  }

  .modal__content {
    min-height: 0;
    overflow: auto;
  }

  .modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    border: 0;
    background: transparent;
    color: var(--c-fg);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  @keyframes modal-backdrop-in {
    from {
      background: rgba(0, 0, 0, 0);
    }

    to {
      background: rgba(0, 0, 0, 0.24);
    }
  }

  @keyframes modal-backdrop-out {
    from {
      background: rgba(0, 0, 0, 0.24);
    }

    to {
      background: rgba(0, 0, 0, 0);
    }
  }

  @keyframes modal-window-rise {
    from {
      transform: translateY(56px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes modal-window-fade-out {
    from {
      transform: translateY(0);
      opacity: 1;
    }

    to {
      transform: translateY(28px);
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .modal {
      width: min(100vw - 20px, 680px);
    }

    .modal__panel {
      padding: 48px 0 28px;
    }
  }
</style>
