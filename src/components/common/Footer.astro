---
import ShareButtons from "./btn/ShareButtons.astro";
import { withBase } from "../../lib/urls";
import { common } from "../../msg/common";
import { siteConfig } from "../../config";

interface Props {
  shareUrl: string;
  shareTitle: string;
}

const { shareUrl, shareTitle } = Astro.props;
const site = siteConfig;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__brand">
      <img src={withBase(site.logoPath)} alt={site.name} class="site-brand__logo" />
    </div>

    <div class="site-footer__copyright">
      {common.symbol.copyLight}{site.copyStartYear}-{year} {siteConfig.teamName}
    </div>

    <div class="site-footer__share">
      <span>{common.footer.shareLabel}</span>
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 30px 0;
    border-top: 1px solid var(--c-border);
    background: var(--c-footer-bg);
    text-align: center;
  }

  .site-footer .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .site-footer__brand img {
    width: 150px;
    height: auto;
    margin-bottom: 10px;
  }

  .site-footer__copyright {
    font-family: var(--f-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-footer-copyright);
  }

  .site-footer__share {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-footer-share);
  }

  @media (--bp-tablet) {
    .site-footer {
      padding-block: 28px 18px;
    }
  }
</style>
