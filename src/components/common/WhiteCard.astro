---
interface Props {
  as?: string;
  centered?: boolean;
  hoverable?: boolean;
  translucent?: boolean;
  padding?: "default" | "none";
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = "div",
  centered = false,
  hoverable = false,
  translucent = false,
  padding = "default",
  class: className,
  ...rest
} = Astro.props;
---
<Tag class:list={[
  "white-card",
  { "white-card--centered": centered },
  { "white-card--hoverable": hoverable },
  { "white-card--translucent": translucent },
  { "white-card--padding-none": padding === "none" },
  className,
]} {...rest}>
  <slot />
</Tag>

<style>
  @keyframes white-card-slide-in {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .white-card {
    --white-card-bg: var(--c-white-card-bg);
    --white-card-border: var(--c-white-card-border);
    --white-card-hover-bg: var(--c-bg-alt);
    --white-card-hover-border: var(--c-bg-alt);
    --white-card-translucent-bg: var(--c-white-card-translucent-bg);
    --white-card-translucent-border: var(--c-white-card-translucent-border);

    background: var(--white-card-bg);
    border: 1px solid var(--white-card-border-color, var(--white-card-border));
    border-radius: var(--r-md);
    padding: clamp(var(--s-6), 5vw, var(--s-8)) clamp(var(--s-5), 6vw, var(--s-9));
    transition:
      background-color 180ms var(--ease-out),
      border-color 180ms var(--ease-out);
    animation: white-card-slide-in 1700ms var(--ease-out) both;
    animation-delay: 160ms;
    will-change: opacity, transform;
  }

  .white-card--hoverable:hover,
  .white-card--hoverable:focus-within {
    background: var(--white-card-hover-bg);
    border-color: var(--white-card-hover-border);
  }

  .white-card--padding-none {
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .white-card { animation: none; }
  }

  .white-card--translucent {
    background: var(--white-card-translucent-bg);
    border-color: var(--white-card-translucent-border);
    border-radius: var(--r-md);
  }

  .white-card--centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 28px;
    min-height: 250px;
  }

  @media (--bp-tablet) {
    .white-card--centered {
      gap: 20px;
    }
  }
</style>
