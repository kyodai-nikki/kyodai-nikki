---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageCardFrame from "../../components/common/ImageCardFrame.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import GalleryMediaModal from "../../components/gallery/GalleryMediaModal.astro";
import { displayedGalleryImages, galleryPicture, gallerySrc } from "../../lib/gallery";
import {
  galleryDetailImages,
  galleryModalDescription,
  galleryModalTitle,
} from "../../lib/view/gallery";
import { commonMsg } from "../../msg/common";
import { galleryPageMsg } from "../../msg/gallery";
import { navigation } from "../../data/navigation";

const displayedImages = await displayedGalleryImages();
---
<BaseLayout
  title={navigation.gallery.title}
  description={galleryPageMsg.meta.description}
  bodyClass="gallery-page"
  pageSectionClass="gallery"
>
  <PageHeading slot="page-heading" title={navigation.gallery.title} />

  {displayedImages.length === 0 ? (
    <p class="gallery__empty">
      {galleryPageMsg.empty.list}
    </p>
  ) : (
    <>
      <div class="gallery-grid" aria-label={galleryPageMsg.aria.list}>
        {displayedImages.map((entry, index) => {
          const img = entry.data;
          const modalId = `gallery-modal-${index}`;
          const modalTitle = galleryModalTitle(entry);
          const picture = galleryPicture(entry);
          const fallbackSrc = picture?.fallback ?? gallerySrc(entry);

          return (
            <button
              class="gallery-card"
              type="button"
              aria-label={commonMsg.actions.open(modalTitle)}
              data-modal-open={modalId}
              style={{ "--delay": `${index * 30}ms` }}
            >
              <ImageCardFrame aspectRatio="4 / 2.35" mobileAspectRatio="4 / 2.7">
                <picture>
                  {picture?.webp && (
                    <source type="image/webp" srcset={picture.webp} />
                  )}
                  <img
                    src={fallbackSrc}
                    alt={img.alt}
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="376"
                  />
                </picture>
              </ImageCardFrame>
            </button>
          );
        })}
      </div>

      {displayedImages.map((entry, index) => {
        const img = entry.data;
        const modalId = `gallery-modal-${index}`;
        const modalTitle = galleryModalTitle(entry);
        const modalDescription = galleryModalDescription(entry);
        // 詳細画像は WebP（medium / large）があれば srcset で 1x/2x を割り当てる。
        // モーダルが開いた瞬間の転送量を抑え、原寸 PNG/JPG への直接フェッチを避ける。
        const detailSrcs = galleryDetailImages(entry).map((image) => {
          const srcsetParts: string[] = [];
          if (image.mediumWebp) srcsetParts.push(`${image.mediumWebp} 1x`);
          if (image.largeWebp) srcsetParts.push(`${image.largeWebp} 2x`);
          return {
            src: image.src,
            alt: image.alt,
            webpSrcset: srcsetParts.length > 0 ? srcsetParts.join(", ") : undefined,
          };
        });

        return (
          <GalleryMediaModal
            id={modalId}
            title={modalTitle}
            description={modalDescription}
            images={detailSrcs}
            creditName={img.creditName}
            creditUrl={img.creditUrl}
            twitterId={img.twitterId}
          />
        );
      })}
    </>
  )}
</BaseLayout>

<style>
  .gallery {
    --gallery-empty-fg: var(--c-fg-muted);
    --gallery-empty-bg: var(--c-white-card-translucent-bg);
    --gallery-empty-border: var(--c-border);

    padding-top: 20px;
    padding-bottom: 72px;
  }

  .gallery__empty {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-6);
    text-align: center;
    color: var(--gallery-empty-fg);
    background: var(--gallery-empty-bg);
    border: 1px solid var(--gallery-empty-border);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 24px;
  }

  .gallery-card {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transform: translateY(12px);
    opacity: 0;
    animation: gallery-in 500ms var(--ease-out) forwards;
    animation-delay: var(--delay);
  }

  @keyframes gallery-in {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (--bp-tablet) {
    .gallery {
      padding-bottom: 56px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

</style>
