---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import CharacterTabs from "../../components/characters/CharacterTabs.astro";
import CharacterPortrait from "../../components/characters/CharacterPortrait.astro";
import CharacterQuote from "../../components/characters/CharacterQuote.astro";
import CharacterInfoHeader from "../../components/characters/CharacterInfoHeader.astro";
import CharacterStats from "../../components/characters/CharacterStats.astro";
import CharacterExternalLinks from "../../components/characters/CharacterExternalLinks.astro";
import {
  orderedCharacters,
  type CharacterEntry,
} from "../../lib/characters";
import { getCharacterStaticPaths } from "../../lib/routes/characters";
import { charactersPageMsg } from "../../msg/characters";
import { navigation } from "../../data/navigation";

export const getStaticPaths = getCharacterStaticPaths;

const { character } = Astro.props as { character: CharacterEntry };
const characters = await orderedCharacters();
const hasQuote = Boolean(character.data.quote);
---
<BaseLayout
  title={charactersPageMsg.meta.detailTitle(character.data.name)}
  description={charactersPageMsg.meta.detailDescription(character.data.name, character.data.nameKana)}
>
  <PageHeading slot="page-heading" title={navigation.characters.title} />
  <CharacterTabs slot="page-tabs" characters={characters} currentId={character.id} />

  <article class:list={["char-detail", !hasQuote && "char-detail--no-quote"]}>
    <div class="char-detail__inner">
      {hasQuote && (
        <CharacterQuote quote={character.data.quote} class="char-detail__quote" />
      )}
      <CharacterPortrait character={character} class="char-detail__portrait" />

      <div class="char-info">
        <CharacterInfoHeader name={character.data.name} nameKana={character.data.nameKana} />

        <p class="char-info__description">
          {character.data.description}
        </p>

        <CharacterStats character={character} />

        <CharacterExternalLinks links={character.data.externalLinks} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .char-detail {
    max-width: 1000px;
    margin: 0 auto;
    border: 1px solid var(--c-fg);
    border-radius: var(--r-md);
    background: #ffffff;
    padding: 0 90px;
    overflow: hidden;
  }

  .char-detail__inner {
    position: relative;
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    justify-content: end;
    gap: 0;
    align-items: start;
  }

  /* 各グリッドアイテムの位置はページ側で決める。
     CharacterPortrait / CharacterQuote の見た目自体はコンポーネント内に閉じる。
     並び順: 台詞 → 立ち絵 → 情報 */
  :global(.char-detail__quote) {
    position: absolute;
    inset: auto auto 40px -60px;
    transform-origin: left bottom;
    z-index: 1;
  }

  :global(.char-detail__portrait) { grid-column: 1; }

  .char-detail--no-quote .char-detail__inner {
    grid-template-columns: 270px minmax(0, 1fr);
  }

  .char-detail--no-quote :global(.char-detail__portrait) {
    grid-column: 1;
  }

  .char-detail--no-quote .char-info {
    grid-column: 2;
    padding-top: clamp(var(--s-6), 6vw, var(--s-8));
  }

  .char-info {
    grid-column: 2;
    padding: 50px 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-width: 0;
    width: 100%;
    max-width: 550px;
  }

  .char-info__description {
    margin: 0;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-fg);
    font-family: var(--f-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--c-fg-body);
    white-space: pre-wrap;
  }

  @media (--bp-tablet) {
    .char-detail {
      padding: 0 20px;
    }

    .char-detail__inner,
    .char-detail--no-quote .char-detail__inner {
      grid-template-columns: 245px minmax(0, 1fr);
    }

    :global(.char-detail__portrait) {
      margin-left: -25px;
    }

    :global(.char-detail__quote) {
      inset: auto auto 40px -15px;
    }

    .char-info {
      padding: 20px 0;
    }
  }

  @media (--bp-mobile) {
    .char-detail__inner,
    .char-detail--no-quote .char-detail__inner {
      grid-template-columns: 120px minmax(0, 1fr);
    }

    :global(.char-detail__portrait) {
      margin-left: -45px;
    }

    .char-info__description {
      font-size: 12px;
    }
  }
</style>
