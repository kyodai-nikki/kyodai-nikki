---
import type { EpisodeLogSection } from "../../../lib/episodes/logs";
import { commonMsg } from "../../../msg/common";
import { episodesPageMsg } from "../../../msg/episodes";

interface Props {
  overviewHref: string;
  showNextButton: boolean;
  nextHref?: string;
  showPreviousButton: boolean;
  previousHref?: string;
  sections: EpisodeLogSection[];
}

const {
  overviewHref,
  showNextButton,
  nextHref,
  showPreviousButton,
  previousHref,
  sections,
} = Astro.props;
---

<aside class="episode-log__sidebar" aria-label={episodesPageMsg.logNavigation}>
  <a class="episode-log__button episode-log__button--primary" href={overviewHref}>
    {commonMsg.actions.backToOverview}
  </a>
  {showNextButton && nextHref && (
    <a class="episode-log__button" href={nextHref}>{commonMsg.actions.nextEpisode}</a>
  )}
  {showPreviousButton && previousHref && (
    <a class="episode-log__button" href={previousHref}>{commonMsg.actions.previousEpisode}</a>
  )}
  {sections.map((section) => (
    <a class="episode-log__button" href={`#${section.anchor}`}>{section.label}</a>
  ))}
</aside>

<style>
  .episode-log__sidebar {
    position: sticky;
    top: calc(var(--h-header-top) + var(--h-header-nav) + var(--s-5));
    display: grid;
    gap: 16px;
  }

  .episode-log__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 0 18px;
    border: 1px solid #2d2d2d;
    background: rgba(255, 255, 255, 0.95);
    color: #111111;
    font-family: var(--font-family-navigation);
    font-size: 1.05rem;
    line-height: 1.2;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .episode-log__button:hover {
    background: #232323;
    border-color: #232323;
    color: #ffffff;
  }

  .episode-log__button--primary {
    background: #2f2f2f;
    border-color: #2f2f2f;
    color: #ffffff;
  }

  @media (max-width: 960px) {
    .episode-log__sidebar {
      position: static;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .episode-log__sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>
