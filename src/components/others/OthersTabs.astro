---
import Tabs from "../common/Tabs.astro";
import { OTHERS_SECTIONS, type OthersSectionSlug } from "../../data/othersSections";
import { othersPageMsg } from "../../msg/others";

interface Props {
  currentSection: OthersSectionSlug;
}

const { currentSection } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const items = OTHERS_SECTIONS.map((section) => ({
  label: section.label,
  href: `${base}${section.href}`,
  active: section.slug === currentSection,
}));
---

<Tabs items={items} ariaLabel={othersPageMsg.tabsAriaLabel} size="lg" />
