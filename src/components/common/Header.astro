---
import { getCollection } from "astro:content";
import { defaultOthersPath } from "../../data/othersSections";
import { commonMsg } from "../../msg/common";

const [commonEntry] = await getCollection("common");
if (!commonEntry) {
  throw new Error("Missing common content");
}
const othersPath = defaultOthersPath();
const site = commonEntry.data;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base.replace(/\/$/, "")}${p}`;
const path = Astro.url.pathname;

const items = [
  { href: "/news", label: "News" },
  { href: "/introduction", label: "Introduction" },
  { href: "/characters", label: "Characters" },
  { href: "/episodes/season1/1", label: "Episodes" },
  { href: "/gallery", label: "Gallery" },
  { href: "/movies", label: "Movies" },
  { href: "/goods", label: "Goods" },
  { href: othersPath, label: "Others" },
];

const isCurrent = (href: string) => {
  const full = withBase(href);
  return full === "/" ? path === base : path.startsWith(full);
};
---
<header class="site-header">
  <div class="container site-header__top">
    <a class="site-brand" href={base}>
      {site.name}
      <span class="site-brand__tag">{site.nameEn}</span>
    </a>

    <div class="site-social">
      {site.social.twitter && (
        <a href={site.social.twitter} target="_blank" rel="noopener" aria-label={commonMsg.social.officialX}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2H21.5l-7.51 8.58L23 22h-6.828l-5.34-6.98L4.8 22H1.54l8.03-9.175L1 2h6.914l4.83 6.384L18.244 2Zm-2.394 18h1.89L7.24 4h-2.02l10.63 16Z"/>
          </svg>
        </a>
      )}

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={commonMsg.menu.open}
      >
        Menu
      </button>
    </div>
  </div>

  <div class="site-header__nav">
    <nav id="site-nav" class="site-nav container" aria-label={commonMsg.menu.navigation}>
      {items.map((item) => (
        <a
          href={withBase(item.href)}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
