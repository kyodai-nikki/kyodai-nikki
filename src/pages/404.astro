---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/common/PageHeading.astro";
import { withBase } from "../lib/urls";
import { notFoundPageMsg } from "../msg/notFound";
---
<BaseLayout title={notFoundPageMsg.title} pageContainerClass="container--narrow">
  <PageHeading slot="page-heading" title={notFoundPageMsg.heading} eyebrow="404" />
  <div style="text-align: center;">
    <p style="color: var(--c-fg-muted);">
      {notFoundPageMsg.description}
    </p>
    <p><a href={withBase("/")}>{notFoundPageMsg.redirectToTop}</a></p>
  </div>
</BaseLayout>
