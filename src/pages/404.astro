---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/common/PageHeading.astro";
import { notFoundPageMsg } from "../msg/pages/notFound";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title={notFoundPageMsg.title}>
  <section class="section container container--narrow" style="text-align: center;">
    <PageHeading title={notFoundPageMsg.heading} eyebrow="404" />
    <p style="color: var(--c-fg-muted);">
      {notFoundPageMsg.description}
    </p>
    <p><a href={`${base}/`}>{notFoundPageMsg.backToTop}</a></p>
  </section>
</BaseLayout>
