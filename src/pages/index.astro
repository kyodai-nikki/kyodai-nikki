---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { basePath } from "../lib/urls";
import { commonMsg } from "../msg/common";
import { homePageMsg } from "../msg/home";

const [homeEntry] = await getCollection("home");
const [commonEntry] = await getCollection("common");
if (!homeEntry) {
  throw new Error("Missing home content");
}
if (!commonEntry) {
  throw new Error("Missing common content");
}
const home = homeEntry.data;
const site = commonEntry.data;
---
<BaseLayout
  title={homePageMsg.title}
  description={homePageMsg.description}
  bodyClass="is-home"
>
  <section class="home" aria-label={homePageMsg.homeAriaLabel}>
    <div
      class="home__image"
      style={`background-image: url('${basePath}${home.image}');`}
      role="img"
      aria-label={home.imageCredit || homePageMsg.homeFallbackImageLabel}
    ></div>
    <div class="home__overlay">
      <div class="home__copyline">ﾂｩ{site.copyStartYear}-{new Date().getFullYear()} {site.name}{commonMsg.footer.madeByTeam}</div>
      <div class="home__share">
        {commonMsg.footer.shareLabel}
        <span aria-hidden="true">{commonMsg.symbol.dot}</span>
      </div>
      <h1 class="home__title">{home.title}</h1>
      <p class="home__tagline">
        <span>{home.startDate}</span><br />
        <span>{home.status}</span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    position: relative;
    width: 100%;
    min-height: min(92vh, 900px);
    overflow: hidden;
    background: #eef1f4;
  }

  .home__image {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .home__overlay {
    position: relative;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: var(--s-7) var(--s-6);
    min-height: inherit;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--s-5);
    row-gap: var(--s-2);
  }

  .home__copyline {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    text-align: right;
  }

  .home__share {
    grid-column: 2;
    grid-row: 2;
    font-family: var(--f-sans);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    letter-spacing: var(--ls-wide);
    text-align: right;
  }

  .home__title {
    grid-column: 2;
    grid-row: 3;
    align-self: start;
    justify-self: end;
    font-family: var(--f-serif);
    font-weight: var(--fw-black);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--c-fg);
    margin: var(--s-3) 0 var(--s-3);
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .home__tagline {
    grid-column: 2;
    grid-row: 4;
    justify-self: end;
    text-align: right;
    font-family: var(--f-serif);
    font-size: var(--fs-base);
    color: var(--c-fg);
    line-height: 1.8;
    margin: 0;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 640px) {
    .home {
      min-height: min(70vh, 640px);
    }

    .home__overlay {
      padding: var(--s-5) var(--s-4);
      grid-template-columns: 1fr;
    }

    .home__copyline,
    .home__share,
    .home__title,
    .home__tagline {
      grid-column: 1;
      text-align: left;
      justify-self: start;
    }

    .home__title {
      font-size: clamp(2rem, 10vw, 3rem);
    }
  }
</style>
