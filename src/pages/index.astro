---
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { imageAllSrcs, imageMaxHeight } from "../lib/image-utils";
import { withBase } from "../lib/urls";
import { homePageMsg } from "../msg/home";
import { siteConfig } from "../config";
import Tagline from "../content/home.md";

// Slideshow is intentionally off for now. Match the hero area to home.png's
// original height while keeping the slideshow path ready for future use.
const HOME_IMAGE_URL = "/images/home/home.png";
const HOME_IMAGE_URL_BASE = "/images/home";
const HOME_IMAGE_HEIGHT_PX = 2000;
const slideshowDir = resolve(process.cwd(), "public/images/home");
const slideshowImages = siteConfig.enableSlideshow
  ? imageAllSrcs(slideshowDir, HOME_IMAGE_URL_BASE)
  : [];
const slideImages = slideshowImages.length > 0
  ? slideshowImages
  : [withBase(HOME_IMAGE_URL)];
const maxImageHeight = siteConfig.enableSlideshow
  ? await imageMaxHeight(slideshowDir)
  : HOME_IMAGE_HEIGHT_PX;
const slideHeightPx = maxImageHeight ?? HOME_IMAGE_HEIGHT_PX;
---
<BaseLayout
  title={homePageMsg.meta.title}
  description={homePageMsg.meta.description}
  bodyClass="is-home"
>
  <section
    class="home"
    style={`--home-image-height: ${slideHeightPx}px;`}
    aria-label={homePageMsg.aria.homeVisual}
  >
    <div
      class="home__image"
      role="img"
      aria-label={homePageMsg.alt.homeFallbackImage}
    >
      {slideImages.map((src, i) => (
        <div
          class:list={["home__slide", i === 0 && "is-visible"]}
          data-index={i}
        >
          <img src={src} alt="" />
        </div>
      ))}
    </div>
    <div class="home__overlay">
      <img src={withBase(siteConfig.logoPath)} alt={siteConfig.name} class="site-brand__logo" />
      <div class="home__tagline"><Tagline /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    --home-bg: var(--bc-gray-lightest);
    --home-tagline-fg: var(--c-fg);
    --home-tagline-shadow: 0 1px 0 rgb(from var(--bc-white) r g b / 0.6);
    --home-tagline-shadow-strong: 0 0 10px var(--c-bg);

    position: relative;
    width: 100%;
    background: var(--home-bg);
  }

  .home__image {
    display: grid;
    width: 100%;
    height: var(--home-image-height, 800px);
    overflow: hidden;
  }

  .home__slide {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .home__slide.is-visible {
    opacity: 1;
  }

  .home__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .home__overlay {
    position: absolute;
    inset: 0;
    width: 100vw;
    max-width: none;
    margin-inline: auto;
    padding: var(--s-6) 100px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--s-5);
    row-gap: var(--m-l30);
  }

  .home__overlay img {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: 450px;
    height: auto;
  }

  .home__tagline {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    text-align: left;
    font-family: var(--font-family-base);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--home-tagline-fg);
    line-height: 1.8;
    text-shadow: var(--home-tagline-shadow);
  }

  .home__tagline :global(p) {
    font-size: 32px;
    margin: 0;
    white-space: pre-wrap;
  }

  @media (--bp-tablet) {
    .home__image {
      height: calc(100svh - var(--h-header-tablet) - var(--h-home-tablet-peek));
    }

    .home__overlay {
      padding: var(--s-5) var(--s-4) var(--s-8);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: var(--m-l30);
    }

    .home__overlay img {
      width: min(var(--w-home-logo-tablet), 100%);
      height: var(--h-home-logo-tablet);
      object-fit: contain;
    }

    .home__tagline {
      text-align: center;
      text-shadow: var(--home-tagline-shadow-strong);
    }

    .home__tagline :global(p) {
      font-size: var(--fs-home-tagline-tablet);
    }
  }

  @media (--bp-mobile) {
    .home__image {
      height: calc(100svh - var(--h-header-tablet) - var(--h-home-mobile-peek));
    }

    .home__overlay img {
      width: min(var(--w-home-logo-mobile), 100%);
      height: var(--h-home-logo-mobile);
      object-fit: contain;
    }

    .home__tagline :global(p) {
      font-size: var(--fs-home-tagline-mobile);
    }
  }
</style>

<script>
  import { siteConfig } from "../config";
  import { onPageLoad } from "../scripts/onPageLoad";

  onPageLoad("home-slideshow", ({ signal }) => {
    const slides = document.querySelectorAll<HTMLElement>(".home__slide");
    if (slides.length <= 1) return;

    slides.forEach((slide, index) => {
      slide.classList.toggle("is-visible", index === 0);
    });

    let current = 0;
    const slideshowTimer = window.setInterval(() => {
      slides[current].classList.remove("is-visible");
      current = (current + 1) % slides.length;
      slides[current].classList.add("is-visible");
    }, siteConfig.slideshowTimeout);

    signal.addEventListener("abort", () => window.clearInterval(slideshowTimer), { once: true });
  });
</script>
