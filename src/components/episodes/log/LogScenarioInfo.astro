---
import type { EpisodeScenarioInfo } from "../../../data/episodes/logs";
import { episodesPageMsg } from "../../../msg/pages/episodes";

interface Props {
  title: string;
  episodeNumberLabel: string;
  badges: string[];
  scenario?: EpisodeScenarioInfo;
}

const { title, episodeNumberLabel, badges, scenario } = Astro.props;
const castLabel = scenario?.participants?.length ? scenario.participants.join("・") : undefined;
const writerLabel = scenario?.author;
const sourceLabel = scenario?.distributionName;
---

<header class="episode-log__panel-head">
  <div class="episode-log__title-row">
    <div class="episode-log__title-group">
      <h2 class="episode-log__title">{title}</h2>
      <p class="episode-log__episode-no">{episodeNumberLabel}</p>
    </div>

    {badges.length > 0 && (
      <div class="episode-log__badge-list">
        {badges.map((badge) => (
          <span class="episode-log__badge">{badge}</span>
        ))}
      </div>
    )}
  </div>

  <dl class="episode-log__meta-lines">
    {(scenario?.inStoryDate || castLabel) && (
      <div class="episode-log__meta-line">
        {scenario?.inStoryDate && (
          <div class="episode-log__meta-inline">
            <dt>Date :</dt>
            <dd>{scenario.inStoryDate}</dd>
          </div>
        )}
        {castLabel && <dd class="episode-log__meta-free">{castLabel}</dd>}
      </div>
    )}

    {(writerLabel || sourceLabel) && (
      <div class="episode-log__meta-line">
        {writerLabel && (
          <div class="episode-log__meta-inline">
            <dt>{episodesPageMsg.logInfo.scenarioAuthor}</dt>
            <dd>{writerLabel}</dd>
          </div>
        )}
        {sourceLabel && (
          <div class="episode-log__meta-inline">
            <dt>{episodesPageMsg.logInfo.scenarioDistribution}</dt>
            <dd>
              {scenario?.distributionUrl ? (
                <a href={scenario.distributionUrl} target="_blank" rel="noopener">
                  {sourceLabel}
                </a>
              ) : (
                sourceLabel
              )}
            </dd>
          </div>
        )}
      </div>
    )}

    {scenario?.isAdapted && (
      <div class="episode-log__meta-line">
        <div class="episode-log__meta-inline">
          <dt>{episodesPageMsg.logInfo.adaptedScenario}</dt>
          <dd>
            {scenario.adaptedScenarioUrl ? (
              <a href={scenario.adaptedScenarioUrl} target="_blank" rel="noopener">
                {episodesPageMsg.logInfo.adaptedScenarioLink}
              </a>
            ) : (
              episodesPageMsg.logInfo.yes
            )}
          </dd>
        </div>
      </div>
    )}
  </dl>
</header>

<style>
  .episode-log__panel-head {
    margin-bottom: 30px;
  }

  .episode-log__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid #2d2d2d;
  }

  .episode-log__title-group {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
  }

  .episode-log__title {
    margin: 0;
    font-family: var(--font-family-log-heading);
    font-size: clamp(2rem, 3vw, 2.7rem);
    font-weight: var(--fw-regular);
    line-height: 1.15;
  }

  .episode-log__episode-no {
    margin: 0;
    font-family: var(--font-family-log-heading);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: #202020;
  }

  .episode-log__badge-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .episode-log__badge {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    background: #2f2f2f;
    color: #ffffff;
    font-family: var(--f-sans);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
  }

  .episode-log__meta-lines {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .episode-log__meta-line {
    display: flex;
    align-items: baseline;
    gap: 30px;
    padding: 6px 0;
    border-bottom: 1px solid #2d2d2d;
    font-family: var(--font-family-log-body);
    font-size: 1rem;
    line-height: 1.5;
  }

  .episode-log__meta-inline {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .episode-log__meta-line dt,
  .episode-log__meta-line dd,
  .episode-log__meta-free {
    margin: 0;
    color: #111111;
  }

  .episode-log__meta-line a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  @media (max-width: 720px) {
    .episode-log__title-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .episode-log__title-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .episode-log__badge-list {
      justify-content: flex-start;
    }

    .episode-log__meta-line {
      gap: 12px;
      flex-wrap: wrap;
    }
  }
</style>
