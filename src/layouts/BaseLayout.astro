---
import { ClientRouter } from "astro:transitions";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import BackToTop from "../components/common/BackToTop.astro";
import EpisodeSpoilerNotice from "../components/episodes/EpisodeSpoilerNoticeModal.astro";
import { commonMsg } from "../msg/common";
import { siteConfig } from "../config";
import { withBase } from "../lib/urls";

import "../../styles/variables.css";
import "../../styles/globals.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  pageSectionClass?: string;
  pageContainerClass?: string;
}

const {
  title,
  description = commonMsg.site.defaultDescription,
  ogImage = withBase("/logo.png"),
  bodyClass = "",
  pageSectionClass = "",
  pageContainerClass = "",
} = Astro.props;

const siteName = siteConfig.name;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost");
const episodesPath = withBase("/episodes");
const pageShellBgImage = `url("${withBase("/images/bg.png")}")`;
const showEpisodeSpoilerNotice =
  Astro.url.pathname === episodesPath || Astro.url.pathname.startsWith(`${episodesPath}/`);
const hasPageTabs = Astro.slots.has("page-tabs");
const hasPageShell =
  Astro.slots.has("page-heading")
  || hasPageTabs
  || pageSectionClass.length > 0
  || pageContainerClass.length > 0;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="visually-hidden">{commonMsg.accessibility.skipToMain}</a>
    <Header />
    <div class="site-menu-backdrop" aria-hidden="true"></div>
    <main id="main" data-page-shell style={`--page-shell-bg-image: ${pageShellBgImage};`}>
      {showEpisodeSpoilerNotice && <EpisodeSpoilerNotice topHref={withBase("/")} />}
      {hasPageShell ? (
        <section class:list={["section", pageSectionClass]}>
          <div class:list={["container", pageContainerClass]}>
            <slot name="page-heading" />
            {hasPageTabs && (
              <div class="page-shell__tabs">
                <slot name="page-tabs" />
              </div>
            )}
            <slot />
          </div>
        </section>
      ) : (
        <slot />
      )}
    </main>
    <Footer shareUrl={canonical.href} shareTitle={fullTitle} />
    <BackToTop />

    <style>
      .site-menu-backdrop {
        display: none;
      }

      @media (--bp-laptop) {
        .site-menu-backdrop {
          display: block;
          position: fixed;
          inset: 0;
          background: rgba(17, 17, 17, 0.24);
          opacity: 0;
          pointer-events: none;
          transition: opacity var(--dur-base) var(--ease-out);
          z-index: 999;
        }

        .site-menu-backdrop[data-open="true"] {
          opacity: 1;
          pointer-events: auto;
        }
      }
    </style>

    <script>
      const setupNavigation = () => {
        const btn = document.querySelector<HTMLButtonElement>(".nav-toggle");
        const nav = document.querySelector<HTMLElement>(".site-nav");
        const backdrop = document.querySelector<HTMLElement>(".site-menu-backdrop");
        if (!btn || !nav || btn.dataset.initialized === "true") return;

        btn.dataset.initialized = "true";
        const labelOpen = btn.dataset.labelOpen ?? btn.getAttribute("aria-label") ?? "";
        const labelClose = btn.dataset.labelClose ?? labelOpen;

        const setOpen = (open: boolean) => {
          nav.dataset.open = open.toString();
          if (backdrop) backdrop.dataset.open = open.toString();
          btn.setAttribute("aria-expanded", open.toString());
          btn.setAttribute("aria-label", open ? labelClose : labelOpen);
          document.body.toggleAttribute("data-nav-open", open);
        };

        btn.addEventListener("click", () => {
          setOpen(nav.dataset.open !== "true");
        });

        nav.addEventListener("click", (event) => {
          if (event.target instanceof HTMLAnchorElement) setOpen(false);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setOpen(false);
        });

        document.addEventListener("pointerdown", (event) => {
          if (nav.dataset.open !== "true" || !(event.target instanceof Node)) return;
          if (nav.contains(event.target) || btn.contains(event.target)) return;
          setOpen(false);
        });

        window.addEventListener("resize", () => {
          if (window.matchMedia("(min-width: 1025px)").matches) setOpen(false);
        });
      };

      setupNavigation();
      document.addEventListener("astro:page-load", setupNavigation);
    </script>
  </body>
</html>
