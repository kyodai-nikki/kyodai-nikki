---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ShareButtons from "../../../../components/common/btn/ShareButtons.astro";
import {
  allEpisodes,
  episodeHref,
  episodeUrlSlug,
  episodesBySeason,
  seasons,
  type EpisodeEntry,
} from "../../../../data/episodes";
import {
  episodeLogContentId,
  episodeLogSectionOrder,
  episodeLogSectionsFromEntries,
  hasAnyEpisodeLog,
  type EpisodeLogSectionKey,
} from "../../../../data/episodeLogs";
import { getEpisodeLogOverride } from "../../../../data/episodeLogOverrides";

export async function getStaticPaths() {
  const logEntries = await getCollection("episodeLogs");
  const logIds = new Set(logEntries.map((entry) => entry.id));

  return allEpisodes()
    .filter(({ season, episode }) =>
      hasAnyEpisodeLog(season.slug, episodeUrlSlug(episode), logIds),
    )
    .map(({ season, episode }) => ({
      params: {
        season: season.slug,
        slug: episodeUrlSlug(episode),
      },
      props: {
        episode,
        seasonNumber: season.number,
      },
    }));
}

interface Props {
  episode: EpisodeEntry;
  seasonNumber: 1 | 2 | 3 | 4;
}

const { episode, seasonNumber } = Astro.props as Props;
const seasonInfo = seasons.find((s) => s.number === seasonNumber)!;
const episodeSlug = episodeUrlSlug(episode);
const logEntries = await getCollection("episodeLogs");
const entryIds = new Set(logEntries.map((entry) => entry.id));

const sectionEntries = Object.fromEntries(
  await Promise.all(
    episodeLogSectionOrder.map(async (key) => {
      const entryId = episodeLogContentId(seasonInfo.slug, episodeSlug, key);

      if (!entryIds.has(entryId)) {
        return [key, undefined];
      }

      return [key, await getEntry("episodeLogs", entryId)];
    }),
  ),
) as Partial<Record<EpisodeLogSectionKey, Awaited<ReturnType<typeof getEntry<"episodeLogs">>>>>;

const sections = episodeLogSectionsFromEntries(seasonInfo.slug, episodeSlug, sectionEntries);

if (sections.length === 0) {
  throw new Error(`Missing episode log content: ${seasonInfo.slug}/${episodeSlug}`);
}

const renderedSections = await Promise.all(
  sections.map(async (section) => ({
    section,
    rendered: await render(sectionEntries[section.key]!),
  })),
);

const overrides = getEpisodeLogOverride(seasonInfo.slug, episodeSlug);
const scenario = overrides.scenario ?? episode.scenario;
const logMeta = { ...episode.log, ...overrides.log };
const overviewHref = episodeHref(seasonInfo.slug, episode);

const seasonEpisodes = episodesBySeason(seasonNumber);
const logEntriesBySeason = seasonEpisodes.filter((item) =>
  hasAnyEpisodeLog(seasonInfo.slug, episodeUrlSlug(item), entryIds),
);
const currentIndex = logEntriesBySeason.findIndex(
  (item) => item.overallNumber === episode.overallNumber,
);
const previousEpisode =
  currentIndex > 0 ? logEntriesBySeason[currentIndex - 1] : undefined;
const nextEpisode =
  currentIndex >= 0 && currentIndex < logEntriesBySeason.length - 1
    ? logEntriesBySeason[currentIndex + 1]
    : undefined;

const previousHref = previousEpisode
  ? `${episodeHref(seasonInfo.slug, previousEpisode)}/log`
  : undefined;
const nextHref = nextEpisode ? `${episodeHref(seasonInfo.slug, nextEpisode)}/log` : undefined;
const showPreviousButton = Boolean(logMeta.showPreviousEpisode && previousHref);
const showNextButton = Boolean(logMeta.showNextEpisode && nextHref);

const mainSection = sectionEntries.main;
const pageDescription =
  mainSection?.data.description ?? episode.description.split("\n")[0] ?? episode.title;

const episodeNumberLabel = `Episode${String(episode.seasonEpisodeNumber ?? 0).padStart(2, "0")}`;
const badges = [
  episode.isR18G ? "R-18G" : undefined,
  episode.isR18 && !episode.isR18G ? "R-18" : undefined,
  scenario?.removeCanon ? "削除史実" : undefined,
].filter(Boolean) as string[];
const castLabel = scenario?.participants?.length ? scenario.participants.join("・") : undefined;
const writerLabel = scenario?.author;
const sourceLabel = scenario?.distributionName;
---

<BaseLayout
  title={`${episode.title} Log | ${seasonInfo.label} | Episodes`}
  description={pageDescription}
  bodyClass="episode-log-page"
>
  <section class="section container episode-log">
    <header class="episode-log__page-head">
      <h1 class="episode-log__page-title">Episodes</h1>
    </header>

    <div class="episode-log__layout">
      <aside class="episode-log__sidebar" aria-label="ログナビゲーション">
        <a class="episode-log__button episode-log__button--primary" href={overviewHref}>
          概要に戻る
        </a>
        {showNextButton && nextHref && (
          <a class="episode-log__button" href={nextHref}>次の話</a>
        )}
        {showPreviousButton && previousHref && (
          <a class="episode-log__button" href={previousHref}>前の話</a>
        )}
        {sections.map((section) => (
          <a class="episode-log__button" href={`#${section.anchor}`}>{section.label}</a>
        ))}
      </aside>

      <div class="episode-log__main">
        <section class="episode-log__panel">
          <header class="episode-log__panel-head">
            <div class="episode-log__title-row">
              <div class="episode-log__title-group">
                <h2 class="episode-log__title">{episode.title}</h2>
                <p class="episode-log__episode-no">{episodeNumberLabel}</p>
              </div>

              {badges.length > 0 && (
                <div class="episode-log__badge-list">
                  {badges.map((badge) => (
                    <span class="episode-log__badge">{badge}</span>
                  ))}
                </div>
              )}
            </div>

            <dl class="episode-log__meta-lines">
              {(scenario?.inStoryDate || castLabel) && (
                <div class="episode-log__meta-line">
                  {scenario?.inStoryDate && (
                    <div class="episode-log__meta-inline">
                      <dt>Date :</dt>
                      <dd>{scenario.inStoryDate}</dd>
                    </div>
                  )}
                  {castLabel && <dd class="episode-log__meta-free">{castLabel}</dd>}
                </div>
              )}

              {(writerLabel || sourceLabel) && (
                <div class="episode-log__meta-line">
                  {writerLabel && (
                    <div class="episode-log__meta-inline">
                      <dt>シナリオ制作者 :</dt>
                      <dd>{writerLabel}</dd>
                    </div>
                  )}
                  {sourceLabel && (
                    <div class="episode-log__meta-inline">
                      <dt>シナリオ頒布先 :</dt>
                      <dd>
                        {scenario?.distributionUrl ? (
                          <a href={scenario.distributionUrl} target="_blank" rel="noopener">
                            {sourceLabel}
                          </a>
                        ) : (
                          sourceLabel
                        )}
                      </dd>
                    </div>
                  )}
                </div>
              )}

              {scenario?.isAdapted && (
                <div class="episode-log__meta-line">
                  <div class="episode-log__meta-inline">
                    <dt>改変シナリオ :</dt>
                    <dd>
                      {scenario.adaptedScenarioUrl ? (
                        <a href={scenario.adaptedScenarioUrl} target="_blank" rel="noopener">
                          原案へのリンク
                        </a>
                      ) : (
                        "あり"
                      )}
                    </dd>
                  </div>
                </div>
              )}
            </dl>
          </header>

          <article class="log prose episode-log__body">
            {renderedSections.map(({ section, rendered }) => {
              const Content = rendered.Content;
              return (
                <section class="episode-log__content-section" id={section.anchor}>
                  <div class="episode-log__content-head">
                    <h3>{section.label}</h3>
                  </div>
                  <Content />
                </section>
              );
            })}
          </article>

          <footer class="episode-log__footer">
            <div class="episode-log__footer-nav">
              {previousHref ? (
                <a class="episode-log__arrow" href={previousHref} aria-label="前の話へ移動">
                  ‹
                </a>
              ) : (
                <span class="episode-log__arrow episode-log__arrow--disabled" aria-hidden="true">
                  ‹
                </span>
              )}

              <ShareButtons
                url={Astro.url.href}
                title={`${episode.title} のログ`}
                className="episode-log__share-buttons"
              />

              {nextHref ? (
                <a class="episode-log__arrow" href={nextHref} aria-label="次の話へ移動">
                  ›
                </a>
              ) : (
                <span class="episode-log__arrow episode-log__arrow--disabled" aria-hidden="true">
                  ›
                </span>
              )}
            </div>
          </footer>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .episode-log {
    max-width: 1100px;
  }

  .episode-log__page-head {
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
  }

  .episode-log__page-title {
    margin: 0;
    font-size: clamp(2.75rem, 4vw, 3.5rem);
    font-weight: var(--fw-regular);
    letter-spacing: 0.01em;
  }

  .episode-log__layout {
    position: relative;
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .episode-log__layout::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(172px + 10px);
    width: 1px;
    background: #9a9a9a;
    opacity: 0.55;
  }

  .episode-log__sidebar {
    position: sticky;
    top: calc(var(--h-header-top) + var(--h-header-nav) + var(--s-5));
    display: grid;
    gap: 16px;
  }

  .episode-log__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: 0 18px;
    border: 1px solid #2d2d2d;
    background: rgba(255, 255, 255, 0.95);
    color: #111111;
    font-family: var(--f-serif);
    font-size: 1.05rem;
    line-height: 1.2;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .episode-log__button:hover {
    background: #232323;
    border-color: #232323;
    color: #ffffff;
  }

  .episode-log__button--primary {
    background: #2f2f2f;
    border-color: #2f2f2f;
    color: #ffffff;
  }

  .episode-log__main {
    min-width: 0;
    display: grid;
    gap: 18px;
  }

  .episode-log__panel {
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid #2d2d2d;
    padding: 26px 30px 30px;
  }

  .episode-log__panel-head {
    margin-bottom: 30px;
  }

  .episode-log__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid #2d2d2d;
  }

  .episode-log__title-group {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
  }

  .episode-log__title {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.7rem);
    font-weight: var(--fw-regular);
    line-height: 1.15;
  }

  .episode-log__episode-no {
    margin: 0;
    font-family: var(--f-serif);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: #202020;
  }

  .episode-log__badge-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .episode-log__badge {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    background: #2f2f2f;
    color: #ffffff;
    font-family: var(--f-sans);
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
  }

  .episode-log__meta-lines {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .episode-log__meta-line {
    display: flex;
    align-items: baseline;
    gap: 30px;
    padding: 6px 0;
    border-bottom: 1px solid #2d2d2d;
    font-family: var(--f-serif);
    font-size: 1rem;
    line-height: 1.5;
  }

  .episode-log__meta-inline {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .episode-log__meta-line dt,
  .episode-log__meta-line dd,
  .episode-log__meta-free {
    margin: 0;
    color: #111111;
  }

  .episode-log__meta-line a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .episode-log__body {
    max-width: none;
    display: grid;
    gap: 40px;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    color: #1f1f1f;
    font-size: 1.02rem;
    line-height: 1.86;
  }

  .episode-log__content-section {
    scroll-margin-top: calc(
      var(--h-header-top) + var(--h-header-nav) + var(--s-5) + var(--s-4)
    );
  }

  .episode-log__content-head {
    margin-bottom: 14px;
  }

  .episode-log__content-head h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    font-weight: var(--fw-bold);
  }

  .episode-log__content-head h3::before {
    content: "▼";
    font-size: 0.95em;
    line-height: 1;
  }

  .episode-log__content-section :global(p) {
    margin-bottom: 0.75em;
    font-family: var(--f-serif);
  }

  .episode-log__content-section :global(ul) {
    margin: 0;
    padding-left: 1.25em;
    font-family: var(--f-serif);
  }

  .episode-log__content-section :global(li + li) {
    margin-top: 0.35em;
  }

  .episode-log__footer {
    display: grid;
    justify-content: center;
    padding-top: 6px;
  }

  .episode-log__footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 38px;
    width: 100%;
  }

  .episode-log__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #1f1f1f;
    font-family: var(--f-serif);
    font-size: 2.5rem;
    line-height: 1;
  }

  .episode-log__arrow:hover {
    color: #000000;
  }

  .episode-log__arrow--disabled {
    color: #b7b7b7;
  }

  .episode-log__footer :global(.episode-log__share-buttons) {
    --share-btn-size: 36px;
    --share-icon-size: 17px;
    --share-line-icon-size: 28px;

    display: inline-flex;
    align-items: center;
    gap: 18px;
  }

  .episode-log__footer :global(.episode-log__share-buttons .share-buttons__link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #6f6f6f;
  }

  .episode-log__footer :global(.episode-log__share-buttons .share-buttons__link:hover) {
    background: #2f2f2f;
    transform: none;
  }

  .episode-log__footer :global(.episode-log__share-buttons .share-buttons__link svg) {
    display: block;
  }

  @media (max-width: 960px) {
    .episode-log__layout {
      grid-template-columns: 1fr;
    }

    .episode-log__layout::before {
      display: none;
    }

    .episode-log__sidebar {
      position: static;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .episode-log__sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .episode-log__panel {
      padding: 18px 18px 22px;
    }

    .episode-log__title-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .episode-log__title-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .episode-log__badge-list {
      justify-content: flex-start;
    }

    .episode-log__meta-line {
      gap: 12px;
      flex-wrap: wrap;
    }

    .episode-log__footer-nav {
      gap: 22px;
    }
  }
</style>
