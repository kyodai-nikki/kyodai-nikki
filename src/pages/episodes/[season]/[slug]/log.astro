---
import { getCollection, getEntry, render } from "astro:content";
import LogBody from "../../../../components/episodes/log/LogBody.astro";
import LogFooter from "../../../../components/episodes/log/LogFooter.astro";
import LogScenarioInfo from "../../../../components/episodes/log/LogScenarioInfo.astro";
import LogSidebar from "../../../../components/episodes/log/LogSidebar.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageHeading from "../../../../components/common/PageHeading.astro";
import {
  allEpisodes,
  episodeHref,
  episodeUrlSlug,
  episodesBySeason,
  seasons as getSeasons,
  type EpisodeEntry,
} from "../../../../lib/episodes";
import {
  episodeLogHeadingLabel,
  episodeLogHref,
} from "../../../../lib/episodes/view";
import {
  episodeLogContentId,
  episodeLogSectionOrder,
  episodeLogSectionsFromEntries,
  hasAnyEpisodeLog,
  type EpisodeLogSectionKey,
} from "../../../../lib/episodes/logs";
import { episodesPageMsg } from "../../../../msg/episodes";
import { navigation } from "../../../../data/navigation";
import { commonMsg } from "../../../../msg/common";

export async function getStaticPaths() {
  const logEntries = await getCollection("episodeLogs");

  return (await allEpisodes())
    .filter(({ season, episode }) =>
      hasAnyEpisodeLog(season.slug, episodeUrlSlug(episode), logEntries),
    )
    .map(({ season, episode }) => ({
      params: {
        season: season.slug,
        slug: episodeUrlSlug(episode),
      },
      props: {
        episode,
        seasonNumber: season.number,
      },
    }));
}

interface Props {
  episode: EpisodeEntry;
  seasonNumber: 1 | 2 | 3 | 4;
}

const { episode, seasonNumber } = Astro.props as Props;
const seasons = await getSeasons();
const seasonInfo = seasons.find((s) => s.number === seasonNumber)!;
const episodeSlug = episodeUrlSlug(episode);
const logEntries = await getCollection("episodeLogs");
const entryIds = new Set(logEntries.map((entry) => entry.id));

const sectionEntries = Object.fromEntries(
  await Promise.all(
    episodeLogSectionOrder.map(async (key) => {
      const entryId = episodeLogContentId(seasonInfo.slug, episodeSlug, key);

      if (!entryIds.has(entryId)) {
        return [key, undefined];
      }

      return [key, await getEntry("episodeLogs", entryId)];
    }),
  ),
) as Partial<Record<EpisodeLogSectionKey, Awaited<ReturnType<typeof getEntry<"episodeLogs">>>>>;

const sections = episodeLogSectionsFromEntries(seasonInfo.slug, episodeSlug, sectionEntries);

if (sections.length === 0) {
  throw new Error(`Missing episode log content: ${seasonInfo.slug}/${episodeSlug}`);
}

const renderedSections = await Promise.all(
  sections.map(async (section) => {
    const rendered = await render(sectionEntries[section.key]!);
    return {
      section,
      Content: rendered.Content,
    };
  }),
);

const scenario = episode.scenario;
const overviewHref = episodeHref(seasonInfo.slug, episode);

const seasonEpisodes = await episodesBySeason(seasonNumber);
const logEntriesBySeason = seasonEpisodes.filter((item) =>
  hasAnyEpisodeLog(seasonInfo.slug, episodeUrlSlug(item), logEntries),
);
const currentIndex = logEntriesBySeason.findIndex(
  (item) => item.overallNumber === episode.overallNumber,
);
const previousEpisode =
  currentIndex > 0 ? logEntriesBySeason[currentIndex - 1] : undefined;
const nextEpisode =
  currentIndex >= 0 && currentIndex < logEntriesBySeason.length - 1
    ? logEntriesBySeason[currentIndex + 1]
    : undefined;

const previousSeasonInfo =
  seasonNumber > 1 ? seasons.find((s) => s.number === (seasonNumber - 1)) : undefined;
const nextSeasonInfo =
  seasonNumber < 4 ? seasons.find((s) => s.number === (seasonNumber + 1)) : undefined;

const previousSeasonEpisodes = previousSeasonInfo
  ? await episodesBySeason(previousSeasonInfo.number)
  : [];
const previousSeasonLastEpisode = previousSeasonEpisodes.at(-1);
const previousSeasonLastLogEpisode =
  previousSeasonInfo && previousSeasonLastEpisode &&
  hasAnyEpisodeLog(previousSeasonInfo.slug, episodeUrlSlug(previousSeasonLastEpisode), logEntries)
    ? previousSeasonLastEpisode
    : undefined;

const nextSeasonEpisodes = nextSeasonInfo
  ? await episodesBySeason(nextSeasonInfo.number)
  : [];
const nextSeasonFirstEpisode = nextSeasonEpisodes[0];
const nextSeasonFirstLogEpisode =
  nextSeasonInfo && nextSeasonFirstEpisode &&
  hasAnyEpisodeLog(nextSeasonInfo.slug, episodeUrlSlug(nextSeasonFirstEpisode), logEntries)
    ? nextSeasonFirstEpisode
    : undefined;

const previousHref = previousEpisode
  ? episodeLogHref(seasonInfo.slug, previousEpisode)
  : previousSeasonInfo && previousSeasonLastLogEpisode
    ? episodeLogHref(previousSeasonInfo.slug, previousSeasonLastLogEpisode)
    : undefined;
const nextHref = nextEpisode
  ? episodeLogHref(seasonInfo.slug, nextEpisode)
  : nextSeasonInfo && nextSeasonFirstLogEpisode
    ? episodeLogHref(nextSeasonInfo.slug, nextSeasonFirstLogEpisode)
    : undefined;
const showPreviousButton = Boolean(previousHref);
const showNextButton = Boolean(nextHref);

const mainSection = sectionEntries.main;
const pageDescription =
  mainSection?.data.scenario?.description ?? episode.description.split("\n")[0] ?? episode.title;

const episodeNumberLabel = episodeLogHeadingLabel(episode, episodesPageMsg.deletedEpisodeTag);
const badges = [
  episode.isR18G ? commonMsg.badge.r18g : undefined,
  episode.isR18 ? commonMsg.badge.r18 : undefined,
].filter(Boolean) as string[];
---

<BaseLayout
  title={`${episode.title} Log | ${seasonInfo.label} | Episodes`}
  description={pageDescription}
  bodyClass="episode-log-page"
  pageSectionClass="episode-log"
>
  <PageHeading slot="page-heading" title={navigation.episodes.title} />

  <div class="episode-log__layout">
      <LogSidebar
        overviewHref={overviewHref}
        showNextButton={showNextButton}
        nextHref={nextHref}
        showPreviousButton={showPreviousButton}
        previousHref={previousHref}
        sections={sections}
      />

      <div class="episode-log__main">
        <section class="episode-log__panel">
          <LogScenarioInfo
            title={episode.title}
            episodeNumberLabel={episodeNumberLabel}
            badges={badges}
            scenario={scenario}
            showSmallTitle={episode.smallText}
          />

          <LogBody renderedSections={renderedSections} />

          <LogFooter
            showPreviousButton={showPreviousButton}
            previousHref={previousHref}
            showNextButton={showNextButton}
            nextHref={nextHref}
            shareUrl={Astro.url.href}
            shareTitle={`${episode.title} ${episodesPageMsg.logSuffix}`}
          />
        </section>
      </div>
    </div>
</BaseLayout>

<style>
  .episode-log {
    max-width: 1100px;
  }

  .episode-log__layout {
    position: relative;
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .episode-log__layout::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(172px + 10px);
    width: 1px;
    background: var(--c-log-vertical-divider);
    opacity: 0.55;
  }

  .episode-log__main {
    min-width: 0;
    display: grid;
    gap: 18px;
  }

  .episode-log__panel {
    background: var(--c-log-panel-bg);
    border: 1px solid var(--c-log-divider-strong);
    padding: 26px 30px 30px;
  }

  @media (max-width: 960px) {
    .episode-log__layout {
      grid-template-columns: 1fr;
    }

    .episode-log__layout::before {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .episode-log__panel {
      padding: 18px 18px 22px;
    }
  }
</style>
