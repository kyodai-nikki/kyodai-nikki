---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeading from "../../../components/common/PageHeading.astro";
import OthersTabs from "../../../components/others/OthersTabs.astro";
import WhiteCard from "../../../components/common/WhiteCard.astro";
import { othersPageMsg } from "../../../msg/others";
import { navigation } from "../../../data/navigation";
import { siteConfig } from "../../../config";
import ContactBody from "../../../content/contact.md";

---

<BaseLayout title={`${navigation.others.title} | お問い合わせ`} description={othersPageMsg.meta.description}>
  <PageHeading slot="page-heading" title={navigation.others.title} />
  <OthersTabs slot="page-tabs" currentSection="contact" />
  <section class="others">
    <div class="others-contact">
      <WhiteCard centered translucent>
        <p class="others-contact__team">{siteConfig.teamName}</p>
        <div class="others-contact__body"><ContactBody /></div>
        <p class="others-contact__mail">
          mail:
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>
      </WhiteCard>
    </div>
  </section>
</BaseLayout>

<style>
  .others-contact {
    max-width: 1080px;
    min-height: 300px;
    margin: 0 auto;
  }

  .others-contact__team,
  .others-contact__body,
  .others-contact__mail {
    margin: 0;
    font-family: var(--font-family-base);
    color: var(--c-fg);
  }

  .others-contact__team {
    font-size: 24px;
    line-height: 1.4;
  }

  .others-contact__body,
  .others-contact__mail {
    font-size: 18px;
    line-height: 1.9;
  }

  .others-contact__body :global(p) {
    margin: 0;
    white-space: pre-wrap;
  }

  .others-contact__mail a {
    --others-contact-link-fg: currentColor;
    --others-contact-link-hover-fg: rgb(from var(--others-contact-link-fg) r g b / 0.7);

    color: var(--others-contact-link-fg);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: currentColor;
    transition:
      color var(--dur-base) var(--ease-out),
      text-decoration-color var(--dur-base) var(--ease-out);
  }

  .others-contact__mail a:hover,
  .others-contact__mail a:focus-visible {
    color: var(--others-contact-link-hover-fg);
    text-decoration-color: var(--others-contact-link-hover-fg);
  }

  @media (--bp-tablet) {
    .others-contact {
      min-height: auto;
    }
  }

  @media (--bp-mobile) {
    .others-contact__body,
    .others-contact__mail {
      font-size: 16px;
    }
  }
</style>
