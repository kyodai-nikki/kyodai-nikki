---
import NavPanelCloseButton from "./NavPanelCloseButton.astro";
import { withBase } from "../../../lib/urls";

interface Props {
  id: string;
  ariaLabel: string;
  openLabel: string;
  closeLabel: string;
  activation?: "laptop" | "tablet";
  heading?: string;
  class?: string;
}

const {
  id,
  ariaLabel,
  openLabel,
  closeLabel,
  activation = "tablet",
  heading,
  class: className = "",
} = Astro.props as Props;
const panelBgImage = `url("${withBase("/images/bg_noline.png")}")`;
---

<div
  class:list={["nav-drawer", `nav-drawer--${activation}`, className]}
  data-nav-drawer={id}
  data-nav-drawer-activation={activation}
  data-label-open={openLabel}
  data-label-close={closeLabel}
  style={`--nav-drawer-panel-bg-image: ${panelBgImage};`}
>
  <slot name="trigger" />

  <div class="nav-drawer__backdrop" data-nav-drawer-backdrop aria-hidden="true"></div>

  <aside class="nav-drawer__panel" id={id} aria-label={ariaLabel}>
    <NavPanelCloseButton label={closeLabel} dataAttribute="data-nav-drawer-close" />

    {heading && <p class="nav-drawer__heading">{heading}</p>}

    <nav class="nav-drawer__nav" aria-label={ariaLabel}>
      <slot />
    </nav>
  </aside>
</div>

<style>
  :global(html[data-nav-drawer-open]),
  :global(body[data-nav-drawer-open]) {
    overflow: hidden;
  }

  :global(body[data-page-nav-drawer-open] main[data-page-shell]) {
    position: relative;
    z-index: var(--z-nav-drawer-page-shell);
  }

  :global(body[data-page-nav-drawer-open] .site-header),
  :global(body[data-page-nav-drawer-open] .site-footer) {
    z-index: var(--z-page-base);
  }

  .nav-drawer__backdrop,
  .nav-drawer :global(.nav-panel-close) {
    display: none;
  }

  .nav-drawer__heading {
    --nav-drawer-fg: var(--c-nav-drawer-fg);

    margin: 0 0 18px;
    font-family: var(--font-family-base);
    font-size: 18px;
    line-height: var(--lh-normal);
    color: var(--nav-drawer-fg);
    text-align: center;
  }

  .nav-drawer__nav {
    --nav-drawer-fg: var(--c-nav-drawer-fg);

    font-family: var(--font-family-base);
    line-height: var(--lh-normal);
    color: var(--nav-drawer-fg);
  }

  @media (--bp-laptop) {
    /* Generated from the `activation` prop: nav-drawer--${activation}. */
    .nav-drawer--laptop {
      --nav-drawer-width: 68%;
      --nav-drawer-panel-padding: 132px var(--s-7) 56px;
      --nav-drawer-panel-bg-color: var(--c-nav-drawer-panel-bg);
      --nav-drawer-backdrop-bg: var(--c-nav-drawer-backdrop);
      --nav-drawer-panel-z: var(--z-nav-drawer-panel);
      --nav-drawer-backdrop-z: var(--z-nav-drawer-backdrop);
      --nav-drawer-close-z: 1;
    }

    .nav-drawer--laptop .nav-drawer__backdrop,
    .nav-drawer--laptop :global(.nav-panel-close) {
      display: block;
    }

    .nav-drawer--laptop .nav-drawer__backdrop {
      position: fixed;
      inset: 0;
      background: var(--nav-drawer-backdrop-bg);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-base) var(--ease-out);
      z-index: var(--nav-drawer-backdrop-z);
    }

    .nav-drawer--laptop[data-open="true"] .nav-drawer__backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-drawer--laptop .nav-drawer__panel {
      position: fixed;
      inset: 0 0 0 auto;
      width: var(--nav-drawer-width);
      max-width: none;
      height: 100dvh;
      padding: var(--nav-drawer-panel-padding);
      overflow-y: auto;
      background-color: var(--nav-drawer-panel-bg-color);
      background-image: var(--nav-drawer-panel-bg-image);
      background-position: center top;
      background-size: auto 100dvh;
      background-repeat: no-repeat;
      box-shadow: var(--sh-site-menu);
      opacity: 0;
      pointer-events: none;
      transform: translateX(100%);
      transition:
        opacity var(--dur-base) var(--ease-out),
        transform var(--dur-base) var(--ease-out);
      z-index: var(--nav-drawer-panel-z);
    }

    .nav-drawer--laptop[data-open="true"] .nav-drawer__panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }

    .nav-drawer--laptop :global(.nav-panel-close) {
      z-index: var(--nav-drawer-close-z);
    }
  }

  @media (--bp-tablet) {
    .nav-drawer--tablet {
      --nav-drawer-width: min(330px, calc(100vw - 75px));
      --nav-drawer-mobile-width: min(300px, calc(100vw - 75px));
      --nav-drawer-panel-padding: 88px 26px 32px;
      --nav-drawer-panel-bg-color: var(--c-nav-drawer-panel-bg);
      --nav-drawer-backdrop-bg: var(--c-nav-drawer-backdrop);
      --nav-drawer-panel-z: var(--z-nav-drawer-panel);
      --nav-drawer-backdrop-z: var(--z-nav-drawer-backdrop);
      --nav-drawer-close-z: 1;
    }

    .nav-drawer--tablet .nav-drawer__backdrop,
    .nav-drawer--tablet :global(.nav-panel-close) {
      display: block;
    }

    .nav-drawer--tablet .nav-drawer__heading {
      margin-bottom: 50px;
      font-size: 24px;
      font-weight: var(--fw-bold);
    }

    .nav-drawer--tablet .nav-drawer__backdrop {
      position: fixed;
      inset: 0;
      background: var(--nav-drawer-backdrop-bg);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-base) var(--ease-out);
      z-index: var(--nav-drawer-backdrop-z);
    }

    .nav-drawer--tablet[data-open="true"] .nav-drawer__backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-drawer--tablet .nav-drawer__panel {
      position: fixed;
      inset: 0 0 0 auto;
      width: var(--nav-drawer-width);
      max-width: none;
      height: 100dvh;
      padding: var(--nav-drawer-panel-padding);
      overflow-y: auto;
      background-color: var(--nav-drawer-panel-bg-color);
      background-image: var(--nav-drawer-panel-bg-image);
      background-position: center top;
      background-size: auto 100dvh;
      background-repeat: no-repeat;
      box-shadow: var(--sh-site-menu);
      opacity: 0;
      pointer-events: none;
      transform: translateX(100%);
      transition:
        opacity var(--dur-base) var(--ease-out),
        transform var(--dur-base) var(--ease-out);
      z-index: var(--nav-drawer-panel-z);
    }

    .nav-drawer--tablet[data-open="true"] .nav-drawer__panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }

    .nav-drawer--tablet :global(.nav-panel-close) {
      z-index: var(--nav-drawer-close-z);
    }
  }

  @media (--bp-mobile) {
    .nav-drawer--tablet {
      --nav-drawer-width: var(--nav-drawer-mobile-width);
    }
  }
</style>

<script>
  import "../../../scripts/navDrawer";
</script>
